//@version=6
// ════════════════════════════════════════════════════════════
// EPHORE TL PAIRES — règle retrouvée sur données (MES + NQ 15m, 2026-09-29)
// ════════════════════════════════════════════════════════════
// À chaque nouveau pivot haut confirmé, on le relie au pivot haut
// PRÉCÉDENT le plus proche qui est PLUS HAUT que lui. La droite affichée
// est la dernière créée. Miroir pour le support : nouveau pivot bas relié
// au pivot bas précédent le plus proche qui est PLUS BAS.
// Pas de fenêtre de recherche.
//
// Les 4 droites de référence (MES rés 380→458, MES sup 507→523,
// NQ rés 447→458, NQ sup 452→507) sortent toutes de cette règle.
// RÉSISTANCE VALIDÉE 4/4 (MES + NQ, 15m + 1h) avec 10 barres à gauche et
// 38 à 50 à droite : la référence confirme ses pivots hauts avec retard.
// SUPPORT NON RÉSOLU : cette règle ne retrouve au mieux que 1 à 2 supports
// sur 4, quel que soit le réglage. Le support de l'original suit une autre
// logique (NQ 1h : il garde une droite cassée depuis 10 jours).
indicator("Ephore TL Paires", overlay=true, max_lines_count=50, max_labels_count=50)

grp = "=== TL PAIRES ==="
piv_left  = input.int(10, "Pivots : barres à gauche", group=grp, minval=1, maxval=50)
res_right = input.int(40, "Résistance : barres à droite (confirmation)", group=grp, minval=1, maxval=100,
     tooltip="Validé sur MES et NQ, 15m et 1h : 38 à 50 donne les 4 bonnes résistances.")
sup_right = input.int(20, "Support : barres à droite (confirmation)", group=grp, minval=1, maxval=100,
     tooltip="Expérimental : le support de l'original suit une autre logique, non retrouvée.")
ext_bars  = input.int(50, "Prolongement à droite (barres)", group=grp, minval=0, maxval=490)
res_col   = input.color(#FFFFFF, "Couleur résistance", group=grp, inline="c1")
sup_col   = input.color(#FFFFFF, "Couleur support",    group=grp, inline="c1")
width     = input.int(2, "Épaisseur", group=grp, minval=1, maxval=5)
show_lbl  = input.bool(true, "Étiquettes (points de la droite)", group=grp)

// ── Pivots ──
ph = ta.pivothigh(high, piv_left, res_right)
pl = ta.pivotlow(low,  piv_left, sup_right)

var float[] ph_price = array.new_float(0)
var int[]   ph_bar   = array.new_int(0)
var float[] pl_price = array.new_float(0)
var int[]   pl_bar   = array.new_int(0)

// Droites courantes : x1, y1, x2, y2
var float r_x1 = na, var float r_y1 = na, var float r_x2 = na, var float r_y2 = na
var float s_x1 = na, var float s_y1 = na, var float s_x2 = na, var float s_y2 = na

if not na(ph)
    b = bar_index - res_right
    n = array.size(ph_price)
    if n > 0
        // Du plus récent au plus ancien : premier pivot plus haut
        for i = n - 1 to 0
            if array.get(ph_price, i) > ph
                r_x1 := float(array.get(ph_bar, i))
                r_y1 := array.get(ph_price, i)
                r_x2 := float(b)
                r_y2 := ph
                break
    array.push(ph_price, ph)
    array.push(ph_bar, b)
    if array.size(ph_price) > 300
        array.shift(ph_price)
        array.shift(ph_bar)

if not na(pl)
    b = bar_index - sup_right
    n = array.size(pl_price)
    if n > 0
        for i = n - 1 to 0
            if array.get(pl_price, i) < pl
                s_x1 := float(array.get(pl_bar, i))
                s_y1 := array.get(pl_price, i)
                s_x2 := float(b)
                s_y2 := pl
                break
    array.push(pl_price, pl)
    array.push(pl_bar, b)
    if array.size(pl_price) > 300
        array.shift(pl_price)
        array.shift(pl_bar)

// ── Dessin ──
f_y(x1, y1, x2, y2, x) =>
    y1 + (y2 - y1) / (x2 - x1) * (x - x1)

var line  ln_r = na
var line  ln_s = na
var label lb_r = na
var label lb_s = na

if barstate.islast
    line.delete(ln_r), line.delete(ln_s)
    label.delete(lb_r), label.delete(lb_s)
    ex = bar_index + ext_bars
    if not na(r_x1)
        ln_r := line.new(int(r_x1), r_y1, ex, f_y(r_x1, r_y1, r_x2, r_y2, ex),
             xloc=xloc.bar_index, color=res_col, width=width)
        if show_lbl
            lb_r := label.new(ex, f_y(r_x1, r_y1, r_x2, r_y2, ex),
                 "RÉS " + str.tostring(r_y1, format.mintick) + " → " + str.tostring(r_y2, format.mintick),
                 xloc=xloc.bar_index, style=label.style_label_left,
                 color=color.new(color.black, 100), textcolor=res_col, size=size.small)
    if not na(s_x1)
        ln_s := line.new(int(s_x1), s_y1, ex, f_y(s_x1, s_y1, s_x2, s_y2, ex),
             xloc=xloc.bar_index, color=sup_col, width=width)
        if show_lbl
            lb_s := label.new(ex, f_y(s_x1, s_y1, s_x2, s_y2, ex),
                 "SUP " + str.tostring(s_y1, format.mintick) + " → " + str.tostring(s_y2, format.mintick),
                 xloc=xloc.bar_index, style=label.style_label_left,
                 color=color.new(color.black, 100), textcolor=sup_col, size=size.small)
