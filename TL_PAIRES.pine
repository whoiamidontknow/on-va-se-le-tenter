//@version=6
// ════════════════════════════════════════════════════════════
// EPHORE TL PAIRES — construction de l'original, affichage stable
// ════════════════════════════════════════════════════════════
// CONSTRUCTION (sûre : les 8 droites de référence MES/NQ 15m/1h sont
// toutes de ce type) : chaque nouveau pivot haut est relié au pivot haut
// précédent le plus proche qui est PLUS HAUT ; miroir pour les bas.
//
// AFFICHAGE (choix maison, la règle de l'original reste inconnue) :
// on garde la droite affichée tant qu'elle n'est pas cassée (clôture
// au-delà) et que son 2e point a moins de 100 barres. Sinon la prochaine
// droite créée la remplace. Sans cette limite, sur 8000+ barres chargées,
// une vieille droite jamais cassée restait affichée loin du prix. Pivots 10/10 comme l'original.
// Le « 40 barres à droite » précédent collait à un seul export et a
// décroché 8 bougies plus tard : abandonné.
indicator("Ephore TL Paires", overlay=true, max_lines_count=50, max_labels_count=50, max_bars_back=5000)

grp = "=== TL PAIRES ==="
piv_left  = input.int(10, "Pivots : barres à gauche", group=grp, minval=1, maxval=50)
res_right = input.int(10, "Résistance : barres à droite (confirmation)", group=grp, minval=1, maxval=100,
     tooltip="10 comme l'original (Pivot High Bars Required for Anchor).")
sup_left  = input.int(10, "Support : barres à gauche", group=grp, minval=1, maxval=100,
     tooltip="10 comme la résistance.")
sup_right = input.int(10, "Support : barres à droite (confirmation)", group=grp, minval=1, maxval=100,
     tooltip="10 comme la résistance.")
renew     = input.int(100, "Chercher une nouvelle droite après X barres", group=grp, minval=10, maxval=1000,
     tooltip="Comme « Look for New Pivot High after X Bars » = 100 de l'original : une droite non cassée dont le 2e point a plus de X barres est remplacée par la droite suivante. Évite de garder une vieille droite hors de l'écran.")
ext_bars  = input.int(50, "Prolongement à droite (barres)", group=grp, minval=0, maxval=490)
res_col   = input.color(#FF6D00, "Couleur résistance", group=grp, inline="c1")
sup_col   = input.color(#2962FF, "Couleur support",    group=grp, inline="c1")
tl_width  = input.int(3, "Épaisseur", group=grp, minval=1, maxval=5)
show_lbl  = input.bool(true, "Étiquettes (points de la droite)", group=grp)

// ── Pivots ──
ph = ta.pivothigh(high, piv_left, res_right)
pl = ta.pivotlow(low,  sup_left, sup_right)

var float[] ph_price = array.new_float(0)
var int[]   ph_bar   = array.new_int(0)
var float[] pl_price = array.new_float(0)
var int[]   pl_bar   = array.new_int(0)

// Droites courantes : x1, y1, x2, y2
var float r_x1 = na
var float r_y1 = na
var float r_x2 = na
var float r_y2 = na
var float s_x1 = na
var float s_y1 = na
var float s_x2 = na
var float s_y2 = na
var bool  r_broken = false
var bool  s_broken = false

if not na(ph)
    b = bar_index - res_right
    n = array.size(ph_price)
    if n > 0
        // Du plus récent au plus ancien : premier pivot plus haut
        for i = n - 1 to 0
            if array.get(ph_price, i) > ph
                // Remplace seulement si aucune droite ou droite déjà cassée
                if na(r_x1) or r_broken or bar_index - r_x2 > renew
                    r_x1 := float(array.get(ph_bar, i))
                    r_y1 := array.get(ph_price, i)
                    r_x2 := float(b)
                    r_y2 := ph
                    r_broken := false
                break
    array.push(ph_price, ph)
    array.push(ph_bar, b)
    if array.size(ph_price) > 300
        array.shift(ph_price)
        array.shift(ph_bar)

if not na(pl)
    b = bar_index - sup_right
    n = array.size(pl_price)
    if n > 0
        for i = n - 1 to 0
            if array.get(pl_price, i) < pl
                if na(s_x1) or s_broken or bar_index - s_x2 > renew
                    s_x1 := float(array.get(pl_bar, i))
                    s_y1 := array.get(pl_price, i)
                    s_x2 := float(b)
                    s_y2 := pl
                    s_broken := false
                break
    array.push(pl_price, pl)
    array.push(pl_bar, b)
    if array.size(pl_price) > 300
        array.shift(pl_price)
        array.shift(pl_bar)

// ── Dessin ──
f_y(x1, y1, x2, y2, x) =>
    y1 + (y2 - y1) / (x2 - x1) * (x - x1)

// ── Cassures (clôture au-delà de la droite) ──
if not na(r_x1) and not r_broken and bar_index > r_x2
    if close > f_y(r_x1, r_y1, r_x2, r_y2, bar_index)
        r_broken := true
if not na(s_x1) and not s_broken and bar_index > s_x2
    if close < f_y(s_x1, s_y1, s_x2, s_y2, bar_index)
        s_broken := true

var line  ln_r = na
var line  ln_s = na
var label lb_r = na
var label lb_s = na

if barstate.islast
    line.delete(ln_r)
    line.delete(ln_s)
    label.delete(lb_r)
    label.delete(lb_s)
    ex = bar_index + ext_bars
    if not na(r_x1)
        ln_r := line.new(int(r_x1), r_y1, ex, f_y(r_x1, r_y1, r_x2, r_y2, ex),
             xloc=xloc.bar_index, color=res_col, width=tl_width)
        if show_lbl
            lb_r := label.new(ex, f_y(r_x1, r_y1, r_x2, r_y2, ex),
                 "RÉS " + str.tostring(r_y1, format.mintick) + " → " + str.tostring(r_y2, format.mintick),
                 xloc=xloc.bar_index, style=label.style_label_left,
                 color=color.new(color.black, 100), textcolor=res_col, size=size.small)
    if not na(s_x1)
        ln_s := line.new(int(s_x1), s_y1, ex, f_y(s_x1, s_y1, s_x2, s_y2, ex),
             xloc=xloc.bar_index, color=sup_col, width=tl_width)
        if show_lbl
            lb_s := label.new(ex, f_y(s_x1, s_y1, s_x2, s_y2, ex),
                 "SUP " + str.tostring(s_y1, format.mintick) + " → " + str.tostring(s_y2, format.mintick),
                 xloc=xloc.bar_index, style=label.style_label_left,
                 color=color.new(color.black, 100), textcolor=sup_col, size=size.small)

// ── Contrôle : pivots détectés (triangles) + tableau d'état ──
plotshape(not na(ph), "Pivot haut", style=shape.triangledown, location=location.abovebar,
     color=color.new(res_col, 30), size=size.tiny, offset=-res_right)
plotshape(not na(pl), "Pivot bas", style=shape.triangleup, location=location.belowbar,
     color=color.new(sup_col, 30), size=size.tiny, offset=-sup_right)

var table tb = table.new(position.top_left, 2, 6, bgcolor=color.new(color.black, 15),
     border_width=1, border_color=color.gray)
if barstate.islast
    table.cell(tb, 0, 0, "Pivots hauts / bas", text_color=color.silver, text_size=size.small)
    table.cell(tb, 1, 0, str.tostring(array.size(ph_price)) + " / " + str.tostring(array.size(pl_price)), text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 1, "Résistance", text_color=color.silver, text_size=size.small)
    table.cell(tb, 1, 1, na(r_x1) ? "AUCUNE" : str.tostring(r_y1, format.mintick) + " → " + str.tostring(r_y2, format.mintick) + (r_broken ? "  (cassée)" : ""), text_color=res_col, text_size=size.small)
    table.cell(tb, 0, 2, "Support", text_color=color.silver, text_size=size.small)
    table.cell(tb, 1, 2, na(s_x1) ? "AUCUN" : str.tostring(s_y1, format.mintick) + " → " + str.tostring(s_y2, format.mintick) + (s_broken ? "  (cassé)" : ""), text_color=sup_col, text_size=size.small)
    table.cell(tb, 0, 3, "Barres chargées", text_color=color.silver, text_size=size.small)
    table.cell(tb, 1, 3, str.tostring(bar_index + 1), text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 4, "Rés : écart au prix", text_color=color.silver, text_size=size.small)
    table.cell(tb, 1, 4, na(r_x1) ? "—" : str.tostring(f_y(r_x1, r_y1, r_x2, r_y2, bar_index) - close, format.mintick) + " pts, 2e point il y a " + str.tostring(bar_index - int(r_x2)) + " b", text_color=res_col, text_size=size.small)
    table.cell(tb, 0, 5, "Sup : écart au prix", text_color=color.silver, text_size=size.small)
    table.cell(tb, 1, 5, na(s_x1) ? "—" : str.tostring(f_y(s_x1, s_y1, s_x2, s_y2, bar_index) - close, format.mintick) + " pts, 2e point il y a " + str.tostring(bar_index - int(s_x2)) + " b", text_color=sup_col, text_size=size.small)
