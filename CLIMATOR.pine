//@version=6
// ══════════════════════════════════════════════════════════════
// EPHORE CLIMATOR — VERSION V1 (2026-10-12)
// Indicateur INDÉPENDANT. Ne contient que les climax, rien d'autre.
// Graphique en Heiken Ashi obligatoire (un avertissement s'affiche sinon).
//
// NOTE DE VOCABULAIRE. Chez Ephore, « Climator » désigne en réalité tout le
// module d'affichage — la source du terminal web dit « Ephore Market Climator
// v10 » et son glossaire le définit comme « la couleur des bougies ». Les
// triangles de climax n'en sont qu'une partie. Le fichier porte ce nom parce
// que c'est celui demandé ; il ne couvre que les climax.
//
// NIVEAU DE PREUVE
// Vérité terrain n°1 : les marqueurs clx_ de l'API publique du terminal web
//   (86 événements en 15m, 96 en 2m, avec sens buy/sell et niveau HIGH/PREMIUM).
// Vérité terrain n°2, INDÉPENDANTE : les colonnes « Climax BUY/SELL (confirmed) »
//   de 21 exports TradingView — autre instrument (MES, NQ), autre source,
//   7 unités de temps, 500 événements.
// Résultat sans retoucher un seul seuil entre les deux :
//   rappel 454/500 = 90.8 %   précision 80.9 %
// Le rappel est identique à celui mesuré sur l'API (91 %), donc la règle n'est
// pas surajustée à un instrument.
//
// LA RÈGLE (valeurs sur bougies Heiken Ashi, sauf le volume)
//   body = (close - open) / (high - low)
//   vr   = volume / SMA20(volume), barre courante incluse
//   BUY  si open == low  et  body >=  0.55  et  vr >= 1.5
//          niveau PREMIUM si vr >= 2.0 et body >= 0.70, sinon HIGH
//   SELL si open == high et -body >=  0.65  et  vr >= 2.0
//          niveau TOUJOURS HIGH — aucun sell PREMIUM n'a jamais été observé,
//          même à volume 12x et corps 0.76.
//
// FAITS ÉTABLIS, si tu veux retoucher les seuils
//   - « bougie HA sans mèche du côté du sens » est quasi nécessaire (52/56 buys,
//     13/13 sells) mais très insuffisante : elle laisse 291 faux candidats buy
//     en 15m. Ne jamais s'en contenter.
//   - le volume est le discriminant le plus fort (AUC 0.96). La SMA20 incluant
//     la barre courante bat toutes les variantes testées (SMA/EMA de 10 à 50).
//   - le corps est une vraie porte, pas un compromis : dans la bande 0.50-0.55,
//     même à volume 4x la moyenne, on compte 0 vrai pour 14 faux.
//   - les sells sont plus exigeants que les buys (volume 2.0 contre 1.5,
//     corps 0.65 contre 0.55), et ne sont jamais PREMIUM.
//
// LIMITE CONNUE. La précision (80.9 %) est en retrait du rappel. Sur 14 faux
// positifs analysés en détail, 5 sont des déclenchements à ±3 barres d'un vrai
// climax : une déduplication sur la fenêtre de 3 barres de la formation en
// supprimerait environ un tiers. Elle n'est PAS implémentée ici, volontairement :
// la règle livrée est exactement celle qui a été mesurée, on ne mélange pas une
// règle validée et une correction non validée.
//
// Détail complet, pistes épuisées incluses : tools/ephore_api/NOTES_CLIMAX.md
//
// JOURNAL DES VERSIONS
//   V1  2026-10-12  Extraction depuis EPHORE_COMPLET.pine en indicateur autonome.
// ══════════════════════════════════════════════════════════════
indicator("Ephore Climator", overlay=true, max_labels_count=100)

grp = "=== EPHORE CLIMAX ==="
clx_on      = input.bool(true,  "Afficher les climax", group=grp)
clx_confirm = input.bool(true,  "Valider seulement à la clôture de la barre", group=grp,
     tooltip="La règle a été calibrée sur des bougies FERMÉES (exports CSV et marqueurs « confirmed » de l'API). En temps réel le volume et le corps bougent : sans cette option un triangle peut apparaître puis disparaître avant la clôture. Laisser coché pour reproduire l'original.")
clx_buyBody = input.float(0.55, "Buy — corps minimum (|c-o| / range)",  group=grp, minval=0.0, maxval=1.0, step=0.05)
clx_buyVol  = input.float(1.5,  "Buy — volume minimum (× SMA20)",       group=grp, minval=0.0, maxval=10.0, step=0.1)
clx_selBody = input.float(0.65, "Sell — corps minimum (|c-o| / range)", group=grp, minval=0.0, maxval=1.0, step=0.05)
clx_selVol  = input.float(2.0,  "Sell — volume minimum (× SMA20)",      group=grp, minval=0.0, maxval=10.0, step=0.1)
clx_pVol    = input.float(2.0,  "PREMIUM — volume minimum (× SMA20)",   group=grp, minval=0.0, maxval=10.0, step=0.1)
clx_pBody   = input.float(0.70, "PREMIUM — corps minimum",              group=grp, minval=0.0, maxval=1.0, step=0.05)
clx_volLen  = input.int(20,     "Période de la moyenne de volume",      group=grp, minval=1, maxval=200)

grp_c = "=== COULEURS ==="
clx_cBuy  = input.color(#2962FF, "BUY (HIGH)",  group=grp_c, inline="c")
clx_cSell = input.color(#F23645, "SELL (HIGH)", group=grp_c, inline="c")
clx_cPrem = input.color(#F5E24E, "PREMIUM",     group=grp_c, inline="c")

grp_d = "=== DIAGNOSTIC ==="
clx_tbl   = input.bool(false, "Afficher le tableau de diagnostic", group=grp_d)
clx_tblPos= input.string("Bottom Left", "Position", group=grp_d,
     options=["Top Left","Top Right","Middle Left","Middle Right","Bottom Left","Bottom Right"])

// ── Calculs ───────────────────────────────────────────────────
clx_rg   = high - low
// Égalité open/low sur flottants : on tolère un centième de tick, ce qui revient
// à l'égalité exacte sans dépendre de l'arrondi de la plateforme. Sur un
// graphique HA, low vaut min(high, open, close) donc c'est une copie exacte
// d'open quand open est le plus bas.
clx_eps  = syminfo.mintick / 100.0
clx_body = clx_rg > 0 ? (close - open) / clx_rg : 0.0
clx_vma  = ta.sma(volume, clx_volLen)
clx_vr   = clx_vma > 0 ? volume / clx_vma : 0.0

// La règle repose sur « bougie HA sans mèche du côté du sens ». Sur des bougies
// NORMALES, open == low est fréquent et le module produirait des signaux faux
// en silence. On exige donc explicitement un graphique Heiken Ashi.
clx_ok   = clx_on and chart.is_heikinashi and (not clx_confirm or barstate.isconfirmed)

clx_buy  = clx_ok and clx_rg > 0 and clx_vma > 0 and (open - low) <= clx_eps
             and clx_body >= clx_buyBody and clx_vr >= clx_buyVol
clx_sell = clx_ok and clx_rg > 0 and clx_vma > 0 and (high - open) <= clx_eps
             and -clx_body >= clx_selBody and clx_vr >= clx_selVol
clx_prem = clx_buy and clx_vr >= clx_pVol and clx_body >= clx_pBody

// PIÈGE PINE v6 : l'argument `size` de plotshape exige un `const string`.
// input.string() renvoie un `input string`, refusé (erreur CE10123). La taille
// ne peut donc pas être réglable par input : elle est figée.
plotshape(clx_buy and not clx_prem, "Climax BUY (HIGH)",    style=shape.triangleup,
     location=location.belowbar, color=clx_cBuy,  size=size.small)
plotshape(clx_prem,                 "Climax BUY (PREMIUM)", style=shape.triangleup,
     location=location.belowbar, color=clx_cPrem, size=size.small)
plotshape(clx_sell,                 "Climax SELL (HIGH)",   style=shape.triangledown,
     location=location.abovebar, color=clx_cSell, size=size.small)

alertcondition(clx_buy,  "Climax BUY",     "Climax acheteur Ephore")
alertcondition(clx_sell, "Climax SELL",    "Climax vendeur Ephore")
alertcondition(clx_prem, "Climax PREMIUM", "Climax acheteur PREMIUM Ephore")

// ── Avertissement si le graphique n'est pas en Heiken Ashi ────
if barstate.islast and not chart.is_heikinashi
    var label ha_warn = na
    label.delete(ha_warn)
    ha_warn := label.new(bar_index, high,
         "⚠ Ephore Climator : passe le graphique en Heiken Ashi\n(la règle est calibrée dessus, sinon les signaux sont faux)",
         style=label.style_label_down, color=color.new(color.red, 10),
         textcolor=color.white, size=size.normal)

// ── Tableau de diagnostic ─────────────────────────────────────
clx_pos = clx_tblPos == "Top Left" ? position.top_left :
     clx_tblPos == "Top Right" ? position.top_right :
     clx_tblPos == "Middle Left" ? position.middle_left :
     clx_tblPos == "Middle Right" ? position.middle_right :
     clx_tblPos == "Bottom Left" ? position.bottom_left : position.bottom_right

var table clx_t = table.new(position.bottom_left, 2, 6, bgcolor=color.new(#15162D, 0),
     border_width=1, border_color=color.rgb(95, 97, 125))
var bool clx_tInit = false

// PIÈGE PINE v6 : une fonction ne peut PAS être déclarée dans un bloc local
// (dans un `if`, une boucle, un ternaire) — erreur CE10156. Elle doit être au
// niveau global, même si elle n'est utilisée qu'à l'intérieur d'un `if`.
f_row(r, k, v, col) =>
    table.cell(clx_t, 0, r, k, text_color=color.silver, text_size=size.small)
    table.cell(clx_t, 1, r, v, text_color=col,          text_size=size.small)

if barstate.islast and clx_tbl
    if not clx_tInit
        table.delete(clx_t)
        clx_t := table.new(clx_pos, 2, 6, bgcolor=color.new(#15162D, 0),
             border_width=1, border_color=color.rgb(95, 97, 125))
        clx_tInit := true
    f_row(0, "Heiken Ashi", chart.is_heikinashi ? "oui" : "NON",
          chart.is_heikinashi ? color.lime : color.red)
    f_row(1, "Corps (c-o)/range", str.tostring(clx_body, "0.00"), color.white)
    f_row(2, "Volume / SMA" + str.tostring(clx_volLen), str.tostring(clx_vr, "0.00"), color.white)
    f_row(3, "Mèche basse", str.tostring(open - low, format.mintick), color.white)
    f_row(4, "Mèche haute", str.tostring(high - open, format.mintick), color.white)
    f_row(5, "Climax", clx_prem ? "BUY PREMIUM" : clx_buy ? "BUY" : clx_sell ? "SELL" : "—",
          clx_prem ? clx_cPrem : clx_buy ? clx_cBuy : clx_sell ? clx_cSell : color.gray)
