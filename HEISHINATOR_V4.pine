//@version=6
// ════════════════════════════════════════════════════════════
// HEISHINATOR V4 — Replica (Ephore Market Ultimate)
// ════════════════════════════════════════════════════════════
// Reverse-engineered via HA_DIAGNOSTIC v13→v16 :
//
//   col_bull = SHA_close > EMA(close, 33)
//
//   SHA_close = EMA récursif de ohlc4 avec alpha adaptatif :
//     - TF < 30min  → α = 0.42  (validé 2m, 15m)
//     - TF ≥ 30min  → α = 0.44  (validé 1h, 4h)
//
// SHA_close_t = α * ohlc4_t + (1 − α) * SHA_close_{t-1}
//
// Utiliser sur chart Heiken Ashi (open/close = HA natifs).
// ════════════════════════════════════════════════════════════
indicator("Heishinator V4 Replica", overlay=true)

// ── COULEURS ────────────────────────────────────────────────
grp_col = "=== COULEURS ==="
use_custom = input.bool(false,          "Personnaliser couleurs", group=grp_col)
bull_col   = input.color(color.blue,    "Couleur haussière",      group=grp_col)
bear_col   = input.color(color.red,     "Couleur baissière",      group=grp_col)
bull_final = use_custom ? bull_col : color.new(#2196F3, 0)
bear_final = use_custom ? bear_col : color.new(#F44336, 0)

// ── OVERRIDE MANUEL (optionnel) ─────────────────────────────
grp_ov  = "=== OVERRIDE ==="
auto_tf  = input.bool(true,  "Alpha automatique selon TF",        group=grp_ov)
alpha_lo = input.float(0.42, "α pour TF < 30min", step=0.01, minval=0.01, maxval=1.0, group=grp_ov)
alpha_hi = input.float(0.44, "α pour TF ≥ 30min", step=0.01, minval=0.01, maxval=1.0, group=grp_ov)
alpha_fix = input.float(0.43, "α forcé (si auto désactivé)", step=0.01, minval=0.01, maxval=1.0, group=grp_ov)
ema_len  = input.int(33,     "Longueur EMA",     minval=1, maxval=200, group=grp_ov)

// ── ALPHA SELON TF ──────────────────────────────────────────
tf_seconds = timeframe.in_seconds(timeframe.period)
is_low_tf  = tf_seconds < 30 * 60   // < 30 minutes
alpha      = auto_tf ? (is_low_tf ? alpha_lo : alpha_hi) : alpha_fix

// ── SHA CLOSE (EMA récursif sur ohlc4 avec alpha dynamique) ─
ohlc4_src = (open + high + low + close) / 4
var float sha_close = na
sha_close := na(sha_close[1])
     ? ohlc4_src
     : alpha * ohlc4_src + (1.0 - alpha) * sha_close[1]

// ── EMA33 SUR CLOSE ─────────────────────────────────────────
ema_base = ta.ema(close, ema_len)

// ── RÈGLE DE COLORATION ─────────────────────────────────────
col_bull = sha_close > ema_base

// ── APPLICATION ─────────────────────────────────────────────
barcolor(col_bull ? bull_final : bear_final)

// ── PLOTS DIAGNOSTIC (masqués par défaut) ───────────────────
plot(sha_close, "SHA close", color=color.new(color.orange, 0), linewidth=1, display=display.none)
plot(ema_base,  "EMA33",     color=color.new(color.black,  0), linewidth=2, display=display.none)

// ── TRANSITIONS (masqués par défaut) ────────────────────────
bull_flip = bar_index > 0 and col_bull     and not col_bull[1]
bear_flip = bar_index > 0 and not col_bull and     col_bull[1]
plotshape(bull_flip, "Flip ▲", style=shape.triangleup,   location=location.belowbar, color=color.lime, size=size.tiny, display=display.none)
plotshape(bear_flip, "Flip ▼", style=shape.triangledown, location=location.abovebar, color=color.red,  size=size.tiny, display=display.none)

// ── TABLE INFO ──────────────────────────────────────────────
var table t = table.new(position.top_right, 2, 4,
     bgcolor=color.new(color.black, 70), border_width=1)

if barstate.islast
    tf_label = tf_seconds < 60 ? str.tostring(tf_seconds) + "s" :
       tf_seconds < 3600 ? str.tostring(tf_seconds / 60, "0") + "m" :
       tf_seconds < 86400 ? str.tostring(tf_seconds / 3600, "0") + "h" :
       str.tostring(tf_seconds / 86400, "0") + "D"
    table.cell(t, 0, 0, "Heishinator V4", text_color=color.white, text_size=size.small, bgcolor=color.new(color.navy, 20))
    table.cell(t, 1, 0, "Replica",         text_color=color.yellow, text_size=size.small, bgcolor=color.new(color.navy, 20))
    table.cell(t, 0, 1, "TF",              text_color=color.white, text_size=size.small)
    table.cell(t, 1, 1, tf_label,          text_color=color.yellow, text_size=size.small)
    table.cell(t, 0, 2, "α",               text_color=color.white, text_size=size.small)
    table.cell(t, 1, 2, str.tostring(alpha, "0.00"), text_color=color.yellow, text_size=size.small)
    table.cell(t, 0, 3, "Signal",          text_color=color.white, text_size=size.small)
    table.cell(t, 1, 3, col_bull ? "▲ BULL" : "▼ BEAR",
         text_color=col_bull ? color.lime : color.red, text_size=size.normal,
         bgcolor=col_bull ? color.new(color.blue, 80) : color.new(color.red, 80))
