alertcondition(ta.cross(close, s1_p),  "Set1 P cross",  "Prix croise Pivot Set 1")
alertcondition(ta.cross(close, s1_r1), "Set1 R1 cross", "Prix croise R1 Set 1")
alertcondition(ta.cross(close, s1_s1), "Set1 S1 cross", "Prix croise S1 Set 1")
alertcondition(ta.cross(close, s1_r2), "Set1 R2 cross", "Prix croise R2 Set 1")
alertcondition(ta.cross(close, s1_s2), "Set1 S2 cross", "Prix croise S2 Set 1")
alertcondition(ta.cross(close, s2_p),  "Set2 P cross",  "Prix croise Pivot Set 2")
alertcondition(ta.cross(close, s2_r1), "Set2 R1 cross", "Prix croise R1 Set 2")
alertcondition(ta.cross(close, s2_s1), "Set2 S1 cross", "Prix croise S1 Set 2")
alertcondition(ta.cross(close, s2_r2), "Set2 R2 cross", "Prix croise R2 Set 2")
alertcondition(ta.cross(close, s2_s2), "Set2 S2 cross", "Prix croise S2 Set 2")
alertcondition(bull_ob_alert, "Bullish OB Formed", "Bullish Order Block detected")
alertcondition(bear_ob_alert, "Bearish OB Formed", "Bearish Order Block detected")

alertcondition(mitigated_bull, 'Bullish OB Mitigated', 'Bullish order block mitigated')

alertcondition(mitigated_bear, 'Bearish OB Mitigated', 'bearish order block mitigated')

alertcondition(sig_long_fort,    "Signator Long FORT",    "Signal Signator LONG (FORT)")
alertcondition(sig_short_fort,   "Signator Short FORT",   "Signal Signator SHORT (FORT)")
alertcondition(breakout_signal,  "Trendline Breakout",    "Breakout de trendline baissière détecté")
alertcondition(breakdown_signal, "Support Breakdown",     "Cassure baissière du support ascendant détectée")
