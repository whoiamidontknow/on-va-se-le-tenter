        ln_s3_r5 := piv_s3_r5_on and not na(rv_s3_r5) ? line.new(s3_start_t, rv_s3_r5, s3_end, rv_s3_r5, xloc=xloc.bar_time, color=piv_s3_r5_col, width=piv_line_w, style=line.style_solid) : na
