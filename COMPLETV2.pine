        lb_s3_s4 := piv_s3_s4_on and piv_show_lbl and not na(rv_s3_s4) ? label.new(s3_rgt, rv_s3_s4, f_lbl_text(rv_s3_s4, "S4"), xloc=xloc.bar_time, textcolor=piv_s3_lbl_col, color=color.new(color.black, 100), style=label.style_label_left, size=piv_sz, text_font_family=piv_font) : na
        lb_s3_r5 := piv_s3_r5_on and piv_show_lbl and not na(rv_s3_r5) ? label.new(s3_rgt, rv_s3_r5, f_lbl_text(rv_s3_r5, "R5"), xloc=xloc.bar_time, textcolor=piv_s3_lbl_col, color=color.new(color.black, 100), style=label.style_label_left, size=piv_sz, text_font_family=piv_font) : na
        lb_s3_s5 := piv_s3_s5_on and piv_show_lbl and not na(rv_s3_s5) ? label.new(s3_rgt, rv_s3_s5, f_lbl_text(rv_s3_s5, "S5"), xloc=xloc.bar_time, textcolor=piv_s3_lbl_col, color=color.new(color.black, 100), style=label.style_label_left, size=piv_sz, text_font_family=piv_font) : na

// ══════════════════════════════════════════════════════════════

// ══════════════════════════════════════════════════════════════
// TABLEAU PRINCIPAL — réplique validée (source Midgar-)
// Remplace l'ancien « TABLEAU PRINCIPAL V6 » de PorscheOnArrive.
// ══════════════════════════════════════════════════════════════
// TABLEAU PRINCIPAL V7 — réplique de l'original
// ══════════════════════════════════════════════════════════════
// Logique reprise de « SuperTrader Trend Analysis and Trade Study
// Dashboard » par Midgar- (script public open source) :
// https://www.tradingview.com/script/4hlaRIHC-SuperTrader-Trend-Analysis-and-Trade-Study-Dashboard/
// Ephore l'a copié tel quel (mêmes libellés) avec ses couleurs.
// Vérifié MES 15m HA, 30/09 bougie 09:30 : RSI 60.67, CCI 134.23,
// YoYo 0.08 %, Bull 0/3, Bear 1/3 — identiques à l'original.
grp_main     = "=== EPHORE TABLEAU PRINCIPAL ==="
main_show    = input.bool(true, "Afficher Tableau Principal", group=grp_main)
main_pos     = input.string("Top Right", "Position", group=grp_main, options=["Bottom Right", "Bottom Left", "Top Right", "Top Left", "Middle Right", "Middle Left"])
main_sz      = input.string("Normal", "Taille Texte", group=grp_main, options=["Tiny", "Small", "Normal", "Large", "Huge"])
st_tk1       = input.symbol("", "Ticker 1 (volume) — vide = symbole du graphique", group=grp_main)
st_tk2       = input.symbol("", "Ticker 2 (volume) — vide = symbole du graphique", group=grp_main)
st_vix_sym   = input.symbol("CBOE:VIX", "Symbole VIX", group=grp_main)

// ─── PALETTE STYLE TABLEAU ───
c_bg         = color.rgb(21, 22, 45)     // fond général
c_border     = color.rgb(95, 97, 125)    // bordures
c_label      = color.rgb(190, 190, 205)  // texte gris clair
c_bull       = color.rgb(56, 149, 255)   // bleu
c_bear       = color.rgb(255, 82, 99)    // rouge
c_neut       = color.rgb(130, 130, 150)  // neutre gris
c_super      = color.rgb(140, 180, 255)  // bleu clair (SUPERBULL, Unusual)
c_warn       = color.rgb(245, 166, 35)   // orange (Basing, Melt)
c_cell_blue  = color.rgb(24, 38, 92)     // fond bleu foncé
c_cell_red   = color.rgb(74, 26, 49)     // fond rouge/bordeaux
c_cell_neut  = color.rgb(45, 46, 70)     // fond neutre
c_cell_gold  = color.rgb(98, 63, 16)     // fond orange/marron
c_cell_sup   = color.rgb(52, 64, 110)    // fond bleu-gris (SUPERBULL, Unusual)

// Couleurs sémantiques de l'original → palette Ephore
// "bull" = vert d'origine, "bear" = rouge, "super" = bleu, "warn" = jaune/orange, "neut" = gris/blanc
f_st_txt(s) => s == "bull" ? c_bull : s == "bear" ? c_bear : s == "super" ? c_super : s == "warn" ? c_warn : c_neut
f_st_bg(s)  => s == "bull" ? c_cell_blue : s == "bear" ? c_cell_red : s == "super" ? c_cell_sup : s == "warn" ? c_cell_gold : c_cell_neut

// ─── CONSTANTES DE L'ORIGINAL ───
st_rsiLen = 14
st_vidPer = 10      // Trend Line Period
st_vidMom = 20      // Trend Momentum
st_band   = 2.0     // Trend Band Distance (x ATR 200)
st_yoyoTh = 3.0     // YoYo Threshold (%)
st_mFast  = 20      // MACD 20 / 40 / 5 (EMA)
st_mSlow  = 40
st_mSig   = 5
st_bbLen  = 20
st_bbMult = 2.0

st_macd(src) =>
    m = ta.ema(src, st_mFast) - ta.ema(src, st_mSlow)
    s = ta.ema(m, st_mSig)
    [m, s]

// ─── DONNÉES EXTERNES ───
[st_dSma50, st_dSma200] = request.security(syminfo.tickerid, "D", [ta.sma(close, 50), ta.sma(close, 200)])
[st_dH, st_dL, st_dO, st_dC] = request.security(syminfo.tickerid, "D", [high, low, open, close])
st_vixP = request.security(st_vix_sym, "D", close,  lookahead=barmerge.lookahead_on)
st_vixV = request.security(st_vix_sym, "D", volume, lookahead=barmerge.lookahead_on)
st_v1   = request.security(st_tk1, "D", volume, lookahead=barmerge.lookahead_on)
st_v2   = request.security(st_tk2, "D", volume, lookahead=barmerge.lookahead_on)

// ─── CROSS SIGNAL : golden / death cross SMA50/200 journalier, remis à « — » chaque semaine ───
st_golden = ta.crossover(st_dSma50, st_dSma200)
st_death  = ta.crossunder(st_dSma50, st_dSma200)
st_week   = int(math.floor(time / 604800000))
var int    st_lastWeek  = na
var string st_crossTxt  = "—"
var string st_crossSem  = "neut"
if na(st_lastWeek)
    st_lastWeek := st_week
if st_week != st_lastWeek
    st_crossTxt := "—"
    st_crossSem := "neut"
    st_lastWeek := st_week
if st_golden
    st_crossTxt := "Golden"
    st_crossSem := "warn"
if st_death
    st_crossTxt := "Death"
    st_crossSem := "warn"

// ─── MACD (10m) ───
[st_m10, st_s10] = request.security(syminfo.tickerid, "10", st_macd(close))
st_mBull   = st_m10 > st_s10
st_mStrong = st_mBull and st_m10 > -0.25 and st_s10 > -0.25
st_mBase   = not st_mBull and st_m10 > -0.025 and st_s10 > -0.025
st_macdTxt = st_mStrong ? "SUPERBULL" : st_mBase ? "Basing" : st_mBull ? "Bullish" : "Bearish"
st_macdSem = st_mStrong ? "super" : st_mBase ? "warn" : st_mBull ? "bull" : "bear"

// ─── RSI + DIVERGENCE (pivots 5/5, écart 5 à 60 barres, affichée 10 barres) ───
st_rsi = ta.rsi(close, st_rsiLen)
st_inRange(cond) =>
    bb = ta.barssince(cond)
    5 <= bb and bb <= 60
st_rsiLBR = st_rsi[5]
st_plFound = not na(ta.pivotlow(st_rsi, 5, 5))
// PIÈGE PINE v6 (CW10002) : `and` court-circuite, donc un appel à une fonction
// à état placé à sa DROITE peut ne pas s'exécuter à chaque barre — et
// ta.barssince(), à l'intérieur de st_inRange(), décale alors son historique.
// La ligne Divergence devenait fausse par intermittence. Il faut évaluer
// l'appel sur chaque barre, puis seulement combiner les booléens.
st_phFound = not na(ta.pivothigh(st_rsi, 5, 5))
st_inRpl   = st_inRange(st_plFound[1])
st_inRph   = st_inRange(st_phFound[1])
st_rsiHL   = st_rsiLBR > ta.valuewhen(st_plFound, st_rsiLBR, 1) and st_inRpl
st_priceLL = low[5] < ta.valuewhen(st_plFound, low[5], 1)
st_bullDiv = st_priceLL and st_rsiHL and st_plFound
st_rsiLH   = st_rsiLBR < ta.valuewhen(st_phFound, st_rsiLBR, 1) and st_inRph
st_priceHH = high[5] > ta.valuewhen(st_phFound, high[5], 1)
st_bearDiv = st_priceHH and st_rsiLH and st_phFound
var string st_divTxt = "None"
var string st_divSem = "neut"
var int    st_divTimer = 0
if st_bullDiv
    st_divTxt := "Bullish"
    st_divSem := "bull"
    st_divTimer := 10
else if st_bearDiv
    st_divTxt := "Bearish"
    st_divSem := "bear"
    st_divTimer := 10
else
    st_divTimer := math.max(st_divTimer - 1, 0)
st_divShow    = st_divTimer > 0 ? st_divTxt : "None"
st_divShowSem = st_divTimer > 0 ? st_divSem : "neut"

// ─── BULL / BEAR SCORE (non complémentaires) ───
st_cci    = ta.cci(close, 30)
st_basis  = ta.sma(close, st_bbLen)
st_upBB   = st_basis + st_bbMult * ta.stdev(close, st_bbLen)
st_loBB   = st_basis - st_bbMult * ta.stdev(close, st_bbLen)
st_emaF   = ta.ema(close, 50)
st_emaS   = ta.ema(close, 200)
st_bullCount = (st_emaF > st_emaS ? 1 : 0) + (ta.crossover(st_rsi, 30) ? 1 : 0) + (ta.crossover(close, st_loBB) ? 1 : 0)
st_bearCount = (st_emaF < st_emaS ? 1 : 0) + (ta.crossunder(st_rsi, 70) ? 1 : 0) + (ta.crossunder(close, st_upBB) ? 1 : 0)
st_buySignal = st_bullCount >= 2

// ─── TREND : VIDYA (CMO 20, période 10, SMA 15) ± ATR(200) x 2 ───
st_vidya_calc(src, len, mom) =>
    mo = ta.change(src)
    sp = math.sum(mo >= 0 ? mo : 0.0, mom)
    sn = math.sum(mo < 0 ? -mo : 0.0, mom)
    cmo = math.abs(100 * (sp - sn) / math.max(sp + sn, 1))
    alpha = 2.0 / (len + 1.0)
    var float v = na
    v := alpha * cmo / 100 * src + (1 - alpha * cmo / 100) * nz(v[1])
    v
st_vidya  = ta.sma(st_vidya_calc(close, st_vidPer, st_vidMom), 15)
st_atr200 = ta.atr(200)
st_upBand = st_vidya + st_atr200 * st_band
st_loBand = st_vidya - st_atr200 * st_band
var bool st_trendUp = false
st_trendUp := ta.crossover(close, st_upBand) ? true : ta.crossunder(close, st_loBand) ? false : st_trendUp[1]

// ─── YOYO : distance en % au SMA(10) ───
st_sma10 = ta.sma(close, 10)
st_yoyo  = (close - st_sma10) / st_sma10 * 100
st_yoyoSem = math.abs(st_yoyo) > st_yoyoTh + 3.0 ? "bear" : math.abs(st_yoyo) > st_yoyoTh + 1.5 ? "warn" : "bull"

// ─── GAP ↑ / ↓ PROB (pondération double) ───
st_smaVol   = ta.sma(volume, 20)
st_rangePos = st_dH != st_dL ? (st_dC - st_dL) / (st_dH - st_dL) : 0.5
st_chg      = st_dO != 0 ? (st_dC - st_dO) / st_dO * 100 * 0.5 : 0.0
st_macdS    = ta.ema(close, 12) - ta.ema(close, 26)
st_sigS     = ta.ema(st_macdS, 9)
st_squeeze  = ta.stdev(close, st_bbLen) < ta.lowest(ta.stdev(close, st_bbLen), 20) ? 7 : 0
st_bullF = st_rangePos * 20 + st_chg + (volume > st_smaVol ? 10 : 0) + (ta.crossover(st_macdS, st_sigS) ? 10 : 0) + (close > ta.ema(close, 20) ? 5 : 0) + (st_buySignal ? 10 : 0) + st_squeeze
st_bearF = (1 - st_rangePos) * 20 - st_chg + (volume < st_smaVol ? 10 : 0) + (ta.crossunder(st_macdS, st_sigS) ? 10 : 0) + (close < ta.ema(close, 20) ? 5 : 0)
st_bullT = math.max(0, math.min(100, st_bullF))
st_bearT = math.max(0, math.min(100, st_bearF))
st_bullPct = st_bullT / (st_bullT + st_bearT) * 100
st_bearPct = st_bearT / (st_bullT + st_bearT) * 100

// ─── TF1 / TF2 / TF3 PA : 1, 5, 15 minutes (codés en dur dans l'original) ───
st_status(tf) =>
    [sH, sL] = request.security(syminfo.tickerid, tf, [ta.sma(high, 20), ta.sma(low, 20)])
    [mT, sT] = request.security(syminfo.tickerid, tf, st_macd(close))
    pT = request.security(syminfo.tickerid, tf, close)
    mb = mT > sT
    above = pT > sH and pT > sL
    txt = ""
    sem = "neut"
    if above and mb and mT > -0.025
        txt := "SUPERBULL"
        sem := "super"
    else if mT > -0.025 and not mb
        txt := "Basing"
        sem := "warn"
    else if above and mb
        txt := "Bullish"
        sem := "bull"
    else if not above and not mb
        txt := "Bearish"
        sem := "bear"
    [txt, sem]
[st_pa1, st_pa1s] = st_status("1")
[st_pa2, st_pa2s] = st_status("5")
[st_pa3, st_pa3s] = st_status("15")

// ─── VOLUMES (Ticker 1 / 2, VIX) ───
st_volCat(vol, base) =>
    vol < base ? (vol < base / 2.0 ? "Melt" : vol < base / 1.5 ? "Low Vol" : "Normal") : (vol < 1.5 * base ? "Elevated" : "Unusual")
st_volSem(c) => c == "Normal" ? "neut" : c == "Low Vol" ? "bear" : c == "Melt" ? "warn" : c == "Elevated" ? "bull" : "super"
st_lvl1 = st_volCat(st_v1, ta.sma(st_v1, 20))
st_lvl2 = st_volCat(st_v2, ta.sma(st_v2, 20))
st_vixBase = ta.sma(st_vixV, 20)
st_vixLvl  = st_vixV < st_vixBase ? "Normal" : st_vixV < 1.5 * st_vixBase ? "Elevated" : "Unusual"
st_vixLvlSem = st_vixLvl == "Normal" ? "bear" : st_vixLvl == "Elevated" ? "warn" : "super"
st_vixTxt = st_vixP >= 80 ? "HOLY SHIT" : str.tostring(st_vixP, "#.##")
st_vixSem = st_vixP >= 80 ? "neut" : st_vixP < 20 ? "bull" : st_vixP < 50 ? "bear" : "warn"

// ─── CONSTRUCTION TABLEAU ───
f_sz(_s) =>
    _s == "Tiny" ? size.tiny : _s == "Small" ? size.small : _s == "Normal" ? size.normal : _s == "Large" ? size.large : size.huge

m_pos = main_pos == "Bottom Right" ? position.bottom_right : main_pos == "Bottom Left" ? position.bottom_left :
     main_pos == "Top Left" ? position.top_left : main_pos == "Middle Right" ? position.middle_right :
     main_pos == "Middle Left" ? position.middle_left : position.top_right

var table tbl_main = table.new(position.top_right, 4, 9, bgcolor=c_bg, border_color=c_border, border_width=1)

f_st_row(col, row, lbl, val, sem, sz) =>
    table.cell(tbl_main, col,     row, lbl, text_color=c_label, text_size=sz)
    table.cell(tbl_main, col + 1, row, val, text_color=f_st_txt(sem), bgcolor=f_st_bg(sem), text_size=sz)

if barstate.islast and main_show
    table.set_position(tbl_main, m_pos)
    sz = f_sz(main_sz)
    f_st_row(0, 0, "Trend",        st_trendUp ? "Bullish" : "Bearish", st_trendUp ? "bull" : "bear", sz)
    f_st_row(0, 1, "Bull Score",   str.tostring(st_bullCount) + " / 3", "bull", sz)
    f_st_row(0, 2, "Bear Score",   str.tostring(st_bearCount) + " / 3", "bear", sz)
    f_st_row(0, 3, "YoYo",         str.tostring(st_yoyo, "#.##") + "%", st_yoyoSem, sz)
    f_st_row(0, 4, "Gap ↑ Prob",   str.tostring(st_bullPct, "#.##") + "%", st_bullPct >= st_bearPct ? "bull" : "bear", sz)
    f_st_row(0, 5, "Gap ↓ Prob",   str.tostring(st_bearPct, "#.##") + "%", st_bearPct > st_bullPct ? "bull" : "bear", sz)
    f_st_row(0, 6, "Divergence",   st_divShow, st_divShowSem, sz)
    f_st_row(0, 7, "Vix",          st_vixTxt, st_vixSem, sz)
    f_st_row(0, 8, "Ticker 1 Vol", st_lvl1, st_volSem(st_lvl1), sz)
    f_st_row(2, 0, "Cross Signal", st_crossTxt, st_crossSem, sz)
    f_st_row(2, 1, "CCI (30)",     str.tostring(st_cci, "#.##"), st_cci >= 0 ? "bull" : "bear", sz)
    f_st_row(2, 2, "RSI (14)",     str.tostring(st_rsi, "#.##"), st_rsi >= 50 ? "bull" : "bear", sz)
    f_st_row(2, 3, "MACD (10m)",   st_macdTxt, st_macdSem, sz)
    f_st_row(2, 4, "TF1 PA",       st_pa1, st_pa1s, sz)
    f_st_row(2, 5, "TF2 PA",       st_pa2, st_pa2s, sz)
    f_st_row(2, 6, "TF3 PA",       st_pa3, st_pa3s, sz)
    f_st_row(2, 7, "Vix Vol",      st_vixLvl, st_vixLvlSem, sz)
    f_st_row(2, 8, "Ticker 2 Vol", st_lvl2, st_volSem(st_lvl2), sz)

// ══════════════════════════════════════════════════════════════

//------------------------------------------------------------------------------
//DETECTOR ORDER BLCOK
//-----------------------------------------------------------------------------{
length = input.int(5, 'Volume Pivot Length'
  , minval = 1)

bull_ext_last = input.int(3, 'Bullish OB '
  , minval = 1
  , inline = 'bull')

bg_bull_css = input.color(color.new(#1565C0, 80), ''
  , inline = 'bull')

bull_css = input.color(#1565C0, ''
  , inline = 'bull')

bull_avg_css = input.color(color.new(#757575, 50), ''
  , inline = 'bull')

bear_ext_last = input.int(3, 'Bearish OB'
  , minval = 1
  , inline = 'bear')

bg_bear_css = input.color(color.new(#EF5350, 80), ''
  , inline = 'bear')

bear_css = input.color(#EF5350, ''
  , inline = 'bear')

bear_avg_css = input.color(color.new(#757575, 50), ''
  , inline = 'bear')

line_style = input.string('⎯⎯⎯', 'Average Line Style'
  , options = ['⎯⎯⎯', '----', '····'])

line_width = input.int(1, 'Average Line Width'
  , minval = 1)

mitigation = input.string('Wick', 'Mitigation Methods'
  , options = ['Wick', 'Close'])

//-----------------------------------------------------------------------------}
//Functions
//-----------------------------------------------------------------------------{
//Line Style function
get_line_style(style) =>
    out = switch style
        '⎯⎯⎯'  => line.style_solid
        '----' => line.style_dashed
        '····' => line.style_dotted

//Function to get order block coordinates
get_coordinates(condition, top, btm, ob_val)=>
    var ob_top  = array.new_float(0)
    var ob_btm  = array.new_float(0)
    var ob_avg  = array.new_float(0)
    var ob_left = array.new_int(0)

    float ob = na

    //Append coordinates to arrays
    if condition
        avg = math.avg(top, btm)

        array.unshift(ob_top, top)
        array.unshift(ob_btm, btm)
        array.unshift(ob_avg, avg)
        array.unshift(ob_left, time[length])

        ob := ob_val

    [ob_top, ob_btm, ob_avg, ob_left, ob]

//Function to remove mitigated order blocks from coordinate arrays
remove_mitigated(ob_top, ob_btm, ob_left, ob_avg, target, bull)=>
    mitigated = false
    target_array = bull ? ob_btm : ob_top

    for element in target_array
        idx = array.indexof(target_array, element)

        if (bull ? target < element : target > element)
            mitigated := true

            array.remove(ob_top, idx)
            array.remove(ob_btm, idx)
            array.remove(ob_avg, idx)
            array.remove(ob_left, idx)

    mitigated

//Function to set order blocks
// ─── GRISAGE DES ZONES — trouvé le 12/10 ───
// Une boîte Detector est grisée exactement quand le PRIX COURANT est dedans.
// Vérifié sur 2 copies de l'API du terminal web distantes de 10 jours, 19 boîtes :
// la seule grisée est celle qui contient le prix, et les 3 autres situations
// (aucune boîte ne contient le prix) n'ont aucune grisée. La 2e copie a été prise
// APRÈS avoir formulé la règle : c'est une prédiction vérifiée.
// Conforme à EPHORE_METHODE.md : « une zone trop proche du prix passe en gris
// (bruit visuel enlevé, info gardée). Basé sur la DISTANCE, pas la force. »
// Écarté par la mesure : « zone consommée » (8 boîtes sur 10 avaient été
// traversées, une seule grisée), la force (volume, largeur, touches ne séparent
// pas) et « la plus proche » (réfuté par le 2 min).
// RÉSERVE : un seul cas positif, donc on ne peut pas distinguer « prix dedans »
// d'un seuil « distance < k × ATR » avec k petit. La non grisée la plus proche
// était à 2.09 ATR : k est entre 0 et 2. « Prix dedans » est la règle minimale,
// sans paramètre. L'input ci-dessous permet d'élargir si besoin.
// STRUCTURE DU VRAI RÉGLAGE, lue sur le panneau d'Ephore (12/10) :
//   [case]  atténuation activée            → det_gris_on
//   liste   « Griser » / (autre mode)      → Ephore propose aussi de masquer
//   nombre  1.5                            → det_gris_val
//   liste   « % fixe » / (× ATR)           → det_gris_mode
//   nombre  0.1                            → la valeur de l'autre unité
//
// ATTENTION, LE PANNEAU ET LES DONNÉES SE CONTREDISENT. Avec « 1.5 % fixe »
// comme distance au prix, 16 des 19 boîtes observées sur l'API devraient être
// grisées ; une seule l'est. Donc soit le terminal web est réglé autrement que
// la version de Jeremy, soit « 1.5 % » mesure autre chose que la distance.
// La seule règle VÉRIFIÉE sur les 19 observations est « le prix est dans la
// boîte » (distance nulle) — c'est donc le défaut. Les réglages ci-dessous
// permettent d'élargir si tu constates que l'original grise plus large.
grp_det = "=== EPHORE DETECTOR — ATTÉNUATION DES ZONES ==="
det_gris_on   = input.bool(true, "Atténuer les zones", group=grp_det)
det_gris_mode = input.string("Prix dans la zone", "Critère", group=grp_det,
     options=["Prix dans la zone", "% fixe", "× ATR"],
     tooltip="« Prix dans la zone » est la seule règle vérifiée (19 boîtes sur 2 copies de l'API à 10 jours d'écart). Les deux autres reproduisent la structure du réglage d'Ephore, non validée.")
det_gris_pct  = input.float(1.5, "Distance max (% du prix)", group=grp_det, minval=0.0, maxval=10.0, step=0.1)
det_gris_atr  = input.float(0.1, "Distance max (× ATR14)",   group=grp_det, minval=0.0, maxval=10.0, step=0.1)
det_gris_col  = input.color(color.new(#787B86, 80), "Couleur des zones atténuées", group=grp_det)
det_atr14     = ta.atr(14)

// Distance du prix à la zone : nulle s'il est dedans.
f_det_grise(top, btm) =>
    dist = close > top ? close - top : close < btm ? btm - close : 0.0
    det_gris_mode == "Prix dans la zone" ? dist <= 0.0 :
     det_gris_mode == "% fixe"           ? dist <= close * det_gris_pct / 100.0 :
                                           dist <= det_gris_atr * det_atr14

set_order_blocks(ob_top, ob_btm, ob_left, ob_avg, ext_last, bg_css, border_css, lvl_css)=>
    var ob_box = array.new_box(0)
    var ob_lvl = array.new_line(0)

    //Fill arrays with boxes/lines
    if barstate.isfirst
        for i = 0 to ext_last-1
            array.unshift(ob_box, box.new(na,na,na,na
              , xloc = xloc.bar_time
              , extend= extend.right
              , bgcolor = bg_css
              , border_color = color.new(border_css, 70)))

            array.unshift(ob_lvl, line.new(na,na,na,na
              , xloc = xloc.bar_time
              , extend = extend.right
              , color = lvl_css
              , style = get_line_style(line_style)
              , width = line_width))

    //Set order blocks
    if barstate.islast
        if array.size(ob_top) > 0
            for i = 0 to math.min(ext_last-1, array.size(ob_top)-1)
                get_box = array.get(ob_box, i)
                get_lvl = array.get(ob_lvl, i)

                box.set_lefttop(get_box, array.get(ob_left, i), array.get(ob_top, i))
                box.set_rightbottom(get_box, array.get(ob_left, i), array.get(ob_btm, i))
                // grisage : le prix est dans la zone
                grise = det_gris_on and f_det_grise(array.get(ob_top, i), array.get(ob_btm, i))
                box.set_bgcolor(get_box, grise ? det_gris_col : bg_css)
                box.set_border_color(get_box, grise ? color.new(det_gris_col, 50) : color.new(border_css, 70))

                line.set_xy1(get_lvl, array.get(ob_left, i), array.get(ob_avg, i))
                line.set_xy2(get_lvl, array.get(ob_left, i)+1, array.get(ob_avg, i))


//-----------------------------------------------------------------------------}
//Global elements
//-----------------------------------------------------------------------------{
var os = 0
var target_bull = 0.
var target_bear = 0.

n = bar_index
upper = ta.highest(length)
lower = ta.lowest(length)

if mitigation == 'Close'
    target_bull := ta.lowest(close, length)
    target_bear := ta.highest(close, length)
else
    target_bull := lower
    target_bear := upper

os := high[length] > upper ? 0 : low[length] < lower ? 1 : os[1]

phv = not na(ta.pivothigh(volume, length, length))

//-----------------------------------------------------------------------------}
//Get bullish/bearish order blocks coordinates
//-----------------------------------------------------------------------------{
[bull_top
  , bull_btm
  , bull_avg
  , bull_left
  , bull_ob] = get_coordinates(phv and os == 1, hl2[length], low[length], low[length])

[bear_top
  , bear_btm
  , bear_avg
  , bear_left
  , bear_ob] = get_coordinates(phv and os == 0, high[length], hl2[length], high[length])

//-----------------------------------------------------------------------------}
//Remove mitigated order blocks
//-----------------------------------------------------------------------------{
mitigated_bull = remove_mitigated(bull_top
  , bull_btm
  , bull_left
  , bull_avg
  , target_bull
  , true)

mitigated_bear = remove_mitigated(bear_top
  , bear_btm
  , bear_left
  , bear_avg
  , target_bear
  , false)

//-----------------------------------------------------------------------------}
//Display order blocks
//-----------------------------------------------------------------------------{
//Set bullish order blocks
set_order_blocks(bull_top
  , bull_btm
  , bull_left
  , bull_avg
  , bull_ext_last
  , bg_bull_css
  , bull_css
  , bull_avg_css)

//Set bearish order blocks
set_order_blocks(bear_top
  , bear_btm
  , bear_left
  , bear_avg
  , bear_ext_last
  , bg_bear_css
  , bear_css
  , bear_avg_css)

//Show detected order blocks
plot(bull_ob, 'Bull OB', bull_css, 2, plot.style_linebr
  , offset = -length
  , display = display.none)

plot(bear_ob, 'Bear OB', bear_css, 2, plot.style_linebr
  , offset = -length
  , display = display.none)


//condition alerte
bull_ob_alert = not na(bull_ob)
bear_ob_alert = not na(bear_ob)



// ══════════════════════════════════════════════════════════════
// EPHORE TRENDLINES V2 — résistance descendante + support ascendant
// ══════════════════════════════════════════════════════════════
// Logique dérivée de « Trendlines » © Amphibiantrading (MPL 2.0),
// https://www.tradingview.com/script/RQ1D3gHZ-Trendlines/
// Modifications Ephore retrouvées : 2e point = pivot confirmé,
// droite revérifiée à chaque bougie, support ascendant en miroir.
// Validé 38/38 (MES + NQ, 1m à 4h, HA) et en direct jusqu'au 12h.
max_bars_back(high, 5000)
max_bars_back(low, 5000)
max_bars_back(time, 5000)

tl_grp = "=== EPHORE TRENDLINES V2 ==="
tl_bars   = input.int(10,    "Pivot : barres de chaque côté (Pivot High Bars Required for Anchor)", group=tl_grp, minval=1, maxval=50)
tl_bufPct = input.float(0.1, "Tampon % (Price Buffer %)", group=tl_grp, minval=0.0, step=0.05)
tl_nT     = input.int(3,     "Touches minimum (Minimum Number of Touches)", group=tl_grp, minval=1, maxval=10)
tl_newH   = input.int(100,   "Nouvelle ancre après X barres (Look for New Pivot High after X Bars)", group=tl_grp, minval=1, maxval=1000)

tl_grp_d = "=== TRENDLINES : affichage ==="
tl_brkSrc  = input.string("Mèche + tampon", "Cassure (points) mesurée sur", group=tl_grp_d,
     options=["Clôture (corps au-delà)", "Corps entier au-delà", "Mèche + tampon"],
     tooltip="Défaut = original : la mèche dépasse la trend de plus que le tampon (0,1 %). Vérifié sur MES 15m : point rouge à 07:00 comme l'original (la clôture le mettait à 06:15). Un seul point haussier et un seul baissier restent affichés : le dernier de chaque.")
tl_showRes = input.bool(true, "Afficher la résistance (trend baissière)", group=tl_grp_d)
tl_showSup = input.bool(true, "Afficher le support (trend haussière)",   group=tl_grp_d)
tl_showAnc = input.bool(false, "Marquer les ancres (◆)", group=tl_grp_d)
tl_showTbl = input.bool(false, "Tableau de diagnostic", group=tl_grp_d)

tl_grp_s = "=== TRENDLINES : style ==="
tl_resCol  = input.color(#000000, "Couleur résistance", group=tl_grp_s, inline="c")
tl_supCol  = input.color(#000000, "Couleur support",    group=tl_grp_s, inline="c")
tl_tlW     = input.int(2, "Épaisseur", group=tl_grp_s, minval=1, maxval=5)
tl_ext     = input.bool(true, "Prolonger les droites (Extend Trendlines)", group=tl_grp_s)
tl_showBo  = input.bool(true, "Points de cassure", group=tl_grp_s)
tl_boUpShp = input.string("Cercle", "Cassure haussière : forme", options=["Cercle", "Triangle haut", "Triangle bas", "Flèche haut", "Flèche bas", "Losange", "Carré", "Croix", "X", "Drapeau"], group=tl_grp_s, inline="bu")
tl_boUpCol = input.color(color.lime, "couleur", group=tl_grp_s, inline="bu")
tl_boDnShp = input.string("Cercle", "Cassure baissière : forme", options=["Cercle", "Triangle haut", "Triangle bas", "Flèche haut", "Flèche bas", "Losange", "Carré", "Croix", "X", "Drapeau"], group=tl_grp_s, inline="bd")
tl_boDnCol = input.color(color.red,  "couleur", group=tl_grp_s, inline="bd")
tl_boSzS   = input.string("Minuscule", "Taille des points", options=["Auto", "Minuscule", "Petite", "Normale", "Grande", "Énorme"], group=tl_grp_s)

tl_f_boStyle(x) =>
    switch x
        "Triangle haut" => label.style_triangleup
        "Triangle bas"  => label.style_triangledown
        "Flèche haut"   => label.style_arrowup
        "Flèche bas"    => label.style_arrowdown
        "Losange"       => label.style_diamond
        "Carré"         => label.style_square
        "Croix"         => label.style_cross
        "X"             => label.style_xcross
        "Drapeau"       => label.style_flag
        => label.style_circle

tl_boSize = switch tl_boSzS
    "Auto"   => size.auto
    "Petite" => size.small
    "Normale" => size.normal
    "Grande" => size.large
    "Énorme" => size.huge
    => size.tiny

tl_buf    = tl_bufPct / 100.0
tl_usePiv = true   // 2e point = pivot confirmé (Ephore)
tl_everyB = true   // droite revérifiée à chaque bougie (Ephore)

tl_f_val(x1, y1, x2, y2, x) =>
    y1 + (y2 - y1) / (x2 - x1) * (x - x1)

// ══════════════════════════════════════════════════════════════
// RÉSISTANCE DESCENDANTE (pivots hauts)
// ══════════════════════════════════════════════════════════════
tl_ph = ta.pivothigh(high, tl_bars, tl_bars)

var float tl_rAncH = na
var int   tl_rAncB = na
var float tl_rX1 = na
var float tl_rY1 = na
var float tl_rX2 = na
var float tl_rY2 = na
var int   tl_rTouch = 0
var int   tl_rValidAt = na
var bool  tl_rActive = false
var float tl_rLastH = na
var int   tl_rLastB = na
bool tl_rNewAnchor = false
bool tl_rNewPiv = false

// a) ancre, ou dernier pivot plus bas que l'ancre
if not na(tl_ph) and (na(tl_rAncH) or tl_ph > tl_rAncH or bar_index - tl_rAncB > tl_newH)
    tl_rAncH := tl_ph
    tl_rAncB := bar_index - tl_bars
    tl_rLastH := na
    tl_rLastB := na
    tl_rNewAnchor := true
else if not na(tl_ph) and bar_index - tl_bars > tl_rAncB and tl_ph < tl_rAncH
    tl_rLastH := tl_ph
    tl_rLastB := bar_index - tl_bars
    tl_rNewPiv := true

// b) candidate
float tl_rCH = na
int   tl_rCB = na
if not na(tl_rAncH)
    if tl_usePiv
        if not na(tl_rLastB) and (tl_everyB ? high < tl_rAncH : tl_rNewPiv)
            tl_rCH := tl_rLastH
            tl_rCB := tl_rLastB
    else
        if high < tl_rAncH and bar_index > tl_rAncB
            tl_rCH := high
            tl_rCB := bar_index

// c) validation : de la bougie courante (i = 0) jusqu'à l'ancre
if not na(tl_rCB) and bar_index - tl_rAncB < 4900
    int  tl_tc = 0
    bool tl_ok = true
    for i = 0 to bar_index - tl_rAncB
        tl_p = tl_f_val(float(tl_rAncB), tl_rAncH, float(tl_rCB), tl_rCH, float(bar_index - i))
        if high[i] > tl_p * (1 + tl_buf)
            tl_ok := false
            break
        if high[i] >= tl_p * (1 - tl_buf)
            tl_tc += 1
    // d) remplacement
    if tl_ok and tl_tc >= tl_nT and (na(tl_rX1) or tl_rX1 != float(tl_rAncB) or tl_rX2 != float(tl_rCB))
        tl_rX1 := float(tl_rAncB)
        tl_rY1 := tl_rAncH
        tl_rX2 := float(tl_rCB)
        tl_rY2 := tl_rCH
        tl_rTouch := tl_tc
        tl_rValidAt := bar_index
        tl_rActive := true

// ══════════════════════════════════════════════════════════════
// SUPPORT ASCENDANT (pivots bas) — miroir exact
// ══════════════════════════════════════════════════════════════
tl_pl = ta.pivotlow(low, tl_bars, tl_bars)

var float tl_sAncL = na
var int   tl_sAncB = na
var float tl_sX1 = na
var float tl_sY1 = na
var float tl_sX2 = na
var float tl_sY2 = na
var int   tl_sTouch = 0
var int   tl_sValidAt = na
var bool  tl_sActive = false
var float tl_sLastL = na
var int   tl_sLastB = na
bool tl_sNewAnchor = false
bool tl_sNewPiv = false

if not na(tl_pl) and (na(tl_sAncL) or tl_pl < tl_sAncL or bar_index - tl_sAncB > tl_newH)
    tl_sAncL := tl_pl
    tl_sAncB := bar_index - tl_bars
    tl_sLastL := na
    tl_sLastB := na
    tl_sNewAnchor := true
else if not na(tl_pl) and bar_index - tl_bars > tl_sAncB and tl_pl > tl_sAncL
    tl_sLastL := tl_pl
    tl_sLastB := bar_index - tl_bars
    tl_sNewPiv := true

float tl_sCL = na
int   tl_sCB = na
if not na(tl_sAncL)
    if tl_usePiv
        if not na(tl_sLastB) and (tl_everyB ? low > tl_sAncL : tl_sNewPiv)
            tl_sCL := tl_sLastL
            tl_sCB := tl_sLastB
    else
        if low > tl_sAncL and bar_index > tl_sAncB
            tl_sCL := low
            tl_sCB := bar_index

if not na(tl_sCB) and bar_index - tl_sAncB < 4900
    int  tl_tc2 = 0
    bool tl_ok2 = true
    for i = 0 to bar_index - tl_sAncB
        tl_p = tl_f_val(float(tl_sAncB), tl_sAncL, float(tl_sCB), tl_sCL, float(bar_index - i))
        if low[i] < tl_p * (1 - tl_buf)
            tl_ok2 := false
            break
        if low[i] <= tl_p * (1 + tl_buf)
            tl_tc2 += 1
    if tl_ok2 and tl_tc2 >= tl_nT and (na(tl_sX1) or tl_sX1 != float(tl_sAncB) or tl_sX2 != float(tl_sCB))
        tl_sX1 := float(tl_sAncB)
        tl_sY1 := tl_sAncL
        tl_sX2 := float(tl_sCB)
        tl_sY2 := tl_sCL
        tl_sTouch := tl_tc2
        tl_sValidAt := bar_index
        tl_sActive := true

// ══════════════════════════════════════════════════════════════
// CASSURES (points) — la droite reste affichée, seul l'état change
// ══════════════════════════════════════════════════════════════
bool tl_rBreak = false
bool tl_sBreak = false
if tl_rActive and not na(tl_rX1) and bar_index > tl_rValidAt
    tl_rv = tl_f_val(tl_rX1, tl_rY1, tl_rX2, tl_rY2, bar_index)
    if (tl_brkSrc == "Mèche + tampon" ? high > tl_rv * (1 + tl_buf) : tl_brkSrc == "Corps entier au-delà" ? math.min(open, close) > tl_rv : close > tl_rv)
        tl_rBreak := true
        tl_rActive := false
if tl_sActive and not na(tl_sX1) and bar_index > tl_sValidAt
    tl_sv = tl_f_val(tl_sX1, tl_sY1, tl_sX2, tl_sY2, bar_index)
    if (tl_brkSrc == "Mèche + tampon" ? low < tl_sv * (1 - tl_buf) : tl_brkSrc == "Corps entier au-delà" ? math.max(open, close) < tl_sv : close < tl_sv)
        tl_sBreak := true
        tl_sActive := false

// Un seul point haussier et un seul point baissier affichés à la fois : le dernier de chaque
var label tl_boUpLb = na
var label tl_boDnLb = na
if tl_showBo and tl_showRes and tl_rBreak
    label.delete(tl_boUpLb)
    tl_boUpLb := label.new(bar_index, low, "", yloc=yloc.belowbar, style=tl_f_boStyle(tl_boUpShp), color=tl_boUpCol, size=tl_boSize)
if tl_showBo and tl_showSup and tl_sBreak
    label.delete(tl_boDnLb)
    tl_boDnLb := label.new(bar_index, high, "", yloc=yloc.abovebar, style=tl_f_boStyle(tl_boDnShp), color=tl_boDnCol, size=tl_boSize)
plotshape(tl_showAnc and tl_showRes and tl_rNewAnchor, "Nouvelle ancre haute", style=shape.diamond, location=location.abovebar, color=color.new(tl_resCol, 40), size=size.tiny, offset=-tl_bars)
plotshape(tl_showAnc and tl_showSup and tl_sNewAnchor, "Nouvelle ancre basse", style=shape.diamond, location=location.belowbar, color=color.new(tl_supCol, 40), size=size.tiny, offset=-tl_bars)

// ══════════════════════════════════════════════════════════════
// DESSIN
// ══════════════════════════════════════════════════════════════
var line tl_rLn = na
var line tl_sLn = na

if barstate.islast
    line.delete(tl_rLn)
    line.delete(tl_sLn)
    tl_xe = bar_index + 1
    if tl_showRes and not na(tl_rX1)
        tl_rLn := line.new(int(tl_rX1), tl_rY1, tl_xe, tl_f_val(tl_rX1, tl_rY1, tl_rX2, tl_rY2, tl_xe), xloc=xloc.bar_index,
             extend=tl_ext ? extend.right : extend.none, color=tl_resCol, width=tl_tlW)
    if tl_showSup and not na(tl_sX1)
        tl_sLn := line.new(int(tl_sX1), tl_sY1, tl_xe, tl_f_val(tl_sX1, tl_sY1, tl_sX2, tl_sY2, tl_xe), xloc=xloc.bar_index,
             extend=tl_ext ? extend.right : extend.none, color=tl_supCol, width=tl_tlW)

// ══════════════════════════════════════════════════════════════
// TABLEAU DE DIAGNOSTIC
// ══════════════════════════════════════════════════════════════
var table tl_tb = table.new(position.bottom_right, 3, 8, bgcolor=color.new(color.black, 15), border_width=1, border_color=color.gray)

tl_f_c(c, r, txt, col) =>
    table.cell(tl_tb, c, r, txt, text_color=col, text_size=size.small)

tl_f_t(x) =>
    str.format_time(time[bar_index - int(x)], "dd/MM HH:mm", syminfo.timezone)

if barstate.islast and tl_showTbl
    tl_f_c(0, 0, "Réglages", color.silver)
    tl_f_c(1, 0, str.tostring(tl_bars) + " / " + str.tostring(tl_bufPct) + "% / " + str.tostring(tl_nT) + " / " + str.tostring(tl_newH), color.white)
    tl_f_c(2, 0, (tl_usePiv ? "2e pt = pivot" : "2e pt = bougie") + (tl_usePiv ? (tl_everyB ? ", vérif. chaque bougie" : ", vérif. 1 fois") : ""), color.white)
    tl_f_c(1, 1, "RÉSISTANCE", tl_resCol)
    tl_f_c(2, 1, "SUPPORT", tl_supCol)
    tl_f_c(0, 2, "Droite", color.silver)
    tl_f_c(1, 2, na(tl_rX1) ? "AUCUNE" : str.tostring(tl_rY1, format.mintick) + " → " + str.tostring(tl_rY2, format.mintick), tl_resCol)
    tl_f_c(2, 2, na(tl_sX1) ? "AUCUNE" : str.tostring(tl_sY1, format.mintick) + " → " + str.tostring(tl_sY2, format.mintick), tl_supCol)
    tl_f_c(0, 3, "Points (heure)", color.silver)
    tl_f_c(1, 3, na(tl_rX1) ? "—" : tl_f_t(tl_rX1) + " → " + tl_f_t(tl_rX2), tl_resCol)
    tl_f_c(2, 3, na(tl_sX1) ? "—" : tl_f_t(tl_sX1) + " → " + tl_f_t(tl_sX2), tl_supCol)
    tl_f_c(0, 4, "Touches / état", color.silver)
    tl_f_c(1, 4, na(tl_rX1) ? "—" : str.tostring(tl_rTouch) + " / " + (tl_rActive ? "active" : "cassée"), tl_resCol)
    tl_f_c(2, 4, na(tl_sX1) ? "—" : str.tostring(tl_sTouch) + " / " + (tl_sActive ? "active" : "cassée"), tl_supCol)
    tl_f_c(0, 5, "Ancre actuelle", color.silver)
    tl_f_c(1, 5, na(tl_rAncH) ? "—" : str.tostring(tl_rAncH, format.mintick) + " (" + tl_f_t(tl_rAncB) + ")", tl_resCol)
    tl_f_c(2, 5, na(tl_sAncL) ? "—" : str.tostring(tl_sAncL, format.mintick) + " (" + tl_f_t(tl_sAncB) + ")", tl_supCol)
    tl_f_c(0, 6, "Ancre : âge / max", color.silver)
    tl_f_c(1, 6, na(tl_rAncB) ? "—" : str.tostring(bar_index - tl_rAncB) + " / " + str.tostring(tl_newH) + " b", tl_resCol)
    tl_f_c(2, 6, na(tl_sAncB) ? "—" : str.tostring(bar_index - tl_sAncB) + " / " + str.tostring(tl_newH) + " b", tl_supCol)
    tl_f_c(0, 7, "Écart au prix", color.silver)
    tl_f_c(1, 7, na(tl_rX1) ? "—" : str.tostring(tl_f_val(tl_rX1, tl_rY1, tl_rX2, tl_rY2, bar_index) - close, format.mintick) + " pts", tl_resCol)
    tl_f_c(2, 7, na(tl_sX1) ? "—" : str.tostring(tl_f_val(tl_sX1, tl_sY1, tl_sX2, tl_sY2, bar_index) - close, format.mintick) + " pts", tl_supCol)

// ══════════════════════════════════════════════════════════════
// ALERTES PIVOTS
// ══════════════════════════════════════════════════════════════
alertcondition(ta.cross(close, s1_p),  "Set1 P cross",  "Prix croise Pivot Set 1")
alertcondition(ta.cross(close, s1_r1), "Set1 R1 cross", "Prix croise R1 Set 1")
alertcondition(ta.cross(close, s1_s1), "Set1 S1 cross", "Prix croise S1 Set 1")
alertcondition(ta.cross(close, s1_r2), "Set1 R2 cross", "Prix croise R2 Set 1")
alertcondition(ta.cross(close, s1_s2), "Set1 S2 cross", "Prix croise S2 Set 1")
alertcondition(ta.cross(close, s2_p),  "Set2 P cross",  "Prix croise Pivot Set 2")
alertcondition(ta.cross(close, s2_r1), "Set2 R1 cross", "Prix croise R1 Set 2")
alertcondition(ta.cross(close, s2_s1), "Set2 S1 cross", "Prix croise S1 Set 2")
alertcondition(ta.cross(close, s2_r2), "Set2 R2 cross", "Prix croise R2 Set 2")
alertcondition(ta.cross(close, s2_s2), "Set2 S2 cross", "Prix croise S2 Set 2")
alertcondition(ta.cross(close, s3_p),  "Set3 P cross",  "Prix croise Pivot Set 3 (weekly)")
alertcondition(ta.cross(close, s3_r1), "Set3 R1 cross", "Prix croise R1 Set 3 (weekly)")
alertcondition(ta.cross(close, s3_s1), "Set3 S1 cross", "Prix croise S1 Set 3 (weekly)")
alertcondition(bull_ob_alert, "Bullish OB Formed", "Bullish Order Block detected")
alertcondition(bear_ob_alert, "Bearish OB Formed", "Bearish Order Block detected")

alertcondition(mitigated_bull, 'Bullish OB Mitigated', 'Bullish order block mitigated')

alertcondition(mitigated_bear, 'Bearish OB Mitigated', 'bearish order block mitigated')

alertcondition(tl_rBreak, "Cassure résistance", "Cassure haussière de la trendline baissière")
alertcondition(tl_sBreak, "Cassure support",    "Cassure baissière du support ascendant")

// TABLEAU SIGNATOR (ancienne version de l'original)
// Heishinator | TBT | Tendance | Score | TF
// ══════════════════════════════════════════════════════════════
// Règles retrouvées sur données (exports Singal = filtre décoché, Filtres = filtre coché) :
//   Heishinator : EMA(ohlc4,4) vs EMA(ohlc4,32) (138/139 changements de l'original).
//   Tendance    : clôture vs Moyenator 1 (EMA50).
//   Score       : Candle Quality Filter = moyenne des 5 filtres continus (structure,
//                 momentum, volume, engulfing, gap) x 100 ; l'engulfing vaut 0 en HA,
//                 donc max 80. Fort ≥ 50, Moyen ≥ 18 (Seuil de Force), Faible < 18.
//                 Classe Fort/Moyen de l'original retrouvée sur 177/178 flèches.
//   TBT         : ADX(14,14) ≥ Seuil de Force (18) — seule règle compatible avec les
//                 2 cas observés (MES OK / NQ Faible), à confirmer.
//   Flèches     : 2e bougie Heishinator + ADX ≥ 18 + clôture du bon côté de l'EMA50
//                 + conviction (clôture ≥ 0.3 ATR au-delà de la bande EMA50/EMA60
//                 OU volume ≥ SMA20). Filtre coché = pas de flèche sur les bougies
//                 d'annonces 14:30 / 16:00 (Paris).
//                 Sans filtre : 112/113 flèches, 5 en trop ; avec filtre : 65/65, 5 en trop.
grp_sg   = "=== EPHORE SIGNATOR (tableau) ==="
sg_show  = input.bool(true, "Afficher le tableau Signator", group=grp_sg)
sg_pos   = input.string("Top Left", "Position", group=grp_sg, options=["Top Left", "Top Right", "Middle Left", "Middle Right", "Bottom Left", "Bottom Right"])
sg_szS   = input.string("Normal", "Taille Texte", group=grp_sg, options=["Tiny", "Small", "Normal", "Large"])
sg_force = input.int(18, "Seuil de Force (Min) — ADX 14", group=grp_sg, minval=0, maxval=100,
     tooltip="Réglage de l'original. Retrouvé sur ~500 flèches : aucune flèche de l'original n'a un ADX(14,14) < 18.")
sg_tbtMode = input.string("ADX ≥ Seuil de Force", "TBT mesuré par", group=grp_sg, options=["ADX ≥ Seuil de Force", "Volume / moyenne 20 (bougie clôturée)"])
sg_tbtTh = input.float(0.75, "TBT (mode volume) : seuil", group=grp_sg, minval=0.0, step=0.05)
sg_arrows = input.bool(true, "Afficher les flèches Signator", group=grp_sg)
sg_showM  = input.bool(true, "Afficher flèches MOYEN", group=grp_sg)
sg_filter = input.bool(true, "Activer Filtre (Blackout no-trade)", group=grp_sg,
     tooltip="Aucune flèche sur une bougie qui OUVRE pendant une fenêtre d'annonce. Les créneaux se règlent dans le groupe « BLACKOUT » ci-dessous.")
sg_arUp  = input.color(#FFFFFF, "Flèche long", group=grp_sg, inline="ar")
sg_arDn  = input.color(#000000, "Flèche short", group=grp_sg, inline="ar")

sg_c_bg   = color.new(color.gray, 35)
sg_c_lbl  = color.rgb(235, 235, 240)
sg_c_up   = color.rgb(91, 91, 245)    // bleu Ephore
sg_c_dn   = color.rgb(224, 86, 80)    // rouge Ephore
sg_c_ok   = color.rgb(76, 175, 80)    // vert
sg_c_warn = color.rgb(240, 180, 41)   // orange
sg_c_off  = color.rgb(200, 200, 205)  // gris clair

// ─── Heishinator (validé) ───
// Formulation retrouvée sur 139 changements imposés par les flèches de l'original (138/139,
// toutes TF) : EMA(ohlc4, 4) vs EMA(ohlc4, 32). 0.42/0.44 vs EMA33 n'en était qu'une approximation.
sg_sha = ta.ema(ohlc4, 4)
sg_heiBull = sg_sha > ta.ema(ohlc4, 32)

// ─── Tendance : clôture vs Moyenator 1 (EMA50) ───
// (EMA50 > EMA60 réfuté : l'original affichait Baissière avec EMA50 > EMA60)
sg_ema50 = ta.ema(close, 50)
sg_trendBull = close > sg_ema50

// ─── Force : ADX(14,14) ───
[sg_diP, sg_diM, sg_adx] = ta.dmi(14, 14)

// ─── Score = CANDLE QUALITY FILTER de l'original (moyenne de 5 filtres continus) ───
sg_scoreMin = 50
sg_atr   = ta.atr(14)
sg_rng   = high - low
sg_rngS  = math.max(sg_rng, syminfo.mintick)
sg_br    = math.min(math.abs(close - open) / sg_rngS / 0.5, 1.0)
sg_cpos  = sg_heiBull ? (close - low) / sg_rngS : (high - close) / sg_rngS
sg_awick = sg_heiBull ? (high - close) / sg_rngS : (close - low) / sg_rngS
sg_sStr  = (sg_br + (1.0 - math.min(sg_awick / 0.35, 1.0)) + math.min(sg_cpos / 0.67, 1.0)) / 3.0
sg_sMom  = math.min(sg_rng / math.max(0.5 * sg_atr, syminfo.mintick), 1.0)
sg_volMa = ta.sma(volume, 20)
sg_sVol  = sg_volMa > 0 ? math.min(volume / sg_volMa, 1.0) : 0.0
sg_sGap  = math.min(math.abs(open - close[1]) / math.max(0.3 * sg_atr, syminfo.mintick), 1.0)
sg_eng   = (sg_heiBull ? close > open[1] and open < close[1] : open > close[1] and close < open[1]) and high > high[1] and low < low[1]
// SCORE = moyenne des QUATRE termes pondérés du panneau, pas cinq.
//
// Le panneau d'Ephore donne « Poids Structure / Momentum / Volume / Gap = 25 »
// chacun, soit 100 % à eux quatre. **L'englobement n'a aucun poids.** Nous le
// comptions comme un 5ᵉ terme, et comme il vaut TOUJOURS 0 en Heiken Ashi
// (une bougie HA n'englobe jamais la précédente), notre score plafonnait à 80.
// Un seuil à 50 agissait donc en réalité comme un seuil à 62 % de l'échelle
// atteignable — d'où le biais que Jeremy a constaté : « il me figure fort alors
// qu'il est moyen chez nous ».
//
// MESURÉ sur les 203 flèches de l'original (197 FORT / 6 MOYEN) :
//     moyenne des 5 termes : 15 vraies FORT déclassées à tort, 19 erreurs
//     moyenne des 4 termes :  3 vraies FORT déclassées à tort,  9 erreurs
// L'englobement reste calculé : il sert aux filtres, pas au score.
sg_score = (sg_sStr + sg_sMom + sg_sVol + sg_sGap) / 4.0 * 100.0
sg_scoreTxt = sg_score >= sg_scoreMin ? "Fort" : sg_score >= sg_force ? "Moyen" : "Faible"
sg_scoreCol = sg_score >= sg_scoreMin ? sg_c_ok : sg_score >= sg_force ? sg_c_warn : sg_c_dn

// ─── TBT : force suffisante (ADX ≥ Seuil de Force), variante volume en option ───
sg_volRatioPrev = ta.sma(volume, 20)[1] > 0 ? volume[1] / ta.sma(volume, 20)[1] : 0.0
sg_tbtOk = sg_tbtMode == "ADX ≥ Seuil de Force" ? sg_adx >= sg_force : sg_volRatioPrev >= sg_tbtTh

// ══════════════════════════════════════════════════════════════════════
//  BLACKOUT NO-TRADE  —  reconstruit depuis le panneau de réglages d'Ephore
//                        (capture du 12/10/2026), puis MESURÉ sur les CSV.
//
//  SÉMANTIQUE, et c'est le point crucial : on teste l'heure d'OUVERTURE de
//  la bougie, PAS si la bougie contient l'instant. Mesuré sur les 176
//  flèches du groupe 4 : « la bougie ouvre à » en bloque 9, « la bougie
//  contient » en bloque 30 — soit 21 bonnes flèches détruites. La preuve
//  est nette sur les bougies journalières : 14 des 15 flèches 1D sont
//  conservées par l'original, alors qu'un jour contient forcément 14:30.
//
//  HEURES EN FUSEAU NEW YORK, comme l'original (« Fuseau news/open US (ET) »).
//  Pine convertit lui-même, donc le passage à l'heure d'hiver est géré :
//  du 25 au 31 octobre 2026, 08:30 ET tombe à 13:30 Paris et non 14:30.
//  C'est précisément la semaine que nos données ne couvrent pas.
//
//  CRÉNEAUX ACTIFS PAR DÉFAUT : seuls les deux rendez-vous de données US.
//  Les ouvertures de marché sont DÉCOCHÉES, et ce n'est pas une supposition :
//  3 flèches sont conservées à 15:30 Paris (ouverture US) et 2 à 09:00
//  (ouverture Europe). C'est là que le graphique de Jeremy diffère du
//  terminal web, qui lui affiche bien 4 bandes.
//
//  ACCORD MESURÉ : 13 retraits corrects, 0 à tort, 6 non expliqués,
//  sur deux jeux de données indépendants. Précision 100 %.
// ══════════════════════════════════════════════════════════════════════
grp_bo    = "=== BLACKOUT NO-TRADE ==="
bo_marge  = input.int(3, "Minutes avant / après", group=grp_bo, minval=0, maxval=60,
     tooltip="Valeur du panneau d'Ephore. Les données ne la contraignent pas : toute marge de 0 à 9 donne le même résultat, la flèche conservée la plus proche d'un créneau est à 10 minutes.")
bo_us830  = input.bool(true,  "Données US 08:30 ET (CPI, PPI, Retail, GDP, PCE, NFP, Jobless)", group=grp_bo)
bo_us1000 = input.bool(true,  "Données 10:00 ET (ISM, JOLTS, UMich)", group=grp_bo)
bo_openUS = input.bool(false, "Ouverture US 09:30 ET", group=grp_bo,
     tooltip="Décoché chez Ephore : 3 flèches sont conservées à cette heure.")
bo_openEU = input.bool(false, "Ouverture Europe 09:00 Paris", group=grp_bo,
     tooltip="Décoché chez Ephore : 2 flèches sont conservées à cette heure.")
bo_fomc   = input.bool(false, "FOMC, mercredi 14:00 ET", group=grp_bo)

// La bougie ouvre-t-elle à moins de `marge` minutes de hh:mm dans ce fuseau ?
f_bo_pres(tz, hh, mm) =>
    math.abs((hour(time, tz) * 60 + minute(time, tz)) - (hh * 60 + mm)) <= bo_marge

f_sg_news() =>
    ny = "America/New_York"
    bool hit = false
    if timeframe.isintraday
        if bo_us830 and f_bo_pres(ny, 8, 30)
            hit := true
        if bo_us1000 and f_bo_pres(ny, 10, 0)
            hit := true
        if bo_openUS and f_bo_pres(ny, 9, 30)
            hit := true
        if bo_openEU and f_bo_pres("Europe/Paris", 9, 0)
            hit := true
        if bo_fomc and dayofweek(time, ny) == dayofweek.wednesday and f_bo_pres(ny, 14, 0)
            hit := true
    hit
sg_newsBar = sg_filter and f_sg_news()

// ─── FLÈCHES SIGNATOR ───
var int sg_run = 0
sg_run := bar_index == 0 ? 1 : sg_heiBull == sg_heiBull[1] ? sg_run + 1 : 1
sg_ema60  = ta.ema(close, 60)
sg_dBand  = sg_heiBull ? (close - math.max(sg_ema50, sg_ema60)) / sg_atr : (math.min(sg_ema50, sg_ema60) - close) / sg_atr
sg_conv   = sg_dBand >= 0.3 or volume >= sg_volMa

// ─── V9 : la bougie du signal doit SATURER un terme du Candle Quality Filter ───
// Trouvé le 12/10 par deux recherches indépendantes qui ont convergé.
// La V8 notait le momentum et la position de clôture dans le score, sans jamais
// exiger qu'ils soient atteints. L'original, lui, exige que l'un des deux le soit.
//   momentum saturé  : range >= 0.5 × ATR14   (la constante 0.5 est déjà celle
//                      de sg_sMom ci-dessus, min(range / (0.5·ATR), 1))
//   clôture saturée  : cpos  >= 0.67          (déjà celle de sg_sStr, cpos/0.67)
// AUCUNE constante nouvelle : c'est une relecture du filtre existant, qui passe
// de « noté » à « doit être franchi ». Ce n'est donc pas un seuil ajusté.
//
// Effet mesuré sur le groupe 4 des 14 exports « Base 10:10/Ajustements »
// (MES + NQ, 7 unités de temps, ~9000 barres, 155 flèches de vérité) :
//     V8   153 exactes / 6 en trop / 2 manquées   précision  96.2 %
//     V9   153 exactes / 0 en trop / 2 manquées   précision 100.0 %
// Aucune perte de rappel. Confirmé sur Singal (5 → 3 faux) et Filtres (5 → 3),
// où les 3 restants sont des flèches d'une AUTRE version d'Ephore, pas des
// erreurs. Les 6 faux positifs de la V8 échouent tous la clause, et les
// 155 vraies flèches la passent toutes (155/155).
// Les 6 faux positifs occupaient 6 des 7 plus petits range/ATR sur 161
// événements : p = 3.2e-10. Validation croisée MES↔NQ et par unité de temps :
// le seuil 0.50 ressort indépendamment à chaque découpage.
sg_v9     = input.bool(true, "Conviction V9 : exiger momentum OU clôture saturés", group=grp_sg,
     tooltip="Ajoute à la conviction V8 la condition « range >= 0.5×ATR14 OU position de clôture >= 0.67 ». Mesuré : 6 faux positifs supprimés sur 6, zéro vraie flèche perdue. Décocher pour retrouver le comportement V8 exact.")
sg_satur  = sg_rng >= 0.5 * sg_atr or sg_cpos >= 0.67

sg_base   = sg_arrows and sg_run == 2 and sg_adx >= sg_force and (sg_heiBull ? close > sg_ema50 : close < sg_ema50) and sg_conv and (not sg_v9 or sg_satur) and not sg_newsBar
sg_isFort = sg_score >= sg_scoreMin
sg_long   = sg_base and sg_heiBull and sg_isFort
sg_short  = sg_base and not sg_heiBull and sg_isFort
sg_longM  = sg_base and sg_showM and sg_heiBull and not sg_isFort and sg_score >= sg_force
sg_shortM = sg_base and sg_showM and not sg_heiBull and not sg_isFort and sg_score >= sg_force
plotshape(sg_long,   "Signator Long",        style=shape.arrowup,   location=location.belowbar, color=sg_arUp, size=size.normal)
plotshape(sg_short,  "Signator Short",       style=shape.arrowdown, location=location.abovebar, color=sg_arDn, size=size.normal)
plotshape(sg_longM,  "Signator Long Moyen",  style=shape.arrowup,   location=location.belowbar, color=sg_arUp, size=size.small)
plotshape(sg_shortM, "Signator Short Moyen", style=shape.arrowdown, location=location.abovebar, color=sg_arDn, size=size.small)
alertcondition(sg_long or sg_longM,   "Signator Long",  "Flèche Signator long")
alertcondition(sg_short or sg_shortM, "Signator Short", "Flèche Signator short")

// ─── Construction ───
sg_pos_v = sg_pos == "Top Right" ? position.top_right : sg_pos == "Middle Left" ? position.middle_left :
     sg_pos == "Middle Right" ? position.middle_right : sg_pos == "Bottom Left" ? position.bottom_left :
     sg_pos == "Bottom Right" ? position.bottom_right : position.top_left
sg_sz = sg_szS == "Tiny" ? size.tiny : sg_szS == "Small" ? size.small : sg_szS == "Large" ? size.large : size.normal

var table sg_tbl = table.new(position.top_left, 2, 5, bgcolor=sg_c_bg, border_width=0)

if barstate.islast and sg_show
    table.set_position(sg_tbl, sg_pos_v)
    table.cell(sg_tbl, 0, 0, "Heishinator", text_color=sg_c_lbl, text_size=sg_sz, text_halign=text.align_right)
    table.cell(sg_tbl, 1, 0, sg_heiBull ? "⬆ Haussier" : "⬇ Baissier", text_color=sg_heiBull ? sg_c_up : sg_c_dn, text_size=sg_sz, text_halign=text.align_left)
    table.cell(sg_tbl, 0, 1, "TBT", text_color=sg_c_lbl, text_size=sg_sz, text_halign=text.align_right)
    table.cell(sg_tbl, 1, 1, sg_tbtOk ? "✔ OK" : "⛔ Faible", text_color=sg_tbtOk ? sg_c_ok : sg_c_dn, text_size=sg_sz, text_halign=text.align_left)
    table.cell(sg_tbl, 0, 2, "Tendance", text_color=sg_c_lbl, text_size=sg_sz, text_halign=text.align_right)
    table.cell(sg_tbl, 1, 2, sg_trendBull ? "⬆ Haussière" : "⬇ Baissière", text_color=sg_trendBull ? sg_c_up : sg_c_dn, text_size=sg_sz, text_halign=text.align_left)
    table.cell(sg_tbl, 0, 3, "Score", text_color=sg_c_lbl, text_size=sg_sz, text_halign=text.align_right)
    table.cell(sg_tbl, 1, 3, sg_scoreTxt, text_color=sg_scoreCol, text_size=sg_sz, text_halign=text.align_left)
    table.cell(sg_tbl, 0, 4, "TF", text_color=sg_c_lbl, text_size=sg_sz, text_halign=text.align_right)
    table.cell(sg_tbl, 1, 4, "Actuel", text_color=sg_c_off, text_size=sg_sz, text_halign=text.align_left)

// ══════════════════════════════════════════════════════════════
// GARDE-FOU : graphique en Heiken Ashi
// ══════════════════════════════════════════════════════════════
// TOUT cet indicateur a été calibré sur des bougies Heiken Ashi (Heishinator,
// Signator, Climax, tableaux). Sur des bougies normales les valeurs sont
// fausses sans que rien ne le signale. D'où cet avertissement visible.
if barstate.islast and not chart.is_heikinashi
    var label ha_warn = na
    label.delete(ha_warn)
    ha_warn := label.new(bar_index, high, "⚠ Ephore : passe le graphique en Heiken Ashi\n(tous les calculs sont calibrés dessus)",
         style=label.style_label_down, color=color.new(color.red, 10),
         textcolor=color.white, size=size.normal)

// ══════════════════════════════════════════════════════════════
// LES 3 TABLEAUX MANQUANTS + LE FEU DE CONFLUENCE — NOUVEAU (12/10/2026)
// ══════════════════════════════════════════════════════════════
// Reconstitués à partir de 4 captures du 12/10 (MES 15 min, bougie 14:00 Paris),
// identifiées de façon certaine : la légende affichait Moyenator 7871,48/7870,65
// et le CSV donne 7871.4986/7870.6657 — un seul couple colle sur 15 fichiers.
//
// CE QUI EST VÉRIFIÉ AU CHIFFRE PRÈS (recalculé sur le CSV du même instant)
//   CCI (30) = CCI standard sur prix typique HA : calculé −78.09 contre −78.03 affiché
//   YoYo     = (close − SMA10) / SMA10 × 100   : calculé 0.011 % contre 0.01 % affiché
//   RSI (14) = RSI de Wilder sur close HA      : écart 1.1 point, expliqué par la
//              bougie en cours (35.57 à close 7866.00 contre 35.35 affiché)
//   TREND    = close HA > EMA50                : 5 unités de temps sur 5
//
// CE QUI RESTE UNE HYPOTHÈSE, et il faut le savoir
//   STRENGTH : la structure est sûre — c'est 25 % × (nombre de tests haussiers
//              vrais parmi 4), et c'est une PRESSION ACHETEUSE ABSOLUE, pas une
//              conviction dans le TREND affiché (preuve : l'unité 3 est BEARISH
//              avec 100 %). Mais UNE seule capture ne donne que 5 contraintes, et
//              186 combinaisons de 4 tests les satisfont. Celle codée ici fait 5/5
//              sur la capture ; elle n'est pas démontrée.
//   LES 10 VOIX du bloc SuperTrader dans le Feu ne sont pas identifiées. Les 19
//              autres le sont (6 Dashator + 7 SIGNAL + 6 TREND). Le choix codé ici
//              est explicite et modifiable.
//
// POUR TRANCHER IL MANQUE : un export 3 minutes (l'unité qui contredit tout), et
// 3 captures à des moments où les valeurs bougent. Détail dans NOTES_TABLEAUX.md.

grp_t3 = "=== LES 3 TABLEAUX ==="
t3_on   = input.bool(true, "Afficher les 3 tableaux", group=grp_t3)
// Les trois premiers noms sont ceux du menu déroulant d'Ephore, lus sur la
// capture du 13/10. « Séparés » est en plus : c'est la disposition de l'ANCIENNE
// version, où les tableaux INDICATOR|SIGNAL et TIMEFRAME|TREND étaient encore
// deux panneaux distincts. Ils ont fusionné depuis.
t3_mode = input.string("Normal", "Disposition des cellules", group=grp_t3,
     options=["Normal", "Groupé par couleur", "Feu seul", "Séparés (ancienne version)"],
     tooltip="Normal = la grille unifiée d'Ephore : TREND, STRENGTH, unité de temps, puis les indicateurs. Groupé par couleur = toutes les cellules retriées par camp. Feu seul = uniquement le badge. Séparés = les 3 panneaux de l'ancienne version.")
t3_seuil = input.int(60, "Seuil du Feu de Confluence (%)", group=grp_t3, minval=50, maxval=100)
t3_posS  = input.string("Bottom Left",  "Position — INDICATOR | SIGNAL", group=grp_t3,
     options=["Top Left","Top Right","Top Center","Middle Left","Middle Right","Bottom Left","Bottom Right","Bottom Center"])
t3_posT  = input.string("Bottom Right", "Position — TIMEFRAME | TREND", group=grp_t3,
     options=["Top Left","Top Right","Top Center","Middle Left","Middle Right","Bottom Left","Bottom Right","Bottom Center"])
t3_posD  = input.string("Bottom Center","Position — Dashator", group=grp_t3,
     options=["Top Left","Top Right","Top Center","Middle Left","Middle Right","Bottom Left","Bottom Right","Bottom Center"])
t3_posF  = input.string("Middle Left",  "Position — tableau fusionné / badge", group=grp_t3,
     options=["Top Left","Top Right","Top Center","Middle Left","Middle Right","Bottom Left","Bottom Right","Bottom Center"])
t3_puces = input.bool(false, "Puces devant les états", group=grp_t3,
     tooltip="Option d'Ephore qu'on n'implémentait pas. Préfixe chaque état d'une puce ronde, comme « ● Bull ».")
t3_sz    = input.string("Normal", "Taille du texte", group=grp_t3,
     options=["Tiny", "Small", "Normal", "Large", "Huge"],
     tooltip="Ce réglage ne pilotait rien : les cellules étaient figées en « Small ». Il agit désormais sur tout le tableau unifié.")
t3_tf1 = input.timeframe("3",   "TIMEFRAME — unité 1", group=grp_t3,
     tooltip="15/10 : la 1re ligne TREND/STRENGTH de l'original est calculée en 3 minutes (le libellé « 1m » affiché est celui du Dashator). En 1 minute, la capture du 15/10 est contredite.")
t3_trClos = input.bool(true, "TREND : bougie clôturée (comme l'original)", group=grp_t3,
     tooltip="15/10 : l'original compare la clôture de la DERNIÈRE BOUGIE CLÔTURÉE de chaque unité à son EMA50. Preuve forte en 1D (bougie en cours : -284 points, BEARISH ; veille clôturée : +211, BULLISH comme l'original). 22 ou 23 relevés sur 23. Décocher = bougie en cours.")
t3_tf2 = input.timeframe("5",   "TIMEFRAME — unité 2", group=grp_t3)
t3_tf3 = input.timeframe("15",  "TIMEFRAME — unité 3", group=grp_t3)
t3_tf4 = input.timeframe("60",  "TIMEFRAME — unité 4", group=grp_t3)
t3_tf5 = input.timeframe("240", "TIMEFRAME — unité 5", group=grp_t3)
t3_tf6 = input.timeframe("1D",  "TIMEFRAME — unité 6", group=grp_t3)
t3_dd1 = input.timeframe("1",   "Dashator — unité 1", group=grp_t3)
t3_dd2 = input.timeframe("5",   "Dashator — unité 2", group=grp_t3)
t3_dd3 = input.timeframe("15",  "Dashator — unité 3", group=grp_t3)
t3_dd4 = input.timeframe("60",  "Dashator — unité 4", group=grp_t3)
t3_dd5 = input.timeframe("240", "Dashator — unité 5", group=grp_t3)
t3_dd6 = input.timeframe("1D",  "Dashator — unité 6", group=grp_t3)

// ─── Palette ───
// Relevée au pixel sur la capture de l'original du 14/10 (tableau unifié).
// L'original remplit les cellules en couleur pleine avec un texte blanc, alors
// que le tableau principal (Midgar) utilise un fond teinté et un texte coloré :
// les deux styles ne doivent pas être mélangés.
t3_cBull = color.rgb(88, 99, 244)    // bleu plein
t3_cBear = color.rgb(199, 88, 76)    // rouge plein
t3_cOrn  = color.rgb(221, 156, 57)   // orange plein
t3_cSup  = color.rgb(143, 178, 240)  // bleu clair (SUPERBULL, Unusual), texte foncé
t3_cNavy = color.rgb(29, 33, 60)     // neutre (« — », « None »), texte gris
t3_cGris = color.rgb(122, 123, 133)
t3_cBord = color.rgb(15, 15, 25)     // bordures quasi noires
t3_cDark = color.rgb(21, 22, 45)
t3_cNeut = color.rgb(45, 46, 70)

// Les sémantiques du tableau principal, traduites dans le style plein.
f_t3_semBg(s) => s == "bull" ? t3_cBull : s == "bear" ? t3_cBear : s == "super" ? t3_cSup : s == "warn" ? t3_cOrn : t3_cNavy
f_t3_semTx(s) => s == "super" ? t3_cDark : s == "bull" or s == "bear" or s == "warn" ? color.white : t3_cGris

// ─── Le paquet multi-unités : TREND + les 4 tests du STRENGTH ───
// Un seul request.security par unité : on respecte la limite de 40 appels.
f_t3_tfLbl(_tf) =>
    _n = str.tonumber(_tf)
    na(_n) ? _tf : _n >= 1440 ? str.tostring(_n / 1440, "#") + "D" : _n >= 60 ? str.tostring(_n / 60, "#") + "H" : str.tostring(_n, "#") + "m"

f_t3_pack() =>
    e50 = ta.ema(close, 50)
    [m, sg, _h] = ta.macd(close, 12, 26, 9)
    r  = ta.rsi(close, 14)
    // TREND : vérifié 5/5 sur la capture du 12/10
    tr = t3_trClos ? close[1] > e50[1] : close > e50
    // STRENGTH : 25 % par test haussier vrai. Structure certaine, choix des tests
    // non démontré (186 combinaisons possibles sur une seule capture).
    st = (close > open ? 1 : 0) + (m > sg ? 1 : 0) + (close > e50 ? 1 : 0) + (r > 50 ? 1 : 0)
    [tr, st, close > open]

[t3_tr1, t3_st1, t3_b1] = request.security(syminfo.tickerid, t3_tf1, f_t3_pack(), lookahead=barmerge.lookahead_off)
[t3_tr2, t3_st2, t3_b2] = request.security(syminfo.tickerid, t3_tf2, f_t3_pack(), lookahead=barmerge.lookahead_off)
[t3_tr3, t3_st3, t3_b3] = request.security(syminfo.tickerid, t3_tf3, f_t3_pack(), lookahead=barmerge.lookahead_off)
[t3_tr4, t3_st4, t3_b4] = request.security(syminfo.tickerid, t3_tf4, f_t3_pack(), lookahead=barmerge.lookahead_off)
[t3_tr5, t3_st5, t3_b5] = request.security(syminfo.tickerid, t3_tf5, f_t3_pack(), lookahead=barmerge.lookahead_off)
[t3_tr6, t3_st6, t3_b6] = request.security(syminfo.tickerid, t3_tf6, f_t3_pack(), lookahead=barmerge.lookahead_off)

// ─── Dashator : bougie HA haussière sur chaque unité ───
// Règle retenue : 6/6 sur une capture, 5/6 sur l'autre (le seul écart est une
// bougie 1H en cours, à 0.42 point). Les règles concurrentes font 2 à 4 sur 6.
f_t3_ha() => close > open
t3_d1 = request.security(syminfo.tickerid, t3_dd1, f_t3_ha(), lookahead=barmerge.lookahead_off)
t3_d2 = request.security(syminfo.tickerid, t3_dd2, f_t3_ha(), lookahead=barmerge.lookahead_off)
t3_d3 = request.security(syminfo.tickerid, t3_dd3, f_t3_ha(), lookahead=barmerge.lookahead_off)
t3_d4 = request.security(syminfo.tickerid, t3_dd4, f_t3_ha(), lookahead=barmerge.lookahead_off)
t3_d5 = request.security(syminfo.tickerid, t3_dd5, f_t3_ha(), lookahead=barmerge.lookahead_off)
t3_d6 = request.security(syminfo.tickerid, t3_dd6, f_t3_ha(), lookahead=barmerge.lookahead_off)

// ─── INDICATOR | SIGNAL : 7 lignes ───
[t3_stv, t3_std] = ta.supertrend(3, 10)
t3_sigST  = t3_std < 0
t3_sigMA  = close > ta.ema(close, 50)
t3_sigVW  = close > ta.vwap(hlc3)
// LIN REGRESS — deux lectures sont possibles et nous avions choisi la seconde
// sans jamais la vérifier. Sur le relevé simultané du 13/10, l'original affiche
// Bull là où nous affichons Bear : notre lecture est donc probablement la
// mauvaise. Le réglage permet de trancher en une seconde sur le graphique.
t3_lrLen  = input.int(100, "Lin Regress — période", group=grp_t3, minval=2)
t3_lrMode = input.string("Prix au-dessus de la droite", "Lin Regress — critère", group=grp_t3,
     options=["Prix au-dessus de la droite", "Droite orientée à la hausse"],
     tooltip="Le premier compare la clôture à la droite de régression. Le second regarde la pente de la droite — c'est ce que nous faisions, et ça ne correspond pas au relevé.")
t3_lrNow  = ta.linreg(close, t3_lrLen, 0)
t3_sigLR  = t3_lrMode == "Prix au-dessus de la droite" ? close > t3_lrNow : t3_lrNow > ta.linreg(close, t3_lrLen, 1)
[t3_pdh, t3_pdl, t3_pdc] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1]], lookahead=barmerge.lookahead_on)
t3_cprP  = (t3_pdh + t3_pdl + t3_pdc) / 3
t3_cprBC = (t3_pdh + t3_pdl) / 2
t3_cprTC = 2 * t3_cprP - t3_cprBC
t3_cprHi = math.max(t3_cprTC, t3_cprBC)
t3_cprLo = math.min(t3_cprTC, t3_cprBC)
t3_cpr   = close > t3_cprHi ? 1 : close < t3_cprLo ? -1 : 0
t3_cprTx = t3_cpr == 1 ? "Above TC" : t3_cpr == -1 ? "Below BC" : "Inside"

// ORB — CORRIGÉ le 13/10. Nous ancrions la plage d'ouverture sur le début de la
// bougie JOURNALIÈRE (`ta.change(time("D"))`). Or pour un future comme MES ou NQ,
// la journée TradingView commence à 18:00 New York, c'est-à-dire à l'ouverture
// de la séance de nuit. Nous mesurions donc les 15 premières minutes de la nuit,
// pas celles de la séance régulière — une zone de prix sans rapport. D'où le
// « Below » que nous affichions quand l'original affichait « In Range ».
// L'ancre est désormais la première barre de la séance régulière.
t3_orbSess = input.session("0930-1600", "ORB — séance de référence", group=grp_t3,
     tooltip="Heure de New York. 0930-1600 = séance régulière américaine, celle qu'un ORB mesure par convention.")
t3_orbMin  = input.int(15, "ORB — durée en minutes", group=grp_t3, minval=1, maxval=240)
// 14/10 : avec l'ancre « séance US », on affiche « Above » quand l'original
// affiche « In Range » (deux relevés). L'original affichait déjà « In Range »
// quand on ancrait sur le début de journée TradingView (le 13/10, nous disions
// « Below »). Aucune des deux ancres n'est donc la bonne, et rien dans les
// sources ne donne la sienne. Le réglage ci-dessous permet de tester les ancres
// plausibles, et la bulle de la cellule ORB affiche la plage mesurée.
t3_orbAnc  = input.string("Séance US (réglage ci-dessus)", "ORB — ancre", group=grp_t3,
     options=["Séance US (réglage ci-dessus)", "Début de journée TradingView", "Europe 09:00 Paris"],
     tooltip="Point de départ de la plage d'ouverture. Survole la cellule ORB du tableau : la bulle donne le haut, le bas et l'heure de départ de la plage mesurée.")
t3_inSess  = not na(time(timeframe.period, t3_orbSess, "America/New_York"))
t3_inEu    = not na(time(timeframe.period, "0900-1730", "Europe/Paris"))
t3_newDay  = ta.change(time("D")) != 0
t3_sessOpn = t3_orbAnc == "Début de journée TradingView" ? t3_newDay : t3_orbAnc == "Europe 09:00 Paris" ? t3_inEu and not t3_inEu[1] : t3_inSess and not t3_inSess[1]
var float t3_orbH = na
var float t3_orbL = na
var int   t3_orbT = na
// 15/10 : chaque nouvelle journée efface la plage de la veille ; tant que la
// plage du jour n'est pas formée, l'état est « In Range ». C'est la seule
// lecture qui donne « In Range » sur les 4 jours relevés (12, 13, 14 et 15/10,
// tous avant 15:30 Paris). Chaque autre ancre est réfutée par au moins un
// relevé (tools/jeu1510/tableau/s4_orb.py). À confirmer après 15:45 Paris.
if t3_newDay and t3_orbAnc != "Début de journée TradingView"
    t3_orbH := na
    t3_orbL := na
    t3_orbT := na
if t3_sessOpn
    t3_orbT := time
    t3_orbH := high
    t3_orbL := low
else if not na(t3_orbT) and time - t3_orbT < t3_orbMin * 60 * 1000
    t3_orbH := math.max(t3_orbH, high)
    t3_orbL := math.min(t3_orbL, low)
t3_orb   = not timeframe.isintraday or na(t3_orbH) ? 0 : close > t3_orbH ? 1 : close < t3_orbL ? -1 : 0
t3_orbTx = not timeframe.isintraday ? "N/A" : t3_orb == 1 ? "Above" : t3_orb == -1 ? "Below" : "In Range"
// Bulle de diagnostic : la plage réellement mesurée, à comparer au graphique.
t3_orbTip = na(t3_orbH) ? "ORB : plage du jour pas encore formée (In Range par défaut)" : "ORB (" + t3_orbAnc + ") : haut " + str.tostring(t3_orbH, format.mintick) + " / bas " + str.tostring(t3_orbL, format.mintick) + " / clôture " + str.tostring(close, format.mintick) + " — départ " + str.format_time(t3_orbT, "dd/MM HH:mm", "Europe/Paris") + " (Paris)"
t3_pd    = close > t3_pdh ? 1 : close < t3_pdl ? -1 : 0
t3_pdTx  = t3_pd == 1 ? "Above PDH" : t3_pd == -1 ? "Below PDL" : "In Range"

// ─── LE FEU DE CONFLUENCE : 29 voix ───
// Décomposition prouvée par la source du terminal web (GROUPES_FEU) :
//   « Colonne temps (6 voix) » + « Bloc SuperTrader (10 voix) »
//   + « Colonne SIGNAL (7 voix) » + « Tendances multi-unités (6 voix) » = 29
// et l'API expose bien 29 votes avec un seuil de 60 %.
// 15/10 — LES 29 VOIX SONT CÂBLÉES, ET ELLES VOTENT PAR LE SENS, PAS PAR LA COULEUR.
// Plusieurs cellules du tableau Midgar sont bleues sans dire où va le marché
// (YoYo, VIX, niveau du VIX, volumes) : nous les faisions voter LONG, et nous
// ignorions des cellules rouges directionnelles. Bloc SuperTrader retenu
// (10 voix) : Trend, Cross, CCI, RSI, MACD 10m, Gap (Bull% contre Bear%), PA
// 1/5/15 min, Divergence. Golden/SUPERBULL/Bullish = long, Death/Bearish =
// short, « — », Basing, None et cases vides = neutre.
// PREUVE : solide pour le noyau Trend, CCI, RSI, MACD, Gap, PA2, PA3, imposé par
// l'arithmétique de la capture du 14/10 (SHORT exige au moins 7 short sur 10).
// Faible pour Cross, Divergence et PA1. Capture du 14/10 : 62 % SHORT comme
// l'original ; 15/10 : SHORT comme l'original.
f_t3_dirSem(sem) => sem == "bull" or sem == "super" ? 1 : sem == "bear" ? -1 : 0
t3_vMacd  = st_macdTxt == "SUPERBULL" or st_macdTxt == "Bullish" ? 1 : st_macdTxt == "Bearish" ? -1 : 0
t3_vCross = st_crossTxt == "Golden" ? 1 : st_crossTxt == "Death" ? -1 : 0
t3_votes  = array.from(t3_d1 ? 1 : -1, t3_d2 ? 1 : -1, t3_d3 ? 1 : -1, t3_d4 ? 1 : -1, t3_d5 ? 1 : -1, t3_d6 ? 1 : -1,
     st_trendUp ? 1 : -1, t3_vCross, st_cci >= 0 ? 1 : -1, st_rsi >= 50 ? 1 : -1, t3_vMacd,
     st_bullPct >= st_bearPct ? 1 : -1, f_t3_dirSem(st_pa1s), f_t3_dirSem(st_pa2s), f_t3_dirSem(st_pa3s), f_t3_dirSem(st_divShowSem),
     t3_sigST ? 1 : -1, t3_sigMA ? 1 : -1, t3_sigVW ? 1 : -1, t3_sigLR ? 1 : -1, t3_cpr, t3_orb, t3_pd,
     t3_tr1 ? 1 : -1, t3_tr2 ? 1 : -1, t3_tr3 ? 1 : -1, t3_tr4 ? 1 : -1, t3_tr5 ? 1 : -1, t3_tr6 ? 1 : -1)
int t3_nLong  = 0
int t3_nShort = 0
for v in t3_votes
    if v == 1
        t3_nLong += 1
    else if v == -1
        t3_nShort += 1
// Dénominateur : les 29 voix de l'original (6 Dashator + 10 SuperTrader +
// 7 SIGNAL + 6 TREND), comme le confirme l'API (part = voix / 29).
t3_nTot  = array.size(t3_votes)
t3_pLong  = 100.0 * t3_nLong  / t3_nTot
t3_pShort = 100.0 * t3_nShort / t3_nTot
t3_feuTxt = t3_pLong >= t3_seuil ? "LONG" : t3_pShort >= t3_seuil ? "SHORT" : "NEUTRE"
t3_feuCol = t3_feuTxt == "LONG" ? t3_cBull : t3_feuTxt == "SHORT" ? t3_cBear : t3_cOrn

// ─── Helpers d'affichage ───
f_t3_pos(p) =>
    p == "Top Left" ? position.top_left : p == "Top Right" ? position.top_right :
     p == "Top Center" ? position.top_center : p == "Middle Left" ? position.middle_left :
     p == "Middle Right" ? position.middle_right : p == "Bottom Left" ? position.bottom_left :
     p == "Bottom Center" ? position.bottom_center : position.bottom_right
f_t3_stCol(v) => v <= 25 ? t3_cBear : v == 50 ? t3_cOrn : t3_cBull
f_t3_sigCol(v) => v == 1 ? t3_cBull : v == -1 ? t3_cBear : t3_cOrn

// ─── Rendu ───
var table t3_tS = na
var table t3_tT = na
var table t3_tD = na
var table t3_tF = na
var bool  t3_init = false

if barstate.islast and t3_on
    if not t3_init
        t3_tS := table.new(f_t3_pos(t3_posS), 2, 8, bgcolor=t3_cDark, border_width=1, border_color=color.rgb(95, 97, 125))
        t3_tT := table.new(f_t3_pos(t3_posT), 3, 7, bgcolor=t3_cDark, border_width=1, border_color=color.rgb(95, 97, 125))
        t3_tD := table.new(f_t3_pos(t3_posD), 1, 7, bgcolor=t3_cDark, border_width=1, border_color=color.rgb(95, 97, 125))
        t3_tF := table.new(f_t3_pos(t3_posF), 6, 10, bgcolor=t3_cDark, border_width=1,
             border_color=t3_mode == "Normal" ? t3_cBord : color.rgb(95, 97, 125))
        // Grille « Normal » : les 3 dernières lignes de l'original sont des
        // cellules fusionnées (capture du 14/10). Le réglage de disposition ne
        // change pas en cours d'exécution, on fusionne donc une seule fois.
        if t3_mode == "Normal"
            table.merge_cells(t3_tF, 0, 6, 1, 6)
            table.merge_cells(t3_tF, 0, 7, 2, 7)
            table.merge_cells(t3_tF, 3, 7, 5, 7)
            table.merge_cells(t3_tF, 0, 8, 5, 8)
        t3_init := true

    szU    = f_sz(t3_sz)
    // Libellés d'unités comme chez l'original : 1m, 5m, 15m, 1H, 4H, 1D —
    // et non les chaînes brutes "60" et "240" qu'on affichait.
    mainL  = array.from(st_trendUp ? "Bullish" : "Bearish", str.tostring(st_bullCount) + " / 3",
                        str.tostring(st_bearCount) + " / 3", str.tostring(st_yoyo, "#.##") + "%",
                        str.tostring(st_bullPct, "#.##") + "%", str.tostring(st_bearPct, "#.##") + "%",
                        st_divShow, st_vixTxt, st_lvl1)
    mainLs = array.from(st_trendUp ? "bull" : "bear", "bull", "bear", st_yoyoSem,
                        st_bullPct >= st_bearPct ? "bull" : "bear", st_bearPct > st_bullPct ? "bull" : "bear",
                        st_divShowSem, st_vixSem, st_volSem(st_lvl1))
    mainR  = array.from(st_crossTxt, str.tostring(st_cci, "#.##"), str.tostring(st_rsi, "#.##"),
                        st_macdTxt, st_pa1, st_pa2, st_pa3, st_vixLvl, st_lvl2)
    mainRs = array.from(st_crossSem, st_cci >= 0 ? "bull" : "bear", st_rsi >= 50 ? "bull" : "bear",
                        st_macdSem, st_pa1s, st_pa2s, st_pa3s, st_vixLvlSem, st_volSem(st_lvl2))
    sigTx  = array.from("SuperTrend", "Moving Avg", "VWAP", "Lin Regress", "CPR", "ORB 15min", "PDH/PDL")
    puce   = t3_puces ? "● " : ""
    sigVal = array.from(puce + (t3_sigST ? "Bull" : "Bear"), puce + (t3_sigMA ? "Bull" : "Bear"),
                        puce + (t3_sigVW ? "Bull" : "Bear"), puce + (t3_sigLR ? "Bull" : "Bear"),
                        puce + t3_cprTx, puce + t3_orbTx, puce + t3_pdTx)
    sigPol = array.from(t3_sigST ? 1 : -1, t3_sigMA ? 1 : -1, t3_sigVW ? 1 : -1, t3_sigLR ? 1 : -1,
                        t3_cpr, t3_orb, t3_pd)
    tfTx   = array.from(f_t3_tfLbl(t3_tf1), f_t3_tfLbl(t3_tf2), f_t3_tfLbl(t3_tf3), f_t3_tfLbl(t3_tf4), f_t3_tfLbl(t3_tf5), f_t3_tfLbl(t3_tf6))
    tfTr   = array.from(t3_tr1, t3_tr2, t3_tr3, t3_tr4, t3_tr5, t3_tr6)
    tfSt   = array.from(t3_st1 * 25, t3_st2 * 25, t3_st3 * 25, t3_st4 * 25, t3_st5 * 25, t3_st6 * 25)
    ddTx   = array.from(f_t3_tfLbl(t3_dd1), f_t3_tfLbl(t3_dd2), f_t3_tfLbl(t3_dd3), f_t3_tfLbl(t3_dd4), f_t3_tfLbl(t3_dd5), f_t3_tfLbl(t3_dd6))
    ddB    = array.from(t3_d1, t3_d2, t3_d3, t3_d4, t3_d5, t3_d6)

    sep = t3_mode == "Séparés (ancienne version)"
    fus = t3_mode == "Normal"
    grp = t3_mode == "Groupé par couleur"

    // -- mode Séparés : les 3 panneaux comme la v30 --
    if sep
        table.cell(t3_tS, 0, 0, "🤖 INDICATOR", text_color=color.silver, text_size=szU)
        table.cell(t3_tS, 1, 0, "🎯 SIGNAL",    text_color=color.silver, text_size=szU)
        for k = 0 to 6
            table.cell(t3_tS, 0, k + 1, array.get(sigTx, k), text_color=color.silver, text_size=szU)
            table.cell(t3_tS, 1, k + 1, array.get(sigVal, k), text_color=color.white, text_size=szU,
                 bgcolor=f_t3_sigCol(array.get(sigPol, k)), tooltip=k == 5 ? t3_orbTip : "")
        table.cell(t3_tT, 0, 0, "TIMEFRAME", text_color=color.silver, text_size=szU)
        table.cell(t3_tT, 1, 0, "TREND",     text_color=color.silver, text_size=szU)
        table.cell(t3_tT, 2, 0, "STRENGTH",  text_color=color.silver, text_size=szU)
        for k = 0 to 5
            table.cell(t3_tT, 0, k + 1, array.get(tfTx, k), text_color=color.silver, text_size=szU)
            table.cell(t3_tT, 1, k + 1, array.get(tfTr, k) ? "BULLISH" : "BEARISH", text_color=color.white,
                 text_size=szU, bgcolor=array.get(tfTr, k) ? t3_cBull : t3_cBear)
            table.cell(t3_tT, 2, k + 1, str.tostring(array.get(tfSt, k)) + "%", text_color=color.white,
                 text_size=szU, bgcolor=f_t3_stCol(array.get(tfSt, k)))
        table.cell(t3_tD, 0, 0, "⏱", text_color=color.silver, text_size=szU)
        for k = 0 to 5
            table.cell(t3_tD, 0, k + 1, array.get(ddTx, k), text_color=color.white, text_size=szU,
                 bgcolor=array.get(ddB, k) ? t3_cBull : t3_cBear)

    // -- mode Normal : la grille unifiée d'Ephore --
    // Relevée cellule par cellule sur la capture de l'original du 14/10 :
    //   lignes 0 à 5 : TREND | STRENGTH | unité | valeur | valeur | SIGNAL
    //     BEARISH  75%  1m   Bearish   —          Bear
    //     BEARISH  25%  5m   1 / 3     -31.79     Bear
    //     BEARISH  25%  15m  0 / 3     49.22      Bear
    //     BEARISH  25%  1H   0.03%     Bearish    Bull
    //     BEARISH  0%   4H   34.92%    SUPERBULL  Below BC
    //     BULLISH  50%  1D   65.08%    Bearish    In Range
    //   ligne 6 : [ VIX (2 col.) ] [ niveau VIX ] [ Divergence ] [ PA 3 ] [ PDH/PDL ]
    //   ligne 7 : [ Volume ticker 1 (3 col.) ] [ Volume ticker 2 (3 col.) ]
    //   ligne 8 : [ LONG / SHORT / NEUTRE (6 col.) ]
    // Toutes les cellules sont en couleur pleine, texte blanc. L'unité de temps
    // est colorée par le Dashator (bougie HA haussière sur cette unité) : c'est
    // la « colonne temps » des 6 voix du Feu. Nous la laissions grise.
    if fus
        for k = 0 to 5
            table.cell(t3_tF, 0, k, array.get(tfTr, k) ? "BULLISH" : "BEARISH", text_color=color.white,
                 text_size=szU, bgcolor=array.get(tfTr, k) ? t3_cBull : t3_cBear)
            table.cell(t3_tF, 1, k, str.tostring(array.get(tfSt, k)) + "%", text_color=color.white,
                 text_size=szU, bgcolor=f_t3_stCol(array.get(tfSt, k)))
            table.cell(t3_tF, 2, k, array.get(ddTx, k), text_color=color.white, text_size=szU,
                 bgcolor=array.get(ddB, k) ? t3_cBull : t3_cBear)
            table.cell(t3_tF, 3, k, array.get(mainL, k), text_color=f_t3_semTx(array.get(mainLs, k)),
                 bgcolor=f_t3_semBg(array.get(mainLs, k)), text_size=szU)
            table.cell(t3_tF, 4, k, array.get(mainR, k), text_color=f_t3_semTx(array.get(mainRs, k)),
                 bgcolor=f_t3_semBg(array.get(mainRs, k)), text_size=szU)
            table.cell(t3_tF, 5, k, array.get(sigVal, k), text_color=color.white, text_size=szU,
                 bgcolor=f_t3_sigCol(array.get(sigPol, k)), tooltip=k == 5 ? t3_orbTip : "")
        table.cell(t3_tF, 0, 6, array.get(mainL, 7), text_color=f_t3_semTx(array.get(mainLs, 7)),
             bgcolor=f_t3_semBg(array.get(mainLs, 7)), text_size=szU)
        table.cell(t3_tF, 2, 6, array.get(mainR, 7), text_color=f_t3_semTx(array.get(mainRs, 7)),
             bgcolor=f_t3_semBg(array.get(mainRs, 7)), text_size=szU)
        table.cell(t3_tF, 3, 6, array.get(mainL, 6), text_color=f_t3_semTx(array.get(mainLs, 6)),
             bgcolor=f_t3_semBg(array.get(mainLs, 6)), text_size=szU)
        table.cell(t3_tF, 4, 6, array.get(mainR, 6), text_color=f_t3_semTx(array.get(mainRs, 6)),
             bgcolor=f_t3_semBg(array.get(mainRs, 6)), text_size=szU)
        table.cell(t3_tF, 5, 6, array.get(sigVal, 6), text_color=color.white, text_size=szU,
             bgcolor=f_t3_sigCol(array.get(sigPol, 6)))
        table.cell(t3_tF, 0, 7, array.get(mainL, 8), text_color=f_t3_semTx(array.get(mainLs, 8)),
             bgcolor=f_t3_semBg(array.get(mainLs, 8)), text_size=szU)
        table.cell(t3_tF, 3, 7, array.get(mainR, 8), text_color=f_t3_semTx(array.get(mainRs, 8)),
             bgcolor=f_t3_semBg(array.get(mainRs, 8)), text_size=szU)

    // -- mode Groupé par couleur, relevé sur l'original (captures 8, 10 et 11) --
    // 3 camps de 2 colonnes, remplis ligne par ligne : bleu (et bleu clair) à
    // gauche, orange ET neutres au centre, rouge à droite. Hauteur = moitié du
    // plus grand camp, arrondie au-dessus, puis le Feu sur toute la largeur.
    // Ordre global conservé dans chaque camp :
    //   1. Dashator 1m..1D ; 2. bloc SuperTrader dans l'ordre du code Midgar
    //   (Trend, Bull, Bear, YoYo, Gap up, Gap down, Div, Cross, CCI, RSI, MACD,
    //   PA1, PA2, PA3, VIX, niveau VIX, Vol 1, Vol 2) ; 3. SIGNAL ; 4. unité par
    //   unité, TREND puis STRENGTH.
    // L'ancienne version n'avait qu'une colonne par camp et 10 lignes : elle
    // coupait des cellules et oubliait tout le bloc SuperTrader.
    if grp
        gT = array.new_string(0)
        gB = array.new_color(0)
        gC = array.new_color(0)
        gK = array.new_int(0)   // camp : 0 bleu, 1 centre, 2 rouge
        for k = 0 to 5
            b = array.get(ddB, k)
            array.push(gT, array.get(ddTx, k)), array.push(gB, b ? t3_cBull : t3_cBear), array.push(gC, color.white), array.push(gK, b ? 0 : 2)
        stT = array.concat(array.slice(mainL, 0, 7), array.slice(mainR, 0, 7))
        stS = array.concat(array.slice(mainLs, 0, 7), array.slice(mainRs, 0, 7))
        array.push(stT, array.get(mainL, 7)), array.push(stS, array.get(mainLs, 7))
        array.push(stT, array.get(mainR, 7)), array.push(stS, array.get(mainRs, 7))
        array.push(stT, array.get(mainL, 8)), array.push(stS, array.get(mainLs, 8))
        array.push(stT, array.get(mainR, 8)), array.push(stS, array.get(mainRs, 8))
        for k = 0 to array.size(stT) - 1
            sm = array.get(stS, k)
            array.push(gT, array.get(stT, k)), array.push(gB, f_t3_semBg(sm)), array.push(gC, f_t3_semTx(sm))
            array.push(gK, sm == "bull" or sm == "super" ? 0 : sm == "bear" ? 2 : 1)
        for k = 0 to 6
            pol = array.get(sigPol, k)
            array.push(gT, array.get(sigVal, k)), array.push(gB, f_t3_sigCol(pol)), array.push(gC, color.white)
            array.push(gK, pol == 1 ? 0 : pol == -1 ? 2 : 1)
        for k = 0 to 5
            tb = array.get(tfTr, k)
            array.push(gT, tb ? "BULLISH" : "BEARISH"), array.push(gB, tb ? t3_cBull : t3_cBear), array.push(gC, color.white), array.push(gK, tb ? 0 : 2)
            v = array.get(tfSt, k)
            array.push(gT, str.tostring(v) + "%"), array.push(gB, f_t3_stCol(v)), array.push(gC, color.white)
            array.push(gK, v >= 75 ? 0 : v == 50 ? 1 : 2)
        nCamp = array.from(0, 0, 0)
        for c in gK
            array.set(nCamp, c, array.get(nCamp, c) + 1)
        h = int(math.ceil(array.max(nCamp) / 2.0))
        // Le tableau est recréé à chaque mise à jour : sa hauteur dépend du
        // marché, et une fusion de cellules ne se défait pas autrement.
        table.delete(t3_tF)
        t3_tF := table.new(f_t3_pos(t3_posF), 6, h + 1, bgcolor=t3_cDark, border_width=1, border_color=t3_cBord)
        pos = array.from(0, 0, 0)
        for i = 0 to array.size(gT) - 1
            c = array.get(gK, i)
            gn = array.get(pos, c)
            table.cell(t3_tF, c * 2 + gn % 2, int(gn / 2), array.get(gT, i), text_color=array.get(gC, i),
                 bgcolor=array.get(gB, i), text_size=szU, tooltip=i == 29 ? t3_orbTip : "")
            array.set(pos, c, gn + 1)
        table.merge_cells(t3_tF, 0, h, 5, h)
        table.cell(t3_tF, 0, h, t3_feuTxt, text_color=color.white, text_size=szU, bgcolor=t3_feuCol,
             tooltip=str.tostring(t3_pLong, "0") + "% long / " + str.tostring(t3_pShort, "0") + "% short  (" + str.tostring(t3_nLong) + "L " + str.tostring(t3_nShort) + "S sur " + str.tostring(t3_nTot) + " voix)")

    // -- le badge du Feu, présent dans les 4 modes --
    // En « Normal », l'original n'affiche que le mot (LONG / SHORT / NEUTRE) sur
    // toute la largeur. Le détail des voix passe dans la bulle, pour pouvoir
    // toujours comparer nos parts aux siennes.
    detail = str.tostring(t3_pLong, "0") + "% long / " + str.tostring(t3_pShort, "0") + "% short  (" + str.tostring(t3_nLong) + "L " + str.tostring(t3_nShort) + "S sur " + str.tostring(t3_nTot) + " voix, seuil " + str.tostring(t3_seuil) + "%)"
    if fus
        table.cell(t3_tF, 0, 8, t3_feuTxt, text_color=color.white, text_size=szU, bgcolor=t3_feuCol, tooltip=detail)
    else if not grp
        table.cell(t3_tF, 0, 9, t3_feuTxt + "  " + detail, text_color=color.white, text_size=size.normal, bgcolor=t3_feuCol)

alertcondition(t3_pLong  >= t3_seuil, "Feu LONG",  "Feu de Confluence passe au vert long")
alertcondition(t3_pShort >= t3_seuil, "Feu SHORT", "Feu de Confluence passe au rouge short")

// ══════════════════════════════════════════════════════════════
// MONDAY HIGH LOW — module de l'original (ajouté le 15/10)
// ══════════════════════════════════════════════════════════════
// Réglages lus sur le panneau d'Ephore (12/10) : « Afficher Monday High Low »,
// « Couleur des lignes » = bleu, « Épaisseur » = 1, « Historique (semaines) » = 26.
// Le plus haut et le plus bas du lundi, tracés sur toute la semaine.
// 15/10 : sur l'API du terminal web, les lignes mhl_* correspondent 12/12 au
// lundi calendaire 00:00-24:00 UTC (2 copies, 15m et 2m), lignes prolongées
// jusqu'à la fin de la semaine. C'est donc le défaut. RÉSERVE : l'API cote un
// marché ouvert en continu ; sur un future, dont la journée commence le
// dimanche 18:00 New York, les définitions divergent (jusqu'à 302 points sur
// ces semaines). Les deux autres lectures restent en option, à trancher sur
// une capture TradingView.
grp_mhl  = "=== MONDAY HIGH LOW ==="
mhl_on   = input.bool(true, "Afficher Monday High Low", group=grp_mhl)
mhl_col  = input.color(color.blue, "Couleur des lignes", group=grp_mhl)
mhl_w    = input.int(1, "Épaisseur", group=grp_mhl, minval=1, maxval=5)
mhl_hist = input.int(26, "Historique (semaines)", group=grp_mhl, minval=1, maxval=52)
mhl_def  = input.string("Lundi calendaire (UTC)", "Définition du lundi", group=grp_mhl,
     options=["Lundi calendaire (UTC)", "Journée de trading (bougie journalière du lundi)", "Lundi calendaire (Paris)"],
     tooltip="UTC = la seule définition vérifiée (12/12 sur l'API d'Ephore). Pour un future, la journée de trading du lundi commence le dimanche à 18:00 New York. Paris = le lundi de 00:00 à 24:00, heure de Paris.")

mhl_isMon = mhl_def == "Lundi calendaire (UTC)" ? dayofweek(time, "UTC") == dayofweek.monday : mhl_def == "Lundi calendaire (Paris)" ? dayofweek(time, "Europe/Paris") == dayofweek.monday : dayofweek(time_tradingday, "UTC") == dayofweek.monday
mhl_new   = mhl_isMon and not mhl_isMon[1]
var float mhl_h = na
var float mhl_l = na
var line  mhl_lh = na
var line  mhl_ll = na
var array<line> mhl_lines = array.new_line()
if mhl_on and (timeframe.isintraday or timeframe.isdaily)
    if mhl_new
        mhl_h  := high
        mhl_l  := low
        mhl_lh := line.new(time, mhl_h, time + 7 * 86400000, mhl_h, xloc=xloc.bar_time, color=mhl_col, width=mhl_w)
        mhl_ll := line.new(time, mhl_l, time + 7 * 86400000, mhl_l, xloc=xloc.bar_time, color=mhl_col, width=mhl_w)
        array.push(mhl_lines, mhl_lh)
        array.push(mhl_lines, mhl_ll)
        while array.size(mhl_lines) > 2 * mhl_hist
            line.delete(array.shift(mhl_lines))
    else if mhl_isMon and not na(mhl_h)
        mhl_h := math.max(mhl_h, high)
        mhl_l := math.min(mhl_l, low)
        line.set_y1(mhl_lh, mhl_h)
        line.set_y2(mhl_lh, mhl_h)
        line.set_y1(mhl_ll, mhl_l)
        line.set_y2(mhl_ll, mhl_l)

// ══════════════════════════════════════════════════════════════
// SESSIONS : HIGH / LOW ASIE, LONDRES, US — module ajouté par Jeremy (15/10)
// ══════════════════════════════════════════════════════════════
// Pas dans l'original : rien à valider contre Ephore. Chaque session a son
// fuseau, donc les changements d'heure (Europe, US, Japon n'en ont pas) se
// règlent tout seuls. Horaires par défaut = heures d'ouverture des bourses
// au comptant : Tokyo 09:00-15:30, Londres 08:00-16:30, New York 09:30-16:00.
// Le plus haut et le plus bas se construisent en direct pendant la session,
// puis restent tracés jusqu'à la même session le lendemain (option).
grp_ses   = "=== SESSIONS : HIGH / LOW (Asie, Londres, US) ==="
ses_on    = input.bool(true, "Afficher les sessions", group=grp_ses)
ses_days  = input.int(3, "Nombre de jours affichés", group=grp_ses, minval=1, maxval=20)
ses_ext   = input.bool(true, "Prolonger jusqu'à la même session le lendemain", group=grp_ses,
     tooltip="Décoché : les lignes s'arrêtent à la fin de la session.")
ses_lbl   = input.bool(true, "Étiquettes (Asie H, Londres L…)", group=grp_ses)
ses_bg    = input.bool(false, "Fond coloré pendant la session", group=grp_ses)
ses_w     = input.int(1, "Épaisseur", group=grp_ses, minval=1, maxval=5)
ses_sty   = input.string("Tirets", "Style des lignes", group=grp_ses, options=["Plein", "Tirets", "Pointillés"])
ses_asOn  = input.bool(true, "Asie", group=grp_ses, inline="as")
ses_asSes = input.session("0900-1530", "", group=grp_ses, inline="as", tooltip="Heure de Tokyo")
ses_asCol = input.color(#AB47BC, "", group=grp_ses, inline="as")
ses_ldOn  = input.bool(true, "Londres", group=grp_ses, inline="ld")
ses_ldSes = input.session("0800-1630", "", group=grp_ses, inline="ld", tooltip="Heure de Londres")
ses_ldCol = input.color(#FF9800, "", group=grp_ses, inline="ld")
ses_usOn  = input.bool(true, "US", group=grp_ses, inline="us")
ses_usSes = input.session("0930-1600", "", group=grp_ses, inline="us", tooltip="Heure de New York")
ses_usCol = input.color(#26A69A, "", group=grp_ses, inline="us")

ses_style = ses_sty == "Plein" ? line.style_solid : ses_sty == "Pointillés" ? line.style_dotted : line.style_dashed

// Une session : chaque appel garde son propre état (les `var` d'une fonction
// sont propres à l'endroit où elle est appelée).
f_ses(_on, _sess, _tz, _col, _nom) =>
    inS = not na(time(timeframe.period, _sess, _tz))
    var float h = na
    var float l = na
    var int   t0 = na
    var line  lh = na
    var line  ll = na
    var label bh = na
    var label bl = na
    var array<line>  lns = array.new_line()
    var array<label> lbs = array.new_label()
    actif = _on and ses_on and timeframe.isintraday
    if actif and inS and not inS[1]
        h  := high
        l  := low
        t0 := time
        x2 = ses_ext ? time + 86400000 : time_close
        lh := line.new(time, h, x2, h, xloc=xloc.bar_time, color=_col, width=ses_w, style=ses_style)
        ll := line.new(time, l, x2, l, xloc=xloc.bar_time, color=_col, width=ses_w, style=ses_style)
        array.push(lns, lh)
        array.push(lns, ll)
        while array.size(lns) > 2 * ses_days
            line.delete(array.shift(lns))
        if ses_lbl
            bh := label.new(x2, h, _nom + " H", xloc=xloc.bar_time, style=label.style_label_left, color=color.new(_col, 100), textcolor=_col, size=size.small)
            bl := label.new(x2, l, _nom + " L", xloc=xloc.bar_time, style=label.style_label_left, color=color.new(_col, 100), textcolor=_col, size=size.small)
            array.push(lbs, bh)
            array.push(lbs, bl)
            while array.size(lbs) > 2 * ses_days
                label.delete(array.shift(lbs))
    else if actif and inS and not na(t0)
        h := math.max(h, high)
        l := math.min(l, low)
        line.set_y1(lh, h)
        line.set_y2(lh, h)
        line.set_y1(ll, l)
        line.set_y2(ll, l)
        if not ses_ext
            line.set_x2(lh, time_close)
            line.set_x2(ll, time_close)
        if ses_lbl
            label.set_y(bh, h)
            label.set_y(bl, l)
            if not ses_ext
                label.set_x(bh, time_close)
                label.set_x(bl, time_close)
    actif and inS

ses_inAs = f_ses(ses_asOn, ses_asSes, "Asia/Tokyo",       ses_asCol, "Asie")
ses_inLd = f_ses(ses_ldOn, ses_ldSes, "Europe/London",    ses_ldCol, "Londres")
ses_inUs = f_ses(ses_usOn, ses_usSes, "America/New_York", ses_usCol, "US")
bgcolor(ses_bg and ses_inAs ? color.new(ses_asCol, 92) : na, title="Fond session Asie")
bgcolor(ses_bg and ses_inLd ? color.new(ses_ldCol, 92) : na, title="Fond session Londres")
bgcolor(ses_bg and ses_inUs ? color.new(ses_usCol, 92) : na, title="Fond session US")

// ══════════════════════════════════════════════════════════════
// RONDATOR V1 — niveaux ronds (module de l'original, ajouté le 15/10)
// ══════════════════════════════════════════════════════════════
// Réglages lus sur le panneau d'Ephore (capture du 15/10) : intervalle 100
// (Réglage 28), 10 niveaux de part et d'autre (Réglage 29), épaisseur 1,
// style solide, labels de prix décochés, position gauche, décalage 150
// barres, taille small. Couleur : damier = couleur transparente chez Ephore.
// Règle vérifiée sur l'API du terminal web (objets rnl_*) : le centre est
// l'arrondi INFÉRIEUR à l'intervalle du dernier cours, puis ±10 niveaux.
// Réserve : sur l'API, les niveaux n'apparaissent qu'en 2m, jamais en 15m.
// On les affiche sur toutes les unités ; une capture tranchera.
grp_rnd    = "=== EPHORE RONDATOR V1 ==="
rnd_on     = input.bool(true, "Activer Niveaux Ronds", group=grp_rnd)
rnd_custom = input.bool(true, "Personnaliser Couleurs", group=grp_rnd)
rnd_step   = input.float(100, "Intervalle entre les niveaux", group=grp_rnd, minval=0.25)
rnd_n      = input.int(10, "Nombre de niveaux au-dessus/en dessous", group=grp_rnd, minval=1, maxval=50)
rnd_colIn  = input.color(color.new(color.gray, 70), "Couleur des lignes", group=grp_rnd)
rnd_w      = input.int(1, "Épaisseur des lignes", group=grp_rnd, minval=1, maxval=5)
rnd_sty    = input.string("Solide", "Style des lignes", group=grp_rnd, options=["Solide", "Tirets", "Pointillés"])
rnd_lbl    = input.bool(false, "Afficher les labels de prix", group=grp_rnd)
rnd_pos    = input.string("Gauche", "Position des labels", group=grp_rnd, options=["Gauche", "Droite"])
rnd_off    = input.int(150, "Décalage des labels (barres)", group=grp_rnd, minval=0, maxval=490)
rnd_lsz    = input.string("small", "Taille des labels", group=grp_rnd, options=["tiny", "small", "normal", "large"])

rnd_col   = rnd_custom ? rnd_colIn : color.new(color.gray, 70)
rnd_style = rnd_sty == "Tirets" ? line.style_dashed : rnd_sty == "Pointillés" ? line.style_dotted : line.style_solid
rnd_size  = rnd_lsz == "tiny" ? size.tiny : rnd_lsz == "normal" ? size.normal : rnd_lsz == "large" ? size.large : size.small

var array<line>  rnd_lines  = array.new_line()
var array<label> rnd_labels = array.new_label()
var float rnd_center = na
if barstate.islast and rnd_on
    rnd_c = math.floor(close / rnd_step) * rnd_step
    rnd_x = rnd_pos == "Gauche" ? bar_index - rnd_off : bar_index + rnd_off
    // On ne redessine que quand le prix change de tranche.
    if rnd_c != rnd_center
        while array.size(rnd_lines) > 0
            line.delete(array.pop(rnd_lines))
        while array.size(rnd_labels) > 0
            label.delete(array.pop(rnd_labels))
        for k = -rnd_n to rnd_n
            lvl = rnd_c + k * rnd_step
            array.push(rnd_lines, line.new(bar_index - 1, lvl, bar_index, lvl, extend=extend.both, color=rnd_col, width=rnd_w, style=rnd_style))
            if rnd_lbl
                array.push(rnd_labels, label.new(rnd_x, lvl, str.tostring(lvl, format.mintick), style=label.style_none, textcolor=color.new(rnd_col, 0), size=rnd_size))
        rnd_center := rnd_c
    else if rnd_lbl
        for lb in rnd_labels
            label.set_x(lb, rnd_x)
