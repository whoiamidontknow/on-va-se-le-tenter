//@version=6
// ════════════════════════════════════════════════════════════
// EPHORE TL FIGÉE — test de l'hypothèse "ligne figée après cassure"
// ════════════════════════════════════════════════════════════
// Même règle que la résistance de PORSCHEONARRIVE :
//   ancre = pivot haut le plus élevé de la fenêtre,
//   pente = la moins négative parmi les pivots suivants.
// Différence testée : dès qu'une clôture passe au-dessus de la droite,
// la droite est FIGÉE. Un pivot qui la traverse ensuite ne la redessine
// plus. Elle est remplacée dès que l'ancre change : nouveau sommet plus
// haut, ou ancre sortie de la fenêtre.
//
// À superposer à la référence : droite figée en blanc, droite
// recalculée à chaque bougie (règle actuelle) en gris pointillé.
indicator("Ephore TL Figee", overlay=true, max_lines_count=50, max_labels_count=50)

grp = "=== TL FIGÉE ==="
fz_on       = input.bool(true,   "Figer la droite après cassure", group=grp)
piv_len     = input.int(10,      "Force des pivots (barres de chaque côté)", group=grp, minval=2, maxval=50)
lb_lo       = input.int(250,     "Fenêtre ancre, TF < 30 min",  group=grp, minval=10, maxval=3000)
lb_hi       = input.int(150,     "Fenêtre ancre, TF ≥ 30 min", group=grp, minval=10, maxval=3000)
ext_bars    = input.int(50,      "Prolongement à droite (barres)", group=grp, minval=0, maxval=490)
fz_col      = input.color(#FFFFFF, "Couleur droite figée", group=grp, inline="c1")
fz_w        = input.int(2,       "Épaisseur", group=grp, minval=1, maxval=5, inline="c1")
show_dyn    = input.bool(true,   "Afficher la règle actuelle (comparaison)", group=grp, inline="c2")
dyn_col     = input.color(#FF9800, "", group=grp, inline="c2")
show_dbg    = input.bool(true,   "Marquer les gels (croix orange) + état", group=grp)

look = timeframe.in_seconds(timeframe.period) < 30 * 60 ? lb_lo : lb_hi

// ── Pivots hauts (plafond 200 : ne pas tronquer la fenêtre en silence) ──
ph = ta.pivothigh(high, piv_len, piv_len)

var float[] ph_price = array.new_float(0)
var int[]   ph_bar   = array.new_int(0)

if not na(ph)
    array.unshift(ph_price, ph)
    array.unshift(ph_bar,   bar_index - piv_len)
    if array.size(ph_price) > 200
        array.pop(ph_price)
        array.pop(ph_bar)

// ── Fonctions ──
f_val(x1, y1, slope, x) =>
    y1 + slope * (x - x1)

// Candidate : [x1, y1, pente], na si pas de pivot après l'ancre
f_resist(lk) =>
    int   a_i  = -1
    float a_px = na
    n = array.size(ph_price)
    if n > 0
        for i = 0 to n - 1
            if bar_index - array.get(ph_bar, i) <= lk
                pv = array.get(ph_price, i)
                if na(a_px) or pv > a_px
                    a_px := pv
                    a_i  := i
    float r_x1 = na
    float r_sl = na
    // Tableaux du plus récent au plus ancien : les pivots après l'ancre sont aux indices < a_i
    if a_i > 0
        a_bar = array.get(ph_bar, a_i)
        for i = 0 to a_i - 1
            sl = (array.get(ph_price, i) - a_px) / (array.get(ph_bar, i) - a_bar)
            if na(r_sl) or sl > r_sl
                r_sl := sl
        r_x1 := float(a_bar)
    [r_x1, a_px, r_sl]

[c_x1, c_y1, c_sl] = f_resist(look)
cand_ok = not na(c_x1) and not na(c_sl)

// ── Machine à états : active → figée → (nouvelle ancre) active ──
var float fz_x1     = na
var float fz_y1     = na
var float fz_sl     = na
var bool  fz_broken = false
bool broke_now = false

if not fz_on
    fz_x1 := cand_ok ? c_x1 : na
    fz_y1 := cand_ok ? c_y1 : na
    fz_sl := cand_ok ? c_sl : na
    fz_broken := false
else
    if fz_broken
        // L'ancre a changé (sommet plus haut ou ancienne ancre hors fenêtre) :
        // sans ça, la droite restait collée à un vieux sommet, hors écran.
        if cand_ok and c_x1 != fz_x1
            fz_x1 := c_x1
            fz_y1 := c_y1
            fz_sl := c_sl
            fz_broken := false
    else if cand_ok
        // Tant qu'elle n'est pas cassée, la droite suit la règle actuelle.
        // Si la candidate disparaît (ancre = dernier pivot), on garde la précédente.
        fz_x1 := c_x1
        fz_y1 := c_y1
        fz_sl := c_sl

    if not fz_broken and not na(fz_x1)
        if close > f_val(fz_x1, fz_y1, fz_sl, bar_index)
            fz_broken := true
            broke_now := true

plotshape(show_dbg and broke_now, "Gel", style=shape.xcross,
     location=location.abovebar, color=color.orange, size=size.tiny)

// ── Dessin ──
var line  ln_fz  = na
var line  ln_dyn = na
var label lb_st  = na

if barstate.islast
    line.delete(ln_fz)
    line.delete(ln_dyn)
    label.delete(lb_st)
    ex = bar_index + ext_bars

    if not na(fz_x1)
        ln_fz := line.new(int(fz_x1), fz_y1, ex, f_val(fz_x1, fz_y1, fz_sl, ex),
             xloc=xloc.bar_index, color=fz_col, width=fz_w, style=line.style_solid)
        if show_dbg
            lb_st := label.new(ex, f_val(fz_x1, fz_y1, fz_sl, ex),
                 (fz_broken ? "FIGÉE" : "ACTIVE") + "  ancre " + str.tostring(fz_y1, format.mintick),
                 xloc=xloc.bar_index, style=label.style_label_left,
                 color=color.new(color.black, 100), textcolor=fz_col, size=size.small)

    if show_dyn and cand_ok
        ln_dyn := line.new(int(c_x1), c_y1, ex, f_val(c_x1, c_y1, c_sl, ex),
             xloc=xloc.bar_index, color=dyn_col, width=1, style=line.style_dotted)

// ══════════════════════════════════════════════════════════════
// SUPPORT ASCENDANT — miroir exact de la résistance
//   ancre = pivot bas le plus bas de la fenêtre,
//   pente = la moins positive parmi les pivots suivants (tous au-dessus),
//   figée à la première clôture SOUS la droite, libérée quand l'ancre change.
// ══════════════════════════════════════════════════════════════
grp_sp  = "=== SUPPORT ASCENDANT ==="
sp_on   = input.bool(true,     "Activer le support ascendant", group=grp_sp)
sp_col  = input.color(#000000, "Couleur support figé", group=grp_sp, inline="s1")
sp_w    = input.int(2,         "Épaisseur", group=grp_sp, minval=1, maxval=5, inline="s1")

pl = ta.pivotlow(low, piv_len, piv_len)

var float[] pl_price = array.new_float(0)
var int[]   pl_bar   = array.new_int(0)

if not na(pl)
    array.unshift(pl_price, pl)
    array.unshift(pl_bar,   bar_index - piv_len)
    if array.size(pl_price) > 200
        array.pop(pl_price)
        array.pop(pl_bar)

f_support(lk) =>
    int   a_i  = -1
    float a_px = na
    n = array.size(pl_price)
    if n > 0
        for i = 0 to n - 1
            if bar_index - array.get(pl_bar, i) <= lk
                pv = array.get(pl_price, i)
                if na(a_px) or pv < a_px
                    a_px := pv
                    a_i  := i
    float r_x1 = na
    float r_sl = na
    if a_i > 0
        a_bar = array.get(pl_bar, a_i)
        for i = 0 to a_i - 1
            sl = (array.get(pl_price, i) - a_px) / (array.get(pl_bar, i) - a_bar)
            if na(r_sl) or sl < r_sl
                r_sl := sl
        r_x1 := float(a_bar)
    [r_x1, a_px, r_sl]

[s_x1, s_y1, s_sl] = f_support(look)
s_ok = sp_on and not na(s_x1) and not na(s_sl)

var float sp_x1     = na
var float sp_y1     = na
var float sp_sl     = na
var bool  sp_broken = false
bool sp_broke_now = false

if not sp_on
    sp_x1 := na
    sp_broken := false
else if not fz_on
    sp_x1 := s_ok ? s_x1 : na
    sp_y1 := s_ok ? s_y1 : na
    sp_sl := s_ok ? s_sl : na
    sp_broken := false
else
    if sp_broken
        if s_ok and s_x1 != sp_x1
            sp_x1 := s_x1
            sp_y1 := s_y1
            sp_sl := s_sl
            sp_broken := false
    else if s_ok
        sp_x1 := s_x1
        sp_y1 := s_y1
        sp_sl := s_sl

    if not sp_broken and not na(sp_x1)
        if close < f_val(sp_x1, sp_y1, sp_sl, bar_index)
            sp_broken := true
            sp_broke_now := true

plotshape(show_dbg and sp_broke_now, "Gel support", style=shape.xcross,
     location=location.belowbar, color=color.orange, size=size.tiny)

var line  ln_sp     = na
var line  ln_sp_dyn = na
var label lb_sp     = na

if barstate.islast
    line.delete(ln_sp)
    line.delete(ln_sp_dyn)
    label.delete(lb_sp)
    sex = bar_index + ext_bars

    if not na(sp_x1)
        ln_sp := line.new(int(sp_x1), sp_y1, sex, f_val(sp_x1, sp_y1, sp_sl, sex),
             xloc=xloc.bar_index, color=sp_col, width=sp_w, style=line.style_solid)
        if show_dbg
            lb_sp := label.new(sex, f_val(sp_x1, sp_y1, sp_sl, sex),
                 (sp_broken ? "FIGÉ" : "ACTIF") + "  ancre " + str.tostring(sp_y1, format.mintick),
                 xloc=xloc.bar_index, style=label.style_label_left,
                 color=color.new(color.black, 100), textcolor=sp_col, size=size.small)

    if show_dyn and s_ok
        ln_sp_dyn := line.new(int(s_x1), s_y1, sex, f_val(s_x1, s_y1, s_sl, sex),
             xloc=xloc.bar_index, color=dyn_col, width=1, style=line.style_dotted)

// ── Diagnostic : dit pourquoi une droite est absente ──
var table dbg = table.new(position.top_left, 2, 8, bgcolor=color.new(color.black, 20),
     border_width=1, border_color=color.gray)

f_row(r, k, v) =>
    table.cell(dbg, 0, r, k, text_color=color.silver, text_size=size.small)
    table.cell(dbg, 1, r, v, text_color=color.white,  text_size=size.small)

if barstate.islast and show_dbg
    n_win = 0
    if array.size(ph_bar) > 0
        for i = 0 to array.size(ph_bar) - 1
            if bar_index - array.get(ph_bar, i) <= look
                n_win += 1
    f_row(0, "Fenêtre", str.tostring(look) + " barres")
    f_row(1, "Pivots en mémoire", str.tostring(array.size(ph_bar)))
    f_row(2, "Pivots dans fenêtre", str.tostring(n_win))
    f_row(3, "Candidate", cand_ok ? "OK" : "aucune (ancre = dernier pivot ?)")
    f_row(4, "Résistance", na(fz_x1) ? "AUCUNE" : fz_broken ? "FIGÉE" : "ACTIVE")
    f_row(5, "Ancre", na(fz_x1) ? "—" : str.tostring(fz_y1, format.mintick) + " (il y a " + str.tostring(bar_index - int(fz_x1)) + " barres)")
    f_row(6, "Support", na(sp_x1) ? "AUCUN" : sp_broken ? "FIGÉ" : "ACTIF")
    f_row(7, "Ancre support", na(sp_x1) ? "—" : str.tostring(sp_y1, format.mintick) + " (il y a " + str.tostring(bar_index - int(sp_x1)) + " barres)")
