//@version=6
// ═══════════════════════════════════════════════════════════════════
// FIBONACCI AUTO — Ephore (reverse-engineering Fibonator v4)
// Détecte le dernier swing (high/low) et trace les niveaux Fib
// Tendance baissière : 0 = swing high (ancien), 1 = swing low (récent)
// Tendance haussière : 0 = swing low (ancien),  1 = swing high (récent)
// ═══════════════════════════════════════════════════════════════════
indicator("Fibonacci Auto - Ephore", overlay=true,
     max_lines_count=50, max_labels_count=50, max_bars_back=500)

// ── INPUTS ───────────────────────────────────────────────────────
grp_gen  = "AUTO-FIBONACCI"
activate = input.bool(true,  "Activer Auto-Fibonacci",          group=grp_gen)
piv_len  = input.int(10,     "Longueur Pivot (Sensibilité)",    minval=2, maxval=50, group=grp_gen)
extend_r = input.bool(false, "Étendre les lignes à droite",     group=grp_gen)
show_lbl = input.bool(true,  "Afficher les labels",             group=grp_gen)
show_prc = input.bool(false, "Afficher les prix",               group=grp_gen)
show_str = input.bool(false, "★ Afficher l'étoile sur niveau optimal", group=grp_gen)
ln_width = input.int(1,      "Épaisseur des lignes",            minval=1, maxval=4, group=grp_gen)
lbl_size = input.string("small", "Taille des labels", options=["tiny","small","normal","large"], group=grp_gen)

grp_lvl  = "--- NIVEAUX FIBONACCI ---"
show_000 = input.bool(false, "0% (Swing Low/High)",  inline="000", group=grp_lvl)
col_000  = input.color(#B0B0B0, "",                  inline="000", group=grp_lvl)
show_236 = input.bool(false, "23.6%",                inline="236", group=grp_lvl)
col_236  = input.color(#B0B0B0, "",                  inline="236", group=grp_lvl)
show_382 = input.bool(false, "38.2%",                inline="382", group=grp_lvl)
col_382  = input.color(#7CB342, "",                  inline="382", group=grp_lvl)
show_500 = input.bool(false, "50%",                  inline="500", group=grp_lvl)
col_500  = input.color(#FFC107, "",                  inline="500", group=grp_lvl)
show_618 = input.bool(true,  "61.8% (Golden Ratio)", inline="618", group=grp_lvl)
col_618  = input.color(#FF6F00, "",                  inline="618", group=grp_lvl)
show_750 = input.bool(false, "75% OPTIMAL",          inline="750", group=grp_lvl)
col_750  = input.color(#505050, "",                  inline="750", group=grp_lvl)
show_786 = input.bool(false, "78.6%",                inline="786", group=grp_lvl)
col_786  = input.color(#9C27B0, "",                  inline="786", group=grp_lvl)
show_100 = input.bool(false, "100% (Swing High/Low)",inline="100", group=grp_lvl)
col_100  = input.color(#B0B0B0, "",                  inline="100", group=grp_lvl)

grp_ext  = "--- EXTENSIONS FIBONACCI ---"
show_ext  = input.bool(false, "Afficher Extensions",     group=grp_ext)
show_1272 = input.bool(true,  "127.2%",      inline="1272", group=grp_ext)
col_1272  = input.color(#9C27B0, "",         inline="1272", group=grp_ext)
show_1618 = input.bool(true,  "161.8%",      inline="1618", group=grp_ext)
col_1618  = input.color(#E91E63, "",         inline="1618", group=grp_ext)

grp_zone = "--- ZONE OPTIMALE ---"
show_zone = input.bool(false, "Afficher Zone Optimale (0.618-0.75)", group=grp_zone)
col_zone  = input.color(color.new(#FFC107, 80), "Couleur de la zone", group=grp_zone)

// ── DÉTECTION DU SWING ────────────────────────────────────────────
// On cherche le dernier pivot high et le dernier pivot low confirmés
ph = ta.pivothigh(high, piv_len, piv_len)
pl = ta.pivotlow (low,  piv_len, piv_len)

var float last_ph_price = na
var int   last_ph_bar   = na
var float last_pl_price = na
var int   last_pl_bar   = na

if not na(ph)
    last_ph_price := ph
    last_ph_bar   := bar_index - piv_len
if not na(pl)
    last_pl_price := pl
    last_pl_bar   := bar_index - piv_len

// Sens : le pivot le plus récent (en bar_index) définit la fin du mouvement
// Baissier : pivot_low plus récent que pivot_high  → 0=ph (haut ancien), 1=pl (bas récent)
// Haussier : pivot_high plus récent que pivot_low → 0=pl (bas ancien), 1=ph (haut récent)
valid = not na(last_ph_bar) and not na(last_pl_bar)
bearish = valid and last_pl_bar > last_ph_bar

float p0    = na
float p100  = na
int   bar0  = na
int   bar100= na
if valid
    if bearish
        p0    := last_ph_price
        p100  := last_pl_price
        bar0  := last_ph_bar
        bar100:= last_pl_bar
    else
        p0    := last_pl_price
        p100  := last_ph_price
        bar0  := last_pl_bar
        bar100:= last_ph_bar

// ── DESSIN ────────────────────────────────────────────────────────
f_lvl(p_0, p_1, r) => p_0 + (p_1 - p_0) * r

f_size(s) =>
    s == "tiny"   ? size.tiny   :
     s == "small"  ? size.small  :
     s == "normal" ? size.normal : size.large

var line[]  lns = array.new<line>()
var label[] lbs = array.new<label>()
var linefill[] lfs = array.new<linefill>()

clear_all() =>
    while array.size(lns) > 0
        line.delete(array.pop(lns))
    while array.size(lbs) > 0
        label.delete(array.pop(lbs))
    while array.size(lfs) > 0
        linefill.delete(array.pop(lfs))

f_fmt_price(p) =>
    // format français : virgule décimale, espace milliers
    s = str.tostring(p, format.mintick)
    str.replace_all(s, ".", ",")

f_fmt_ratio(r) =>
    // 0,xxx
    s = str.tostring(r, "0.###")
    str.replace_all(s, ".", ",")

draw_level(p_0, p_1, ratio, col, b0, is_star) =>
    price = f_lvl(p_0, p_1, ratio)
    xr = extend_r ? extend.right : extend.none
    ln = line.new(b0, price, bar_index, price,
         color = col, width = ln_width,
         style = line.style_solid, extend = xr)
    array.push(lns, ln)
    if show_lbl
        txt = f_fmt_ratio(ratio) + (show_prc ? " (" + f_fmt_price(price) + ")" : "")
        if is_star and show_str
            txt := "★ " + txt
        lb = label.new(b0, price, txt,
             color     = color.new(color.white, 100),
             textcolor = col,
             style     = label.style_label_right,
             size      = f_size(lbl_size),
             xloc      = xloc.bar_index)
        array.push(lbs, lb)

draw_fibs(p_0, p_1, b0) =>
    clear_all()
    if show_000
        draw_level(p_0, p_1, 0.000, col_000, b0, false)
    if show_236
        draw_level(p_0, p_1, 0.236, col_236, b0, false)
    if show_382
        draw_level(p_0, p_1, 0.382, col_382, b0, false)
    if show_500
        draw_level(p_0, p_1, 0.500, col_500, b0, false)
    if show_618
        draw_level(p_0, p_1, 0.618, col_618, b0, true)
    if show_750
        draw_level(p_0, p_1, 0.750, col_750, b0, false)
    if show_786
        draw_level(p_0, p_1, 0.786, col_786, b0, false)
    if show_100
        draw_level(p_0, p_1, 1.000, col_100, b0, false)
    if show_ext and show_1272
        draw_level(p_0, p_1, 1.272, col_1272, b0, false)
    if show_ext and show_1618
        draw_level(p_0, p_1, 1.618, col_1618, b0, false)
    if show_zone
        pa = f_lvl(p_0, p_1, 0.618)
        pb = f_lvl(p_0, p_1, 0.750)
        xr = extend_r ? extend.right : extend.none
        la = line.new(b0, pa, bar_index, pa, color=color.new(col_zone,100), extend=xr)
        lb = line.new(b0, pb, bar_index, pb, color=color.new(col_zone,100), extend=xr)
        array.push(lns, la)
        array.push(lns, lb)
        lf = linefill.new(la, lb, col_zone)
        array.push(lfs, lf)

// ── EXÉCUTION SUR DERNIÈRE BARRE ─────────────────────────────────
if barstate.islast and activate and valid
    draw_fibs(p0, p100, bar0)
