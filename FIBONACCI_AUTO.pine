//@version=6
// ═══════════════════════════════════════════════════════════════════
// FIBONACCI AUTO — Ephore
// Logique tendance baissière :
//   0%   = 2ème pivot haut valide (hors spike/news)
//   100% = plus bas HA_close du lookback
//   0.618 = zone de pression clé sur rebond
// ═══════════════════════════════════════════════════════════════════
indicator("Fibonacci Auto - Ephore", overlay=true,
     max_lines_count=200, max_labels_count=100, max_bars_back=500)

// ── INPUTS ───────────────────────────────────────────────────────
grp_gen   = "Paramètres"
sel_tf    = input.string("15m", "Timeframe", options=["15m", "1H", "4H"], group=grp_gen)
lookback  = input.int(200,  "Lookback (bougies)", minval=50, maxval=500, group=grp_gen)
pivot_len = input.int(5,    "Pivot longueur",     minval=2,  maxval=20,  group=grp_gen)
spike_fac = input.float(2.0,"Filtre spike (× ATR14)", minval=0.5, maxval=6.0, step=0.5, group=grp_gen,
     tooltip="Mèche haute > N × ATR → considéré spike/news → ignoré")

// ── COULEURS ──────────────────────────────────────────────────────
col_618 = color.new(#FFD700, 0)
col_line = color.black

var float[] LEVELS = array.from(0.0, 0.236, 0.382, 0.5, 0.618, 0.786, 1.0)

// ── DONNÉES MTF ───────────────────────────────────────────────────
f_sec(tf, expr) => request.security(syminfo.tickerid, tf, expr, lookahead=barmerge.lookahead_off)

tf_str = sel_tf == "15m" ? "15" : sel_tf == "1H" ? "60" : "240"

hi   = f_sec(tf_str, high)
lo   = f_sec(tf_str, low)
op   = f_sec(tf_str, open)
cl   = f_sec(tf_str, close)
atr  = f_sec(tf_str, ta.atr(14))
ph   = f_sec(tf_str, ta.pivothigh(high, pivot_len, pivot_len))

ha_c = (op + hi + lo + cl) / 4

// ── FONCTIONS ────────────────────────────────────────────────────
fib_lvl(top, bot, ratio) =>
    bot + (top - bot) * ratio   // 0 = bas (lowest HA close), 1 = haut (pivot high)

clear_all(ln_arr, lb_arr) =>
    while array.size(ln_arr) > 0
        line.delete(array.pop(ln_arr))
    while array.size(lb_arr) > 0
        label.delete(array.pop(lb_arr))

find_range(h_src, o_src, c_src, ha_c_src, atr_src, ph_src, lb) =>
    bot   = ta.lowest(ha_c_src, lb)
    top   = float(na)
    count = 0
    for i = 1 to lb
        pv = ph_src[i]
        if not na(pv)
            wick  = h_src[i] - math.max(o_src[i], c_src[i])
            spike = wick > spike_fac * nz(atr_src[i], atr_src)
            if not spike
                count += 1
                if count == 2
                    top := pv
                    break
    valid = not na(top) and not na(bot) and top > bot
    [valid ? top : float(na), valid ? bot : float(na)]

draw_fibs(ln_arr, lb_arr, top, bot) =>
    clear_all(ln_arr, lb_arr)
    if not na(top) and not na(bot)
        for i = 0 to array.size(LEVELS) - 1
            r      = array.get(LEVELS, i)
            price  = fib_lvl(top, bot, r)
            is_618 = r == 0.618
            is_end = r == 0.0 or r == 1.0
            ln = line.new(bar_index - 300, price, bar_index + 60, price,
                 color  = is_618 ? col_618 : col_line,
                 width  = is_618 or is_end ? 2 : 1,
                 style  = is_618 or is_end ? line.style_solid : line.style_dashed,
                 extend = extend.right)
            array.push(ln_arr, ln)
            lbl = label.new(bar_index - 295, price,
                 str.tostring(r, "0.###") + " (" + str.tostring(price, format.mintick) + ")",
                 color     = color.new(color.white, 100),
                 textcolor = is_618 ? col_618 : col_line,
                 style     = label.style_label_right,
                 size      = size.tiny)
            array.push(lb_arr, lbl)

// ── STOCKAGE ─────────────────────────────────────────────────────
var line[]  ln_arr = array.new<line>()
var label[] lb_arr = array.new<label>()
var float   t_prev = na
var float   b_prev = na

// ── CALCUL ───────────────────────────────────────────────────────
[new_top, new_bot] = find_range(hi, op, cl, ha_c, atr, ph, lookback)

// ── DESSIN SUR DERNIÈRE BARRE ─────────────────────────────────────
if barstate.islast
    if na(t_prev) or new_top != t_prev or new_bot != b_prev
        draw_fibs(ln_arr, lb_arr, new_top, new_bot)
        t_prev := new_top
        b_prev := new_bot
