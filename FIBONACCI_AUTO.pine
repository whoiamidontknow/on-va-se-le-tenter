//@version=6
indicator("Fibonacci Auto - Ephore MTF", overlay=true, max_lines_count=500, max_labels_count=200)

// ═══════════════════════════════════════════════════════════════════
//  INPUTS
// ═══════════════════════════════════════════════════════════════════
grp_gen   = "Paramètres généraux"
lookback  = input.int(100,   "Lookback (bougies)",      minval=20, maxval=500, group=grp_gen)
spike_fac = input.float(2.5, "Filtre spike (× ATR14)",  minval=1.0, maxval=6.0, step=0.5, group=grp_gen)
near_pct  = input.float(0.5, "Zone 0.618 (±%)",         minval=0.1, maxval=3.0, step=0.1, group=grp_gen)

grp_tf  = "Timeframes"
show_15 = input.bool(true, "Afficher 15m", group=grp_tf, inline="tf")
show_1h = input.bool(true, "Afficher 1H",  group=grp_tf, inline="tf")
show_4h = input.bool(true, "Afficher 4H",  group=grp_tf, inline="tf")

// ═══════════════════════════════════════════════════════════════════
//  COULEURS
// ═══════════════════════════════════════════════════════════════════
col_15  = color.new(#64B5F6, 0)
col_1h  = color.new(#FF9800, 0)
col_4h  = color.new(#F44336, 0)
col_618 = color.new(#FFD700, 0)

var float[] FIB = array.from(0.0, 0.236, 0.382, 0.5, 0.618, 0.786, 1.0)

// ═══════════════════════════════════════════════════════════════════
//  DONNÉES MTF
// ═══════════════════════════════════════════════════════════════════
h15  = request.security(syminfo.tickerid, "15",  high,                     lookahead=barmerge.lookahead_off)
o15  = request.security(syminfo.tickerid, "15",  open,                     lookahead=barmerge.lookahead_off)
c15  = request.security(syminfo.tickerid, "15",  close,                    lookahead=barmerge.lookahead_off)
a15  = request.security(syminfo.tickerid, "15",  ta.atr(14),               lookahead=barmerge.lookahead_off)
ph15 = request.security(syminfo.tickerid, "15",  ta.pivothigh(high, 5, 5), lookahead=barmerge.lookahead_off)

h1h  = request.security(syminfo.tickerid, "60",  high,                     lookahead=barmerge.lookahead_off)
o1h  = request.security(syminfo.tickerid, "60",  open,                     lookahead=barmerge.lookahead_off)
c1h  = request.security(syminfo.tickerid, "60",  close,                    lookahead=barmerge.lookahead_off)
a1h  = request.security(syminfo.tickerid, "60",  ta.atr(14),               lookahead=barmerge.lookahead_off)
ph1h = request.security(syminfo.tickerid, "60",  ta.pivothigh(high, 5, 5), lookahead=barmerge.lookahead_off)

h4h  = request.security(syminfo.tickerid, "240", high,                     lookahead=barmerge.lookahead_off)
o4h  = request.security(syminfo.tickerid, "240", open,                     lookahead=barmerge.lookahead_off)
c4h  = request.security(syminfo.tickerid, "240", close,                    lookahead=barmerge.lookahead_off)
a4h  = request.security(syminfo.tickerid, "240", ta.atr(14),               lookahead=barmerge.lookahead_off)
ph4h = request.security(syminfo.tickerid, "240", ta.pivothigh(high, 5, 5), lookahead=barmerge.lookahead_off)

// ═══════════════════════════════════════════════════════════════════
//  FONCTIONS
// ═══════════════════════════════════════════════════════════════════
fib_price(level0, level1, ratio) =>
    level0 + (level1 - level0) * ratio

// Supprime lignes ET labels — évite l'accumulation à chaque update
clear_drawings(lines_arr, labels_arr) =>
    while array.size(lines_arr) > 0
        line.delete(array.pop(lines_arr))
    while array.size(labels_arr) > 0
        label.delete(array.pop(labels_arr))

calc_fib_points(h_src, o_src, c_src, atr_src, ph_src, lb) =>
    lowest_close = ta.lowest(c_src, lb)
    swing2 = float(na)
    count  = 0
    for i = 1 to lb
        ph_val = ph_src[i]
        if not na(ph_val)
            upper_wick = h_src[i] - math.max(o_src[i], c_src[i])
            is_spike   = upper_wick > spike_fac * atr_src[i]
            if not is_spike
                count += 1
                if count == 2
                    swing2 := ph_val
                    break
    valid  = not na(swing2) and not na(lowest_close) and swing2 > lowest_close
    level0 = valid ? swing2       : na
    level1 = valid ? lowest_close : na
    [level0, level1]

draw_fib(lines_arr, labels_arr, level0, level1, col, suffix) =>
    clear_drawings(lines_arr, labels_arr)
    if not na(level0) and not na(level1)
        for i = 0 to array.size(FIB) - 1
            ratio  = array.get(FIB, i)
            price  = fib_price(level0, level1, ratio)
            is_618 = ratio == 0.618
            ln = line.new(bar_index - 200, price, bar_index + 50, price,
                          color  = is_618 ? col_618 : col,
                          width  = is_618 ? 2 : 1,
                          style  = is_618 ? line.style_solid : line.style_dashed,
                          extend = line.extend_right)
            array.push(lines_arr, ln)
            lbl = label.new(bar_index + 52, price,
                            str.tostring(ratio * 100, "0.0") + "% " + suffix,
                            color     = color.new(col, 80),
                            textcolor = is_618 ? col_618 : col,
                            style     = label.style_label_left,
                            size      = size.tiny)
            array.push(labels_arr, lbl)

// ═══════════════════════════════════════════════════════════════════
//  STOCKAGE
// ═══════════════════════════════════════════════════════════════════
var line[]  lines_15  = array.new<line>()
var line[]  lines_1h  = array.new<line>()
var line[]  lines_4h  = array.new<line>()
var label[] labels_15 = array.new<label>()
var label[] labels_1h = array.new<label>()
var label[] labels_4h = array.new<label>()

var float prev_l0_15 = na
var float prev_l1_15 = na
var float prev_l0_1h = na
var float prev_l1_1h = na
var float prev_l0_4h = na
var float prev_l1_4h = na

// ═══════════════════════════════════════════════════════════════════
//  EXÉCUTION
// ═══════════════════════════════════════════════════════════════════
if barstate.islast
    if show_15
        [l0_15, l1_15] = calc_fib_points(h15, o15, c15, a15, ph15, lookback)
        if l0_15 != prev_l0_15 or l1_15 != prev_l1_15
            draw_fib(lines_15, labels_15, l0_15, l1_15, col_15, "15m")
            prev_l0_15 := l0_15
            prev_l1_15 := l1_15

    if show_1h
        [l0_1h, l1_1h] = calc_fib_points(h1h, o1h, c1h, a1h, ph1h, lookback)
        if l0_1h != prev_l0_1h or l1_1h != prev_l1_1h
            draw_fib(lines_1h, labels_1h, l0_1h, l1_1h, col_1h, "1H")
            prev_l0_1h := l0_1h
            prev_l1_1h := l1_1h

    if show_4h
        [l0_4h, l1_4h] = calc_fib_points(h4h, o4h, c4h, a4h, ph4h, lookback)
        if l0_4h != prev_l0_4h or l1_4h != prev_l1_4h
            draw_fib(lines_4h, labels_4h, l0_4h, l1_4h, col_4h, "4H")
            prev_l0_4h := l0_4h
            prev_l1_4h := l1_4h

// ═══════════════════════════════════════════════════════════════════
//  TABLE CONFLUENCE 0.618
// ═══════════════════════════════════════════════════════════════════
check_618(l0, l1) =>
    not na(l0) and not na(l1) and
      math.abs(close - fib_price(l0, l1, 0.618)) / fib_price(l0, l1, 0.618) * 100 <= near_pct

near_15    = check_618(prev_l0_15, prev_l1_15)
near_1h    = check_618(prev_l0_1h, prev_l1_1h)
near_4h    = check_618(prev_l0_4h, prev_l1_4h)
confluence = (near_15 ? 1 : 0) + (near_1h ? 1 : 0) + (near_4h ? 1 : 0)

var table tbl = table.new(position.top_left, 1, 2,
     bgcolor=color.new(color.black, 60), border_width=1, border_color=color.gray)

table.cell(tbl, 0, 0,
     "Confluence 0.618 : " + str.tostring(confluence) + "/3" + (confluence >= 2 ? "  ⚡ PRESSION" : ""),
     text_color = confluence >= 2 ? color.white : color.gray,
     bgcolor    = confluence >= 2 ? color.new(color.green, 30) : color.new(color.gray, 70),
     text_size  = size.small)

table.cell(tbl, 0, 1,
     (near_15 ? "✓" : "✗") + "15m  " + (near_1h ? "✓" : "✗") + "1H  " + (near_4h ? "✓" : "✗") + "4H",
     text_color = color.silver, text_size = size.tiny)
