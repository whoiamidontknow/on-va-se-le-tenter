// ══════════════════════════════════════════════════════════════
// PRÉRÉGLAGES — STRUCTURE EXTENSIBLE (V4)
// ══════════════════════════════════════════════════════════════
// Un préréglage = UNE ligne « clé=valeur;clé=valeur;… » dans f_pr_def().
// Pour en ajouter un :
//   1. ajouter son nom EXACT dans options=[…] du menu « Préréglage » ;
//   2. ajouter une ligne :   nom == "<nom exact>" ? "<clés>" :
// Règle des clés absentes : interrupteurs et modes (marqués ⓘ) = valeur
// NEUTRE (coupé / « Aucun » / « ATR × k » / « Les deux ») ; paramètres
// numériques et autres = valeur du réglage de la boîte de dialogue.
// Booléens : 1 / 0. Modes : le libellé EXACT de l'option du menu (une faute
// de frappe arrête le script avec un message). Pas de « ; » ni « = » dans
// une valeur. Les espaces après « ; » sont tolérés.
// Clés :
//   ENTRÉES  sens ⓘ (Les deux | Long seulement | Short seulement), sig ⓘ,
//            sigNiv ⓘ (Fort seulement | Fort + Moyen), hei ⓘ, tl ⓘ, lvl ⓘ, clx ⓘ,
//            div ⓘ (divergence après excès), divX
//   JOURNAL  jr ⓘ (variables dans le commentaire d'entrée)
//   BIAIS    bias ⓘ (ne trader que dans le sens du biais global), bF, bI
//   FILTRES  feu ⓘ, feuMode, feuSeuil, tr ⓘ, tr4h ⓘ (TREND sur 4 h), ema ⓘ,
//            dsh60 ⓘ, dsh240 ⓘ (Dashator 1 h / 4 h dans le sens), dshMin (corps min.
//            × ATR de l'unité), eOn ⓘ, eMax, hr ⓘ, hr1On, hr1 (ex.
//            1430-0800), hr2On, hr2, bo, adx ⓘ, adxMin, maxJour, det ⓘ, detK,
//            clxF ⓘ (filtre climax), clxAge
//   SORTIES  stop ⓘ (ATR × k | Niveau de protection | Dernier swing + marge |
//            Fixe (points) | Zone Detector la plus proche | Extrême 2 bougies + marge),
//            atrK, fixPts,
//            tp ⓘ (Aucun | En R | Prochain niveau), tpR, trail ⓘ (Aucun | ATR |
//            Sous chaque nouveau swing), trK, trAct, be ⓘ, beR, oppArr ⓘ,
//            oppHei ⓘ, fin ⓘ, pf ⓘ (à plat avant 15:59 Chicago), beTk,
//            tBar ⓘ (sortie après N bougies, 0 = jamais), extMarge, extMin, extMax
//   NIVEAUX  prio, slA slM slW slD slMo slSe slRo, slMin, slMax, slMarge,
//            tpA tpM tpW tpD tpMo tpSe tpRo, rrMin, tpMarge, tpSans (Objectif
//            en R | Pas d'objectif | Ne pas prendre le trade), part ⓘ, partPct,
//            partRest (2e niveau | Stop seulement (suiveur, break-even, signaux)),
//            partBE, slSans (Repli ATR × k | Ne pas prendre le trade),
//            margeU (Ticks | × ATR)
//   ADAPTATIF stop=Adaptatif et/ou tp=Adaptatif ; adFeu, adAdx, adR1, adR2, adR3,
//            adSaute, adK, adKbas, adKhaut, adNiv ⓘ
//   TAILLE   taille (Contrats fixes | Risque fixe en $), risque, fixe (contrats)
// Non modifiables par préréglage (valeur fixe exigée par Pine) : unité du
// TREND supérieur, « Niveaux mesurés sur ».
f_pr_def(string nom) =>
    nom == "C — Cassure de trendline"         ? "tl=1;hr=1;hr1On=1;hr1=1430-0800;hr2On=0;atrK=1.5;tp=En R;tpR=2" :
     nom == "A — Climax BUY dans la tendance" ? "sens=Long seulement;clx=1;tr=1;atrK=2;oppHei=1" :
     nom == "B — Signator Fort + TREND"       ? "sig=1;sigNiv=Fort seulement;tr=1;hr=1;hr1On=1;hr1=1430-0800;hr2On=0;atrK=1;oppHei=1" :
     // 19 préréglages du 16/10 (tools/strategie/preregles/PREREGLAGES.md) :
     // hypothèses à vérifier au testeur sur 3 ans, du plus prometteur au moins.
     nom == "01 A jour 08-23h · SL 2 ATR · Heishi" ? "sens=Long seulement;clx=1;sig=0;hei=0;tl=0;lvl=0;tr=1;feu=0;ema=0;adx=0;det=0;clxF=0;bo=1;maxJour=3;be=0;trail=Aucun;oppArr=0;fin=0;part=0;hr=1;hr1On=1;hr1=0800-2300;hr2On=0;stop=ATR × k;atrK=2;tp=Aucun;oppHei=1" :
     nom == "02 A réf · SL 2 ATR · Heishi" ? "sens=Long seulement;clx=1;sig=0;hei=0;tl=0;lvl=0;tr=1;feu=0;ema=0;adx=0;det=0;clxF=0;bo=1;maxJour=3;be=0;trail=Aucun;oppArr=0;fin=0;part=0;hr=0;stop=ATR × k;atrK=2;tp=Aucun;oppHei=1" :
     nom == "03 A · SL pivots HA 1-3 ATR" ? "sens=Long seulement;clx=1;sig=0;hei=0;tl=0;lvl=0;tr=1;feu=0;ema=0;adx=0;det=0;clxF=0;bo=1;maxJour=3;be=0;trail=Aucun;oppArr=0;fin=0;part=0;hr=0;stop=Niveau de protection;prio=annuel > mensuel > weekly;slA=1;slM=1;slW=1;slD=0;slMo=0;slSe=0;slRo=0;slMin=1;slMax=3;slMarge=0.1;atrK=2;tp=Aucun;oppHei=1" :
     nom == "04 A · SL 2,5 ATR · Heishi" ? "sens=Long seulement;clx=1;sig=0;hei=0;tl=0;lvl=0;tr=1;feu=0;ema=0;adx=0;det=0;clxF=0;bo=1;maxJour=3;be=0;trail=Aucun;oppArr=0;fin=0;part=0;hr=0;stop=ATR × k;atrK=2.5;tp=Aucun;oppHei=1" :
     nom == "05 A · SL 3 ATR · Heishi" ? "sens=Long seulement;clx=1;sig=0;hei=0;tl=0;lvl=0;tr=1;feu=0;ema=0;adx=0;det=0;clxF=0;bo=1;maxJour=3;be=0;trail=Aucun;oppArr=0;fin=0;part=0;hr=0;stop=ATR × k;atrK=3;tp=Aucun;oppHei=1" :
     nom == "06 A · SL+TP pivots HA · Heishi" ? "sens=Long seulement;clx=1;sig=0;hei=0;tl=0;lvl=0;tr=1;feu=0;ema=0;adx=0;det=0;clxF=0;bo=1;maxJour=3;be=0;trail=Aucun;oppArr=0;fin=0;part=0;hr=0;stop=Niveau de protection;prio=annuel > mensuel > weekly;slA=1;slM=1;slW=1;slD=0;slMo=0;slSe=0;slRo=0;slMin=1;slMax=3;slMarge=0.1;atrK=2;tp=Prochain niveau;tpA=1;tpM=1;tpW=1;tpD=0;tpMo=0;tpSe=0;tpRo=0;rrMin=1.5;tpMarge=0.1;tpSans=Pas d'objectif;oppHei=1" :
     nom == "07 A · SL 1,5 ATR · Heishi" ? "sens=Long seulement;clx=1;sig=0;hei=0;tl=0;lvl=0;tr=1;feu=0;ema=0;adx=0;det=0;clxF=0;bo=1;maxJour=3;be=0;trail=Aucun;oppArr=0;fin=0;part=0;hr=0;stop=ATR × k;atrK=1.5;tp=Aucun;oppHei=1" :
     nom == "08 C · SL 2 ATR · TP pivots + Heishi" ? "sens=Les deux;clx=0;sig=0;hei=0;tl=1;lvl=0;tr=0;feu=0;ema=0;adx=0;det=0;clxF=0;bo=1;maxJour=3;be=0;trail=Aucun;oppArr=0;fin=0;part=0;hr=1;hr1On=1;hr1=1430-0800;hr2On=0;stop=ATR × k;atrK=2;tp=Prochain niveau;tpA=1;tpM=1;tpW=1;tpD=0;tpMo=0;tpSe=0;tpRo=0;rrMin=1.5;tpMarge=0.1;tpSans=Pas d'objectif;oppHei=1" :
     nom == "09 C réf · SL 1,5 ATR · 2R" ? "sens=Les deux;clx=0;sig=0;hei=0;tl=1;lvl=0;tr=0;feu=0;ema=0;adx=0;det=0;clxF=0;bo=1;maxJour=3;be=0;trail=Aucun;oppArr=0;fin=0;part=0;hr=1;hr1On=1;hr1=1430-0800;hr2On=0;stop=ATR × k;atrK=1.5;tp=En R;tpR=2;oppHei=0" :
     nom == "10 A · SL fixe 80 pts (NQ)" ? "sens=Long seulement;clx=1;sig=0;hei=0;tl=0;lvl=0;tr=1;feu=0;ema=0;adx=0;det=0;clxF=0;bo=1;maxJour=3;be=0;trail=Aucun;oppArr=0;fin=0;part=0;hr=0;stop=Fixe (points);fixPts=80;tp=Aucun;oppHei=1" :
     nom == "11 A · SL fixe 13 pts (ES)" ? "sens=Long seulement;clx=1;sig=0;hei=0;tl=0;lvl=0;tr=1;feu=0;ema=0;adx=0;det=0;clxF=0;bo=1;maxJour=3;be=0;trail=Aucun;oppArr=0;fin=0;part=0;hr=0;stop=Fixe (points);fixPts=13;tp=Aucun;oppHei=1" :
