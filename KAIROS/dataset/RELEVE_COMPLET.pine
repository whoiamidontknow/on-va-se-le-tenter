     nom == "68 · 56 avec Dashator corps ≥ 0,09 ATR" ? "bias=0;sens=Les deux;sig=1;sigNiv=Fort + Moyen;hei=1;tl=1;lvl=1;clx=1;div=1;divX=2.5;tr=0;tr4h=0;feu=0;ema=0;adx=0;det=0;clxF=0;bo=0;maxJour=0;hr=0;be=0;trail=Aucun;oppArr=0;oppHei=0;fin=0;pf=1;part=0;tBar=16;stop=ATR × k;atrK=3;tp=En R;tpR=0.6667;taille=Contrats fixes;fixe=2;dsh60=1;dsh240=1;eOn=1;eMax=0.6;dshMin=0.09" :
     nom == "59 · 56 avec Dashator corps ≥ 0,2 ATR" ? "bias=0;sens=Les deux;sig=1;sigNiv=Fort + Moyen;hei=1;tl=1;lvl=1;clx=1;div=1;divX=2.5;tr=0;tr4h=0;feu=0;ema=0;adx=0;det=0;clxF=0;bo=0;maxJour=0;hr=0;be=0;trail=Aucun;oppArr=0;oppHei=0;fin=0;pf=1;part=0;tBar=16;stop=ATR × k;atrK=3;tp=En R;tpR=0.6667;taille=Contrats fixes;fixe=2;dsh60=1;dsh240=1;eOn=1;eMax=0.6;dshMin=0.2" :
     nom == "46 JR3 volume · Dashator 1h+4h · repli ≤ 1,5 ATR · 1R · 8 bougies" ? "bias=0;sens=Les deux;sig=1;sigNiv=Fort + Moyen;hei=1;tl=1;lvl=1;clx=1;div=1;divX=2.5;tr=0;tr4h=0;feu=0;ema=0;adx=0;det=0;clxF=0;bo=0;maxJour=0;hr=0;be=0;trail=Aucun;oppArr=0;oppHei=0;fin=0;pf=1;part=0;tBar=8;stop=ATR × k;atrK=2;tp=En R;tpR=1;taille=Contrats fixes;fixe=2;dsh60=1;dsh240=1;eOn=1;eMax=1.5" :
     nom == "99 JOURNAL · tous signaux sans filtre · 2 ATR · 1R · 8 bougies" ? "jr=1;bias=0;sens=Les deux;sig=1;sigNiv=Fort + Moyen;hei=1;tl=1;lvl=1;clx=1;div=1;divX=2.5;tr=0;tr4h=0;feu=0;ema=0;adx=0;det=0;clxF=0;bo=0;maxJour=0;hr=0;be=0;trail=Aucun;oppArr=0;oppHei=0;fin=0;pf=1;part=0;tBar=8;stop=ATR × k;atrK=2;tp=En R;tpR=1;taille=Contrats fixes;fixe=2" :
     ""

pP     = preset == "Personnalisé"
pr_def = str.replace_all(f_pr_def(preset), "; ", ";")
if barstate.isfirst and not pP and pr_def == ""
    runtime.error("Préréglage « " + preset + " » : aucune ligne dans f_pr_def().")

// Valeur (texte) de la clé k dans le préréglage, na si absente.
f_pv(string k) =>
    string res = na
    if pr_def != ""
        t = ";" + pr_def + ";"
        i = str.pos(t, ";" + k + "=")
        if not na(i)
            rest = str.substring(t, i + str.length(k) + 2)
            res := str.substring(rest, 0, str.pos(rest, ";"))
    res
// Lecteurs : texte (avec liste des valeurs permises), booléen, nombre.
f_gs(string k, string vin, string vbase, string permis) =>
    v = f_pv(k)
    string r = pP ? vin : na(v) ? vbase : v
    if not pP and not na(v) and not str.contains("|" + permis + "|", "|" + v + "|")
        runtime.error("Préréglage « " + preset + " » : valeur « " + v + " » invalide pour la clé « " + k + " ». Permis : " + permis)
    r
f_gb(string k, bool vin, bool vbase) =>
    v = f_pv(k)
    pP ? vin : na(v) ? vbase : (v == "1" or v == "oui" or v == "true")
f_gf(string k, float vin) =>
    v = f_pv(k)
    float r = pP or na(v) ? vin : str.tonumber(v)
    if na(r)
        runtime.error("Préréglage « " + preset + " » : nombre invalide pour la clé « " + k + " ».")
    r

