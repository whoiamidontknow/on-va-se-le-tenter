//@version=6
// ════════════════════════════════════════════════════════════
// BREAKOUT DIAGNOSTIC V3 — Clean, one method at a time
// ════════════════════════════════════════════════════════════
indicator("Breakout Diag V3", overlay=true,
     max_lines_count=100, max_labels_count=500)

// ══════════════════════════════════════════════════════════════
// INPUTS — TL PARAMS (mêmes que TRENDLINES)
// ══════════════════════════════════════════════════════════════
grp = "=== TRENDLINE ==="
piv_len     = input.int(10,    "Pivot High Bars",  group=grp, minval=2, maxval=50)
buffer_pct  = input.float(0.1, "Price Buffer %",   group=grp, minval=0.0, maxval=5.0, step=0.05)
min_touches = input.int(3,     "Min Touches",      group=grp, minval=2, maxval=10)
lookback    = input.int(100,   "Lookback Bars",    group=grp, minval=10, maxval=500)
tl_col      = input.color(#C8C8A9, "TL Color",     group=grp)

grp_m = "=== METHODE (active 1 seule à la fois) ==="
method = input.string("A", "Méthode active", options=["A","B","C","D","E","F","G","H"], group=grp_m)
brk_col = input.color(color.lime, "Breakout Color", group=grp_m)

// A = ta.crossover(close, tl)
// B = ta.crossover(high, tl)
// C = ta.crossover(hl2, tl)
// D = ta.crossover(hlc3, tl)
// E = low > tl (candle entière au-dessus)
// F = close > tl (1ère fois, état)
// G = close[1] crossed, signal sur barre suivante (confirmation)
// H = close > tl + buffer (0.1% au-dessus)

grp_v = "=== VISUALS ==="
show_tl_plot = input.bool(true, "Plot TL continu (rouge)", group=grp_v)
show_labels  = input.bool(true, "Labels debug au breakout", group=grp_v)

// ══════════════════════════════════════════════════════════════
// PIVOT DETECTION
// ══════════════════════════════════════════════════════════════
ph = ta.pivothigh(high, piv_len, piv_len)

var float[] ph_price = array.new_float(0)
var int[]   ph_bar   = array.new_int(0)

if not na(ph)
    array.unshift(ph_price, ph)
    array.unshift(ph_bar,   bar_index - piv_len)
    if array.size(ph_price) > 50
        array.pop(ph_price)
        array.pop(ph_bar)

// ══════════════════════════════════════════════════════════════
// FONCTIONS
// ══════════════════════════════════════════════════════════════
f_tl(x1, y1, slope, x) =>
    y1 + slope * (x - x1)

f_tc(x1, y1, slope, pp, pb, buf, lb) =>
    c = 0
    sz = array.size(pp)
    for i = 0 to math.min(sz - 1, 49)
        px = array.get(pb, i)
        py = array.get(pp, i)
        if bar_index - px <= lb and px >= x1
            tly = f_tl(x1, y1, slope, px)
            b = tly * buf / 100.0
            if py >= tly - b and py <= tly + b
                c += 1
    c

// ══════════════════════════════════════════════════════════════
// BEST TRENDLINE — every bar
// ══════════════════════════════════════════════════════════════
var float bx1 = na
var float by1 = na
var float bsl = na
var int   btc = 0

if array.size(ph_price) >= 2
    sz = array.size(ph_price)
    _tc = 0
    _x1 = 0.0
    _y1 = 0.0
    _sl = 0.0
    mi = math.min(sz - 1, 19)
    mj = math.min(sz - 1, 29)
    for i = 0 to mi
        for j = i + 1 to mj
            if j < sz
                x1v = array.get(ph_bar, j)
                y1v = array.get(ph_price, j)
                x2v = array.get(ph_bar, i)
                y2v = array.get(ph_price, i)
                if x2v > x1v and bar_index - x1v <= lookback
                    sl = (y2v - y1v) / (x2v - x1v)
                    if sl <= 0
                        tc = f_tc(x1v, y1v, sl, ph_price, ph_bar, buffer_pct, lookback)
                        if tc >= min_touches and tc > _tc
                            _tc := tc
                            _x1 := float(x1v)
                            _y1 := y1v
                            _sl := sl
    if _tc >= min_touches
        bx1 := _x1
        by1 := _y1
        bsl := _sl
        btc := _tc

// ══════════════════════════════════════════════════════════════
// TL VALUE — series continues
// ══════════════════════════════════════════════════════════════
float tl_v = not na(bx1) and btc >= min_touches ? f_tl(bx1, by1, bsl, bar_index) : na

plot(show_tl_plot ? tl_v : na, "TL", color=color.new(color.red, 20), linewidth=2)

// ══════════════════════════════════════════════════════════════
// BREAKOUT — 1 seule méthode active
// ══════════════════════════════════════════════════════════════
float src_hl2  = hl2
float src_hlc3 = hlc3

// State for method F
var bool f_below = true
bool f_sig = false
if not na(tl_v)
    if close > tl_v and f_below
        f_sig := true
        f_below := false
    if close <= tl_v
        f_below := true

// Method G: signal on confirmation bar (bar after cross)
bool g_cross_prev = not na(tl_v) and nz(close[1]) > nz(tl_v[1]) and nz(close[2]) <= nz(tl_v[2])

bool brk = switch method
    "A" => not na(tl_v) and ta.crossover(close, tl_v)
    "B" => not na(tl_v) and ta.crossover(high, tl_v)
    "C" => not na(tl_v) and ta.crossover(src_hl2, tl_v)
    "D" => not na(tl_v) and ta.crossover(src_hlc3, tl_v)
    "E" => not na(tl_v) and low > tl_v and low[1] <= nz(tl_v[1])
    "F" => f_sig
    "G" => g_cross_prev
    "H" => not na(tl_v) and close > tl_v * 1.001 and close[1] <= nz(tl_v[1]) * 1.001
    => false

plotshape(brk, title="Breakout", style=shape.circle,
     location=location.belowbar, color=brk_col, size=size.small)

// ══════════════════════════════════════════════════════════════
// DEBUG LABEL at breakout
// ══════════════════════════════════════════════════════════════
if show_labels and brk
    txt = method + " | C:" + str.tostring(close, format.mintick) + " TL:" + str.tostring(tl_v, format.mintick) + " H:" + str.tostring(high, format.mintick) + " L:" + str.tostring(low, format.mintick)
    label.new(bar_index, low, txt,
         xloc=xloc.bar_index, textcolor=brk_col,
         color=color.new(brk_col, 80),
         style=label.style_label_up, size=size.tiny)

// ══════════════════════════════════════════════════════════════
// DRAW TL LINE (barstate.islast)
// ══════════════════════════════════════════════════════════════
var line[] tls = array.new_line(0)
if barstate.islast and not na(bx1)
    while array.size(tls) > 0
        line.delete(array.pop(tls))
    lx = int(bx1)
    ex = bar_index + 50
    ey = f_tl(bx1, by1, bsl, ex)
    array.push(tls, line.new(lx, by1, ex, ey, xloc=xloc.bar_index, color=tl_col, width=2))

// ══════════════════════════════════════════════════════════════
// TABLE — méthode active + description
// ══════════════════════════════════════════════════════════════
if barstate.islast
    var table t = table.new(position.bottom_right, 2, 10,
         bgcolor=color.new(#1A1A1A, 10), border_width=1,
         border_color=color.rgb(60, 60, 60))

    table.cell(t, 0, 0, "Active", text_color=color.white, text_size=size.small, bgcolor=color.new(color.navy, 20))
    table.cell(t, 1, 0, method,   text_color=brk_col,     text_size=size.normal, bgcolor=color.new(color.navy, 20))

    descs = array.from(
         "A: crossover(close, tl)",
         "B: crossover(high, tl)",
         "C: crossover(hl2, tl)",
         "D: crossover(hlc3, tl)",
         "E: low > tl (candle above)",
         "F: close>tl 1st time (state)",
         "G: confirmation bar (+1)",
         "H: close > tl+0.1%")

    for i = 0 to 7
        d = array.get(descs, i)
        letter = str.substring(d, 0, 1)
        is_active = letter == method
        table.cell(t, 0, i + 1, d, text_color=is_active ? brk_col : color.gray, text_size=size.small)
        table.cell(t, 1, i + 1, is_active ? "◄ ACTIVE" : "", text_color=brk_col, text_size=size.small)
