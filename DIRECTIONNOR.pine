//@version=6
// ════════════════════════════════════════════════════════════════
// DIRECTIONNOR — Sens (order blocks) + Range = ne rien faire + Allumage
// SENS : lit les rectangles du Detector (order blocks sur pivots de volume,
//   même logique que PORSCHEONARRIVE). Poids de chaque zone = proximité × couleur,
//   les zones loin ne comptent presque pas. -> % directionnel (LONG/SHORT).
// RANGE : si zones bleues/rouges se chevauchent (congestion) OU biais équilibré
//   -> ⛔ ne rien faire (la strat de continuation ne marche pas en range).
// ALLUMAGE (GO) : pic de volume + expansion de volatilité, JAMAIS en range.
// /!\ TF du chart (global). Non compile-testé : à coller dans TradingView.
// ════════════════════════════════════════════════════════════════
indicator("Directionnor", overlay=true, max_labels_count=300)

// ── DETECTOR (order blocks) ──────────────────────────────────────
grpD = "=== DETECTOR (Order Blocks) ==="
ob_len = input.int(5,      "Volume Pivot Length (= ton Detector)", group=grpD, minval=1)
mitig  = input.string("Wick", "Mitigation", options=["Wick","Close"], group=grpD)
max_ob = input.int(5,      "Nb max de zones par couleur",          group=grpD, minval=1, maxval=20)

// ── SENS (probabilité directionnelle) ────────────────────────────
grpS = "=== SENS (probabilité) ==="
prox_scale = input.float(1.0,  "Portée proximité (% du prix) — au-delà ≈ 0", group=grpS, minval=0.1, step=0.1, tooltip="Une zone à plus de X % du prix ne pèse presque plus. C'est ce qui fait qu'une zone LOIN ne compte pas.")
range_thr  = input.float(25.0, "Seuil RANGE (|biais %| en dessous = range)", group=grpS, minval=0, maxval=100, step=5)

// ── NE RIEN FAIRE EN RANGE ───────────────────────────────────────
grpR = "=== NE RIEN FAIRE EN RANGE ==="
use_overlap = input.bool(true, "Range si zones bleues/rouges se chevauchent (congestion)", group=grpR)

// ── DÉCLENCHEUR (allumage : ça part) ─────────────────────────────
grpG = "=== DÉCLENCHEUR (allumage) ==="
vol_len     = input.int(20,   "Moyenne volume (barres)",            group=grpG, minval=1)
vol_k       = input.float(1.8,"Pic de volume si volume > moyenne ×", group=grpG, minval=1.0, step=0.1)
atr_fast    = input.int(5,    "ATR rapide (volatilité)",            group=grpG, minval=1)
atr_slow    = input.int(20,   "ATR lent (baseline)",                group=grpG, minval=1)
show_go     = input.bool(true,"Flèches GO sur le chart",            group=grpG)
go_realtime = input.bool(false,"GO en temps réel (sinon : clôture confirmée)", group=grpG)

// ── TABLEAU ──────────────────────────────────────────────────────
grpV = "=== TABLEAU ==="
tbl_pos  = input.string("Top Right", "Position du tableau",
     options=["Top Left","Top Center","Top Right","Middle Left","Middle Center","Middle Right","Bottom Left","Bottom Center","Bottom Right"], group=grpV)
tbl_size = input.string("normal", "Taille texte", options=["tiny","small","normal","large"], group=grpV)

// ── COULEURS ─────────────────────────────────────────────────────
c_long  = #2196F3
c_short = #F44336
c_range = color.rgb(130, 130, 150)
c_vol   = #FF9800
c_head  = color.new(#2A2E39, 0)

// ── DÉTECTION DES ORDER BLOCKS (port du Detector, sans dessin) ────
upper = ta.highest(ob_len)
lower = ta.lowest(ob_len)
var int os = 0
os := high[ob_len] > upper ? 0 : low[ob_len] < lower ? 1 : os[1]
phv = not na(ta.pivothigh(volume, ob_len, ob_len))
target_bull = mitig == "Close" ? ta.lowest(close, ob_len) : lower
target_bear = mitig == "Close" ? ta.highest(close, ob_len) : upper

var bull_top = array.new_float(0)
var bull_btm = array.new_float(0)
var bear_top = array.new_float(0)
var bear_btm = array.new_float(0)

// 1) Ajout d'une nouvelle zone sur pivot de volume
if phv and os == 1
    array.unshift(bull_top, hl2[ob_len])
    array.unshift(bull_btm, low[ob_len])
if phv and os == 0
    array.unshift(bear_top, high[ob_len])
    array.unshift(bear_btm, hl2[ob_len])

// 2) Retrait des zones cassées (mitigées)
if array.size(bull_btm) > 0
    for i = array.size(bull_btm) - 1 to 0
        if target_bull < array.get(bull_btm, i)
            array.remove(bull_top, i)
            array.remove(bull_btm, i)
if array.size(bear_top) > 0
    for i = array.size(bear_top) - 1 to 0
        if target_bear > array.get(bear_top, i)
            array.remove(bear_top, i)
            array.remove(bear_btm, i)

// 3) Plafond du nombre de zones (on garde les plus récentes)
while array.size(bull_top) > max_ob
    array.pop(bull_top)
    array.pop(bull_btm)
while array.size(bear_top) > max_ob
    array.pop(bear_top)
    array.pop(bear_btm)

// ── SENS : somme pondérée par la proximité ───────────────────────
price  = close
n_blue = array.size(bull_btm)
n_red  = array.size(bear_btm)

f_weight(top, btm) =>
    mid  = (top + btm) / 2.0
    dpct = math.abs(price - mid) / price * 100.0
    math.max(0.0, 1.0 - dpct / prox_scale)   // 1 au contact, 0 au-delà de prox_scale %

float w_long  = 0.0
float w_short = 0.0
if n_blue > 0
    for i = 0 to n_blue - 1
        w_long := w_long + f_weight(array.get(bull_top, i), array.get(bull_btm, i))
if n_red > 0
    for i = 0 to n_red - 1
        w_short := w_short + f_weight(array.get(bear_top, i), array.get(bear_btm, i))

float tot  = w_long + w_short
float bias = tot > 0 ? (w_long - w_short) / tot * 100.0 : 0.0   // +long / -short

// ── RANGE : chevauchement des zones OU biais équilibré ───────────
bool overlap = false
if use_overlap and n_blue > 0 and n_red > 0
    for i = 0 to n_blue - 1
        bt = array.get(bull_top, i)
        bb = array.get(bull_btm, i)
        for j = 0 to n_red - 1
            if bt >= array.get(bear_btm, j) and array.get(bear_top, j) >= bb
                overlap := true

bool is_range = overlap or math.abs(bias) < range_thr
int  sens     = is_range ? 0 : bias > 0 ? 1 : bias < 0 ? -1 : 0

// ── ALLUMAGE (jamais en range) ───────────────────────────────────
vol_spike = volume > ta.sma(volume, vol_len) * vol_k
vol_exp   = ta.atr(atr_fast) > ta.atr(atr_slow)
ignition  = vol_spike and vol_exp
go_conf   = go_realtime or barstate.isconfirmed
go_long   = not is_range and sens == 1  and ignition and close > open and go_conf
go_short  = not is_range and sens == -1 and ignition and close < open and go_conf

// ── LIBELLÉS ─────────────────────────────────────────────────────
pct      = str.tostring(int(math.round(math.abs(bias))))
biais_txt = is_range ? "RANGE" : sens == 1 ? "LONG " + pct + "%" : sens == -1 ? "SHORT " + pct + "%" : "—"
biais_col = is_range ? c_range : sens == 1 ? c_long : sens == -1 ? c_short : c_range
zones_txt = str.tostring(n_blue) + " bleu  /  " + str.tostring(n_red) + " rouge"
ign_txt   = ignition ? "ALLUMÉ" : "calme"
ign_col   = ignition ? color.new(c_vol, 0) : c_range
act_lbl   = is_range ? "⛔ RANGE — ne rien faire" : sens == 1 ? (go_long ? "🟢 GO LONG" : "PRÊT ▲ LONG") : sens == -1 ? (go_short ? "🔴 GO SHORT" : "PRÊT ▼ SHORT") : "ATTENDRE"
act_col   = is_range ? c_range : go_long ? c_long : go_short ? c_short : sens == 1 ? color.new(c_long, 55) : sens == -1 ? color.new(c_short, 55) : c_range

f_pos(p) =>
    switch p
        "Top Left"      => position.top_left
        "Top Center"    => position.top_center
        "Top Right"     => position.top_right
        "Middle Left"   => position.middle_left
        "Middle Center" => position.middle_center
        "Middle Right"  => position.middle_right
        "Bottom Left"   => position.bottom_left
        "Bottom Center" => position.bottom_center
        "Bottom Right"  => position.bottom_right
        => position.top_right

f_sz(s) =>
    switch s
        "tiny"  => size.tiny
        "small" => size.small
        "large" => size.large
        => size.normal

// ── FLÈCHES GO ───────────────────────────────────────────────────
plotshape(show_go and go_long,  "GO LONG",  style=shape.triangleup,   location=location.belowbar, color=c_long,  size=size.small, text="GO")
plotshape(show_go and go_short, "GO SHORT", style=shape.triangledown, location=location.abovebar, color=c_short, size=size.small, text="GO")

// ── TABLEAU ──────────────────────────────────────────────────────
var table t = na
if barstate.islast
    sz = f_sz(tbl_size)
    if na(t)
        t := table.new(f_pos(tbl_pos), 2, 5, border_width=1, border_color=color.new(color.gray, 40))
        table.cell(t, 0, 0, "🧭 DIRECTIONNOR", text_color=color.white, text_size=sz, bgcolor=c_head)
        table.cell(t, 1, 0, "", bgcolor=c_head)
        table.cell(t, 0, 1, "Sens",     text_color=color.silver, text_size=sz, bgcolor=c_head)
        table.cell(t, 0, 2, "Zones",    text_color=color.silver, text_size=sz, bgcolor=c_head)
        table.cell(t, 0, 3, "Allumage", text_color=color.silver, text_size=sz, bgcolor=c_head)
        table.cell(t, 1, 1, "", bgcolor=c_head)
        table.cell(t, 1, 2, "", bgcolor=c_head)
        table.cell(t, 1, 3, "", bgcolor=c_head)
        table.cell(t, 0, 4, "", bgcolor=c_head)
        table.cell(t, 1, 4, "", bgcolor=c_head)
        table.merge_cells(t, 0, 0, 1, 0)
        table.merge_cells(t, 0, 4, 1, 4)
    table.cell(t, 1, 1, biais_txt, text_color=color.white, text_size=sz, bgcolor=color.new(biais_col, 0))
    table.cell(t, 1, 2, zones_txt, text_color=color.white, text_size=sz, bgcolor=c_head)
    table.cell(t, 1, 3, ign_txt,   text_color=color.white, text_size=sz, bgcolor=color.new(ign_col, 0))
    table.cell(t, 0, 4, act_lbl,   text_color=color.white, text_size=sz, bgcolor=color.new(act_col, 0))

// ── ALERTES ──────────────────────────────────────────────────────
alertcondition(go_long,  "Directionnor GO LONG",  "Directionnor : GO LONG (zones + allumage, hors range)")
alertcondition(go_short, "Directionnor GO SHORT", "Directionnor : GO SHORT (zones + allumage, hors range)")
