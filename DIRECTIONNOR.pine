//@version=6
// ════════════════════════════════════════════════════════════════
// DIRECTIONNOR — Sens (order blocks) 4H+1H + Range = ne rien faire + Allumage
// RÈGLE : on agit seulement si le 4H ET le 1H donnent le MÊME sens.
// SENS par TF = lecture des order blocks (rectangles du Detector) :
//   poids de chaque zone non-cassée = proximité (zone loin ~0) × couleur.
//   bleu = demande (long), rouge = offre (short) -> % directionnel.
// RANGE (ne rien faire) : bleu ET rouge proches / se chevauchent (chop),
//   ou biais équilibré. Le GO ne se déclenche JAMAIS en range.
// ALLUMAGE (GO) : pic de volume + expansion ATR (sur le TF du chart).
// /!\ Le 4H/1H calcule les order blocks dans request.security (arrays) =
//     la partie la plus risquée. Si ça compile pas, dis-moi -> plan B.
// ════════════════════════════════════════════════════════════════
indicator("Directionnor", overlay=true, max_labels_count=300)

// ── DIRECTION : 4H + 1H (ta règle) ───────────────────────────────
grpTF = "=== DIRECTION : 4H + 1H ==="
tf_hi  = input.timeframe("240", "TF Haute (défaut 4h)",   group=grpTF)
tf_mid = input.timeframe("60",  "TF Moyenne (défaut 1h)", group=grpTF)

// ── DETECTOR (order blocks) ──────────────────────────────────────
grpD = "=== DETECTOR (Order Blocks) ==="
ob_len = input.int(5,      "Volume Pivot Length (= ton Detector)", group=grpD, minval=1)
mitig  = input.string("Wick", "Mitigation", options=["Wick","Close"], group=grpD)
max_ob = input.int(5,      "Nb max de zones par couleur",          group=grpD, minval=1, maxval=20)

// ── SENS (probabilité directionnelle) ────────────────────────────
grpS = "=== SENS (probabilité) ==="
prox_scale = input.float(1.0,  "Portée proximité (% du prix) — au-delà ≈ 0", group=grpS, minval=0.1, step=0.1)
range_thr  = input.float(25.0, "Seuil RANGE (|biais %| en dessous = range)", group=grpS, minval=0, maxval=100, step=5)
use_overlap= input.bool(true,  "Range si bleu ET rouge proches / se chevauchent (chop)", group=grpS)

// ── DÉCLENCHEUR (allumage) ───────────────────────────────────────
grpG = "=== DÉCLENCHEUR (allumage) ==="
vol_len     = input.int(20,   "Moyenne volume (barres)",            group=grpG, minval=1)
vol_k       = input.float(1.8,"Pic de volume si volume > moyenne ×", group=grpG, minval=1.0, step=0.1)
atr_fast    = input.int(5,    "ATR rapide (volatilité)",            group=grpG, minval=1)
atr_slow    = input.int(20,   "ATR lent (baseline)",                group=grpG, minval=1)
show_go     = input.bool(true,"Flèches GO sur le chart",            group=grpG)
go_realtime = input.bool(false,"GO en temps réel (sinon : clôture confirmée)", group=grpG)

// ── TABLEAU ──────────────────────────────────────────────────────
grpV = "=== TABLEAU ==="
tbl_pos  = input.string("Top Right", "Position du tableau",
     options=["Top Left","Top Center","Top Right","Middle Left","Middle Center","Middle Right","Bottom Left","Bottom Center","Bottom Right"], group=grpV)
tbl_size = input.string("normal", "Taille texte", options=["tiny","small","normal","large"], group=grpV)

// ── COULEURS ─────────────────────────────────────────────────────
c_long  = #2196F3
c_short = #F44336
c_range = color.rgb(130, 130, 150)
c_vol   = #FF9800
c_head  = color.new(#2A2E39, 0)
mitig_close = mitig == "Close"

// ── FONCTION : sens order-block d'un contexte -> [sens, nb, nr, range] ──
// 1=LONG, -1=SHORT, 0=RANGE. Détection + mitigation + scoring proximité.
f_ob_sens(oblen, mclose, maxob, proxscale, rangethr, useov) =>
    up = ta.highest(oblen)
    lo = ta.lowest(oblen)
    var int st_os = 0
    st_os := high[oblen] > up ? 0 : low[oblen] < lo ? 1 : st_os[1]
    phv = not na(ta.pivothigh(volume, oblen, oblen))
    tb = mclose ? ta.lowest(close, oblen) : lo
    tr = mclose ? ta.highest(close, oblen) : up

    var btop = array.new_float(0)
    var bbtm = array.new_float(0)
    var rtop = array.new_float(0)
    var rbtm = array.new_float(0)

    if phv and st_os == 1
        array.unshift(btop, hl2[oblen])
        array.unshift(bbtm, low[oblen])
    if phv and st_os == 0
        array.unshift(rtop, high[oblen])
        array.unshift(rbtm, hl2[oblen])

    if array.size(bbtm) > 0
        for i = array.size(bbtm) - 1 to 0
            if tb < array.get(bbtm, i)
                array.remove(btop, i)
                array.remove(bbtm, i)
    if array.size(rtop) > 0
        for i = array.size(rtop) - 1 to 0
            if tr > array.get(rtop, i)
                array.remove(rtop, i)
                array.remove(rbtm, i)

    while array.size(btop) > maxob
        array.pop(btop)
        array.pop(bbtm)
    while array.size(rtop) > maxob
        array.pop(rtop)
        array.pop(rbtm)

    p  = close
    nb = array.size(bbtm)
    nr = array.size(rbtm)
    float wl = 0.0
    float ws = 0.0
    if nb > 0
        for i = 0 to nb - 1
            mid = (array.get(btop, i) + array.get(bbtm, i)) / 2.0
            dp  = math.abs(p - mid) / p * 100.0
            wl := wl + math.max(0.0, 1.0 - dp / proxscale)
    if nr > 0
        for i = 0 to nr - 1
            mid = (array.get(rtop, i) + array.get(rbtm, i)) / 2.0
            dp  = math.abs(p - mid) / p * 100.0
            ws := ws + math.max(0.0, 1.0 - dp / proxscale)
    float tt = wl + ws
    float bp = tt > 0 ? (wl - ws) / tt * 100.0 : 0.0

    bool ov = false
    if useov and nb > 0 and nr > 0
        for i = 0 to nb - 1
            for j = 0 to nr - 1
                if array.get(btop, i) >= array.get(rbtm, j) and array.get(rtop, j) >= array.get(bbtm, i)
                    ov := true
    bool both_near = wl > 0.0 and ws > 0.0
    bool rng = (useov and (ov or both_near)) or math.abs(bp) < rangethr
    int sn = rng ? 0 : bp > 0 ? 1 : bp < 0 ? -1 : 0
    [sn, nb, nr, rng]

// ── SENS chart + 4H + 1H ─────────────────────────────────────────
[s_ch, nb_ch, nr_ch, rng_ch] = f_ob_sens(ob_len, mitig_close, max_ob, prox_scale, range_thr, use_overlap)
[s_hi, h1, h2, h3] = request.security(syminfo.tickerid, tf_hi,  f_ob_sens(ob_len, mitig_close, max_ob, prox_scale, range_thr, use_overlap), lookahead=barmerge.lookahead_off)
[s_md, m1, m2, m3] = request.security(syminfo.tickerid, tf_mid, f_ob_sens(ob_len, mitig_close, max_ob, prox_scale, range_thr, use_overlap), lookahead=barmerge.lookahead_off)

// ── RÈGLE : on agit seulement si 4H ET 1H sont d'accord ──────────
bias = (s_hi == 1 and s_md == 1) ? 1 : (s_hi == -1 and s_md == -1) ? -1 : 0

// ── ALLUMAGE (sur le TF du chart, jamais en range) ───────────────
vol_spike = volume > ta.sma(volume, vol_len) * vol_k
vol_exp   = ta.atr(atr_fast) > ta.atr(atr_slow)
ignition  = vol_spike and vol_exp
go_conf   = go_realtime or barstate.isconfirmed
go_long   = bias == 1  and not rng_ch and ignition and close > open and go_conf
go_short  = bias == -1 and not rng_ch and ignition and close < open and go_conf

// ── LIBELLÉS ─────────────────────────────────────────────────────
f_lbl(s) => s == 1 ? "LONG" : s == -1 ? "SHORT" : "RANGE"
f_col(s) => s == 1 ? c_long : s == -1 ? c_short : c_range

zones_txt = str.tostring(nb_ch) + " bleu / " + str.tostring(nr_ch) + " rouge"
ign_txt   = ignition ? "ALLUMÉ" : "calme"
ign_col   = ignition ? color.new(c_vol, 0) : c_range
act_lbl   = bias == 0 ? "⛔ ATTENDRE (4h/1h ≠)" : bias == 1 ? (go_long ? "🟢 GO LONG" : rng_ch ? "⛔ chop — attendre" : "PRÊT ▲ LONG") : (go_short ? "🔴 GO SHORT" : rng_ch ? "⛔ chop — attendre" : "PRÊT ▼ SHORT")
act_col   = bias == 0 ? c_range : go_long ? c_long : go_short ? c_short : rng_ch ? c_range : bias == 1 ? color.new(c_long, 55) : color.new(c_short, 55)

f_pos(p) =>
    switch p
        "Top Left"      => position.top_left
        "Top Center"    => position.top_center
        "Top Right"     => position.top_right
        "Middle Left"   => position.middle_left
        "Middle Center" => position.middle_center
        "Middle Right"  => position.middle_right
        "Bottom Left"   => position.bottom_left
        "Bottom Center" => position.bottom_center
        "Bottom Right"  => position.bottom_right
        => position.top_right

f_sz(s) =>
    switch s
        "tiny"  => size.tiny
        "small" => size.small
        "large" => size.large
        => size.normal

// ── FLÈCHES GO ───────────────────────────────────────────────────
plotshape(show_go and go_long,  "GO LONG",  style=shape.triangleup,   location=location.belowbar, color=c_long,  size=size.small, text="GO")
plotshape(show_go and go_short, "GO SHORT", style=shape.triangledown, location=location.abovebar, color=c_short, size=size.small, text="GO")

// ── TABLEAU ──────────────────────────────────────────────────────
var table t = na
if barstate.islast
    sz = f_sz(tbl_size)
    if na(t)
        t := table.new(f_pos(tbl_pos), 2, 6, border_width=1, border_color=color.new(color.gray, 40))
        table.cell(t, 0, 0, "🧭 DIRECTIONNOR", text_color=color.white, text_size=sz, bgcolor=c_head)
        table.cell(t, 1, 0, "", bgcolor=c_head)
        table.cell(t, 0, 1, "4H",       text_color=color.silver, text_size=sz, bgcolor=c_head)
        table.cell(t, 0, 2, "1H",       text_color=color.silver, text_size=sz, bgcolor=c_head)
        table.cell(t, 0, 3, "Zones",    text_color=color.silver, text_size=sz, bgcolor=c_head)
        table.cell(t, 0, 4, "Allumage", text_color=color.silver, text_size=sz, bgcolor=c_head)
        table.cell(t, 1, 1, "", bgcolor=c_head)
        table.cell(t, 1, 2, "", bgcolor=c_head)
        table.cell(t, 1, 3, "", bgcolor=c_head)
        table.cell(t, 1, 4, "", bgcolor=c_head)
        table.cell(t, 0, 5, "", bgcolor=c_head)
        table.cell(t, 1, 5, "", bgcolor=c_head)
        table.merge_cells(t, 0, 0, 1, 0)
        table.merge_cells(t, 0, 5, 1, 5)
    table.cell(t, 1, 1, f_lbl(s_hi), text_color=color.white, text_size=sz, bgcolor=color.new(f_col(s_hi), 0))
    table.cell(t, 1, 2, f_lbl(s_md), text_color=color.white, text_size=sz, bgcolor=color.new(f_col(s_md), 0))
    table.cell(t, 1, 3, zones_txt,   text_color=color.white, text_size=sz, bgcolor=c_head)
    table.cell(t, 1, 4, ign_txt,     text_color=color.white, text_size=sz, bgcolor=color.new(ign_col, 0))
    table.cell(t, 0, 5, act_lbl,     text_color=color.white, text_size=sz, bgcolor=color.new(act_col, 0))

// ── ALERTES ──────────────────────────────────────────────────────
alertcondition(go_long,  "Directionnor GO LONG",  "Directionnor : GO LONG (4h+1h d'accord + allumage)")
alertcondition(go_short, "Directionnor GO SHORT", "Directionnor : GO SHORT (4h+1h d'accord + allumage)")
