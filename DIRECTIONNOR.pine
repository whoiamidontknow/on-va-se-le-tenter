//@version=6
// ════════════════════════════════════════════════════════════════
// DIRECTIONNOR — Le sens + le déclencheur ("quand le marché part")
// 1) SENS (MTF) : tendance dominante (pente EMA33) du Detector/Heishinator, 4h/1h/15m.
//    -> Biais 4h+1h = LONG / SHORT / ATTENDRE. Un repli ne flippe PAS.
// 2) DÉCLENCHEUR (sur le TF du chart) : GO seulement quand le marché S'ENGAGE
//    dans le sens du biais = expansion de volatilité + cassure de range.
//    -> filtre les faux départs (entrées à contre-tendance ou en range).
// États : ATTENDRE -> PRÊT (biais ok, on attend) -> GO (le marché part).
// Tableau déplaçable + flèches GO + alertes.
// ════════════════════════════════════════════════════════════════
indicator("Directionnor", overlay=true, max_labels_count=300)

// ── INPUTS : TIMEFRAMES (paramétrables) ──────────────────────────
grp = "=== DIRECTIONNOR · TIMEFRAMES ==="
tf_hi  = input.timeframe("240", "TF Haute (défaut 4h)",   group=grp)
tf_mid = input.timeframe("60",  "TF Moyenne (défaut 1h)", group=grp)
tf_lo  = input.timeframe("15",  "TF Basse (défaut 15m)",  group=grp)

// ── INPUTS : MOTEUR DU SENS ──────────────────────────────────────
grpE = "=== MOTEUR DU SENS ==="
engine = input.string("Tendance dominante", "Ce que représente le sens", options=["Tendance dominante", "Momentum"], group=grpE, tooltip="Tendance dominante = direction de fond (pente EMA33), un repli ne flippe pas. Momentum = couleur Detector à l'instant T.")

grpT = "=== TENDANCE DOMINANTE ==="
trend_len = input.int(8,      "Lookback pente EMA33 (barres)",          group=grpT, minval=1)
flat_pct  = input.float(0.05, "Seuil plat = RANGE (% sur le lookback)", group=grpT, minval=0.0, step=0.01)

grpR = "=== MOMENTUM (zone neutre) ==="
dir_mode     = input.string("% fixe", "Mode largeur zone neutre", options=["% fixe", "ATR"], group=grpR)
dir_pct      = input.float(0.10, "Largeur % (mode % fixe)", group=grpR, minval=0.0, step=0.01)
dir_atr_len  = input.int(14,     "ATR longueur (mode ATR)", group=grpR, minval=1)
dir_atr_mult = input.float(0.5,  "ATR × (mode ATR)",        group=grpR, minval=0.0, step=0.1)

// ── INPUTS : DÉCLENCHEUR (le marché part) ────────────────────────
grpG = "=== DÉCLENCHEUR · le marché part ==="
trig_mode   = input.string("Confluence (vol + cassure)", "Condition du GO", options=["Confluence (vol + cassure)", "Expansion de volatilité seule", "Cassure de range seule"], group=grpG, tooltip="Évalué sur le TF du chart, et UNIQUEMENT dans le sens du biais 4h+1h.")
use_squeeze = input.bool(false, "Exiger une sortie de squeeze (anti-chop max)", group=grpG, tooltip="N'autorise le GO que si le marché sortait d'une phase calme (Bollinger dans Keltner) récente.")
atr_fast    = input.int(5,    "ATR rapide (volatilité courante)", group=grpG, minval=1)
atr_slow    = input.int(20,   "ATR lent (baseline)",              group=grpG, minval=1)
vol_k       = input.float(1.0,"Expansion si ATR rapide > ATR lent ×", group=grpG, minval=0.1, step=0.1)
brk_len     = input.int(10,   "Lookback cassure de range (barres)", group=grpG, minval=1)
show_go     = input.bool(true,"Afficher les flèches GO sur le chart", group=grpG)
go_realtime = input.bool(false,"GO en temps réel (sinon : à la clôture confirmée)", group=grpG, tooltip="Le SENS (table) est toujours en temps réel. Ce réglage ne concerne que le GO. Décoché (recommandé) : le GO ne se déclenche qu'à la CLÔTURE de la bougie -> pas de faux GO qui apparaît puis se retire. Coché : GO dès que la condition est remplie intrabar (plus tôt, mais peut flicker / repaint).")

// ── INPUTS : TABLEAU ─────────────────────────────────────────────
grpV = "=== TABLEAU ==="
tbl_pos  = input.string("Top Right", "Position du tableau",
     options=["Top Left","Top Center","Top Right","Middle Left","Middle Center","Middle Right","Bottom Left","Bottom Center","Bottom Right"], group=grpV)
tbl_size = input.string("normal", "Taille texte", options=["tiny","small","normal","large"], group=grpV)

// ── COULEURS ─────────────────────────────────────────────────────
c_long  = #2196F3
c_short = #F44336
c_range = color.rgb(130, 130, 150)
c_vol   = #FF9800
c_head  = color.new(#2A2E39, 0)

// ── MOTEUR DU SENS (1=LONG, 0=RANGE, -1=SHORT), par TF ───────────
f_dir_state(eng, tlen, fthr, mode, pct, alen, amult) =>
    a   = timeframe.in_seconds(timeframe.period) < 1800 ? 0.42 : 0.44
    src = (open + high + low + close) / 4
    var float sha = na
    sha := na(sha[1]) ? src : a * src + (1.0 - a) * sha[1]
    ema  = ta.ema(close, 33)
    int st = 0
    if eng == "Momentum"
        band = mode == "ATR" ? ta.atr(alen) * amult : ema * pct / 100.0
        d = sha - ema
        st := d > band ? 1 : d < -band ? -1 : 0
    else
        slope = (ema - ema[tlen]) / ema * 100.0
        st := slope > fthr ? 1 : slope < -fthr ? -1 : 0
    st

ha = ticker.heikinashi(syminfo.tickerid)
s_hi  = request.security(ha, tf_hi,  f_dir_state(engine, trend_len, flat_pct, dir_mode, dir_pct, dir_atr_len, dir_atr_mult), lookahead=barmerge.lookahead_off)
s_mid = request.security(ha, tf_mid, f_dir_state(engine, trend_len, flat_pct, dir_mode, dir_pct, dir_atr_len, dir_atr_mult), lookahead=barmerge.lookahead_off)
s_lo  = request.security(ha, tf_lo,  f_dir_state(engine, trend_len, flat_pct, dir_mode, dir_pct, dir_atr_len, dir_atr_mult), lookahead=barmerge.lookahead_off)

// ── BIAIS (4h + 1h) ──────────────────────────────────────────────
bias_state = s_hi == 1 and s_mid == 1 ? 1 : s_hi == -1 and s_mid == -1 ? -1 : 0

// ── DÉCLENCHEUR (sur le TF du chart) ─────────────────────────────
// 1) Expansion de volatilité : ATR court > ATR long
atrF    = ta.atr(atr_fast)
atrS    = ta.atr(atr_slow)
vol_exp = atrF > atrS * vol_k

// 2) Squeeze (optionnel) : Bollinger dans Keltner = marché calme
basis  = ta.sma(close, 20)
dev    = 2.0 * ta.stdev(close, 20)
kc_mid = ta.ema(close, 20)
kc_rng = 1.5 * ta.atr(20)
sqz_on = (basis - dev) > (kc_mid - kc_rng) and (basis + dev) < (kc_mid + kc_rng)
sqz_ok = not use_squeeze or (ta.barssince(sqz_on) <= brk_len)

// 3) Cassure de range (clôture au-delà du plus haut/bas récent)
brk_up = close > ta.highest(high, brk_len)[1]
brk_dn = close < ta.lowest(low,  brk_len)[1]

base_up = switch trig_mode
    "Expansion de volatilité seule" => vol_exp and close > open
    "Cassure de range seule"        => brk_up
    => vol_exp and brk_up
base_dn = switch trig_mode
    "Expansion de volatilité seule" => vol_exp and close < open
    "Cassure de range seule"        => brk_dn
    => vol_exp and brk_dn

trig_up = base_up and sqz_ok
trig_dn = base_dn and sqz_ok

// GO = uniquement dans le sens du biais HTF.
// Temps réel : déclenche intrabar. Sinon : seulement sur bougie CLÔTURÉE (anti-faux-GO).
go_confirmed = go_realtime or barstate.isconfirmed
go_long  = bias_state == 1  and trig_up and go_confirmed
go_short = bias_state == -1 and trig_dn and go_confirmed

// ── LIBELLÉS ─────────────────────────────────────────────────────
f_lbl(s) => s == 1 ? "LONG" : s == -1 ? "SHORT" : "RANGE"
f_col(s) => s == 1 ? c_long : s == -1 ? c_short : c_range

act_lbl = bias_state == 0 ? "ATTENDRE" : bias_state == 1 ? (go_long ? "🟢 GO LONG" : "PRÊT ▲ LONG") : (go_short ? "🔴 GO SHORT" : "PRÊT ▼ SHORT")
act_col = go_long ? c_long : go_short ? c_short : bias_state == 1 ? color.new(c_long, 55) : bias_state == -1 ? color.new(c_short, 55) : c_range

vol_lbl = vol_exp ? "Expansion" : "Calme"
vol_col = vol_exp ? color.new(c_vol, 0) : c_range

f_tflabel(tf) =>
    mins = timeframe.in_seconds(tf) / 60.0
    mins >= 1440 ? str.tostring(math.round(mins / 1440)) + "D" : mins >= 60 ? str.tostring(math.round(mins / 60)) + "H" : str.tostring(math.round(mins)) + "M"

f_pos(p) =>
    switch p
        "Top Left"      => position.top_left
        "Top Center"    => position.top_center
        "Top Right"     => position.top_right
        "Middle Left"   => position.middle_left
        "Middle Center" => position.middle_center
        "Middle Right"  => position.middle_right
        "Bottom Left"   => position.bottom_left
        "Bottom Center" => position.bottom_center
        "Bottom Right"  => position.bottom_right
        => position.top_right

f_sz(s) =>
    switch s
        "tiny"  => size.tiny
        "small" => size.small
        "large" => size.large
        => size.normal

// ── FLÈCHES GO (sur le chart) ────────────────────────────────────
plotshape(show_go and go_long,  "GO LONG",  style=shape.triangleup,   location=location.belowbar, color=c_long,  size=size.small, text="GO")
plotshape(show_go and go_short, "GO SHORT", style=shape.triangledown, location=location.abovebar, color=c_short, size=size.small, text="GO")

// ── TABLEAU ──────────────────────────────────────────────────────
var table t = na
if barstate.islast
    sz = f_sz(tbl_size)
    if na(t)
        t := table.new(f_pos(tbl_pos), 2, 6, border_width=1, border_color=color.new(color.gray, 40))
        table.cell(t, 0, 0, "🧭 DIRECTIONNOR", text_color=color.white, text_size=sz, bgcolor=c_head)
        table.cell(t, 1, 0, "", bgcolor=c_head)
        table.cell(t, 0, 1, f_tflabel(tf_hi),  text_color=color.silver, text_size=sz, bgcolor=c_head)
        table.cell(t, 0, 2, f_tflabel(tf_mid), text_color=color.silver, text_size=sz, bgcolor=c_head)
        table.cell(t, 0, 3, f_tflabel(tf_lo),  text_color=color.silver, text_size=sz, bgcolor=c_head)
        table.cell(t, 0, 4, "VOLAT.", text_color=color.silver, text_size=sz, bgcolor=c_head)
        table.cell(t, 1, 1, "", bgcolor=c_head)
        table.cell(t, 1, 2, "", bgcolor=c_head)
        table.cell(t, 1, 3, "", bgcolor=c_head)
        table.cell(t, 1, 4, "", bgcolor=c_head)
        table.cell(t, 0, 5, "", bgcolor=c_head)
        table.cell(t, 1, 5, "", bgcolor=c_head)
        table.merge_cells(t, 0, 0, 1, 0)  // titre
        table.merge_cells(t, 0, 5, 1, 5)  // action
    table.cell(t, 1, 1, f_lbl(s_hi),  text_color=color.white, text_size=sz, bgcolor=color.new(f_col(s_hi), 0))
    table.cell(t, 1, 2, f_lbl(s_mid), text_color=color.white, text_size=sz, bgcolor=color.new(f_col(s_mid), 0))
    table.cell(t, 1, 3, f_lbl(s_lo),  text_color=color.white, text_size=sz, bgcolor=color.new(f_col(s_lo), 0))
    table.cell(t, 1, 4, vol_lbl,      text_color=color.white, text_size=sz, bgcolor=color.new(vol_col, 0))
    table.cell(t, 0, 5, act_lbl,      text_color=color.white, text_size=sz, bgcolor=color.new(act_col, 0))

// ── ALERTES ──────────────────────────────────────────────────────
alertcondition(go_long,  "Directionnor GO LONG",  "Directionnor : GO LONG (biais 4h+1h + le marché part)")
alertcondition(go_short, "Directionnor GO SHORT", "Directionnor : GO SHORT (biais 4h+1h + le marché part)")
