//@version=6
// ════════════════════════════════════════════════════════════
// HA DIAGNOSTIC v3 — utilise close/open natifs du chart
// Sur chart HA, close = HA_close et open = HA_open nativement.
// Pas de recalcul manuel → pas de lag artificiel.
// ════════════════════════════════════════════════════════════
indicator("HA Diagnostic v3", overlay=true, max_labels_count=500)

// ── INPUTS ───────────────────────────────────────────────────
ema_len  = input.int(50, "Période EMA", minval=1, maxval=200,
     tooltip="Fais glisser lentement entre 10 et 60 pour trouver la période qui correspond à l'original")

mode = input.string("G — close > EMA(close, N)",
     "Mode",
     options=[
         "G — close > EMA(close, N)",
         "H — close[1] > EMA[1]  (+1 barre)",
         "I — close > open  (corps HA pur)"
     ],
     tooltip="G: même barre | H: si G est tjrs 1 barre en retard, essaie H | I: corps HA pur")

// ── CALCULS ──────────────────────────────────────────────────
ema_ref = ta.ema(close, ema_len)

col_bull = mode == "G — close > EMA(close, N)"  ? close    > ema_ref      :
           mode == "H — close[1] > EMA[1]  (+1 barre)" ? close[1] > ema_ref[1] :
           mode == "I — close > open  (corps HA pur)"  ? close    > open       :
           false

// ── BARCOLOR ─────────────────────────────────────────────────
barcolor(col_bull ? color.new(#2196F3, 0) : color.new(#F44336, 0))

// ── LIGNE EMA (blanche épaisse) ──────────────────────────────
plot(ema_ref, "EMA référence", color=color.white, linewidth=3)

// ── TRANSITIONS ──────────────────────────────────────────────
is_bull_flip = bar_index > 0 and col_bull and not col_bull[1]
is_bear_flip = bar_index > 0 and not col_bull and col_bull[1]

plotshape(is_bull_flip, style=shape.triangleup,   location=location.belowbar,
     color=color.lime, size=size.small, title="→ Bull")
plotshape(is_bear_flip, style=shape.triangledown, location=location.abovebar,
     color=color.red,  size=size.small, title="→ Bear")

// ── TABLE INFO ───────────────────────────────────────────────
var table t = table.new(position.top_right, 2, 3,
     bgcolor=color.new(color.black, 60), border_width=1)
if barstate.islast
    table.cell(t, 0, 0, "Mode",    text_color=color.white,  text_size=size.small)
    table.cell(t, 1, 0, str.substring(mode, 0, 1),
                                   text_color=color.yellow, text_size=size.normal)
    table.cell(t, 0, 1, "Période", text_color=color.white,  text_size=size.small)
    table.cell(t, 1, 1, str.tostring(ema_len),
                                   text_color=color.white,  text_size=size.normal)
    sig_col = col_bull ? color.new(#2196F3,0) : color.new(#F44336,0)
    table.cell(t, 0, 2, "Signal",  text_color=color.white,  text_size=size.small)
    table.cell(t, 1, 2, col_bull ? "BULL" : "BEAR",
                                   text_color=sig_col,      text_size=size.small)
