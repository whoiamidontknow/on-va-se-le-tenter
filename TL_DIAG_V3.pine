//@version=6
// ════════════════════════════════════════════════════════════
// TL DIAGNOSTIC V3 — with breakout
// ════════════════════════════════════════════════════════════
indicator("TL Diag V3", overlay=true,
     max_lines_count=10, max_labels_count=500)

// ══════════════════════════════════════════════════════════════
// INPUTS
// ══════════════════════════════════════════════════════════════
grp = "=== CONFIG ==="
piv_len      = input.int(10,    "Pivot Bars",              group=grp, minval=2, maxval=50)
buffer_pct   = input.float(0.1, "Touch Buffer %",          group=grp, minval=0.0, maxval=5.0, step=0.05)
new_piv_bars = input.int(100,   "Min Spacing (C/D only)",  group=grp, minval=0, maxval=500)
min_tc       = input.int(2,     "Min Touches",             group=grp, minval=2, maxval=10)
tl_col       = input.color(#C8C8A9, "TL Color",            group=grp)

grp_m = "=== METHODE ==="
method = input.string("G", "Méthode", options=["A","B","C","D","G","H","I"], group=grp_m)
brk_col = input.color(color.lime, "Breakout Color", group=grp_m)

// ══════════════════════════════════════════════════════════════
// PIVOTS (storage = 20)
// ══════════════════════════════════════════════════════════════
ph = ta.pivothigh(high, piv_len, piv_len)

var float[] ppp = array.new_float(0)
var int[]   ppb = array.new_int(0)

if not na(ph)
    array.unshift(ppp, ph)
    array.unshift(ppb, bar_index - piv_len)
    if array.size(ppp) > 20
        array.pop(ppp)
        array.pop(ppb)

// ══════════════════════════════════════════════════════════════
// BEST TL — computed every bar (tight loop for speed)
// 8×15 = 120 pairs × 20 touches = 2400 ops/bar
// ══════════════════════════════════════════════════════════════
var float bx1 = na
var float by1 = na
var float bsl = na
var int   btc = 0

if array.size(ppp) >= 2
    sz = array.size(ppp)
    _x1 = 0
    _y1 = 0.0
    _sl = 0.0
    _tc = 0
    _sc = -1e18
    found = false

    mi = math.min(sz - 1, 7)
    mj = math.min(sz - 1, 14)

    for i = 0 to mi
        for j = i + 1 to mj
            if j < sz
                x1v = array.get(ppb, j)
                y1v = array.get(ppp, j)
                x2v = array.get(ppb, i)
                y2v = array.get(ppp, i)

                if x2v > x1v
                    sl = (y2v - y1v) / (x2v - x1v)
                    if sl <= 0
                        spacing = x2v - x1v

                        keep = true
                        if method == "C" or method == "D"
                            keep := spacing >= new_piv_bars

                        if keep
                            tc = 0
                            for k = 0 to math.min(sz - 1, 19)
                                kx = array.get(ppb, k)
                                ky = array.get(ppp, k)
                                if kx >= x1v
                                    tly = y1v + sl * (kx - x1v)
                                    buf = tly * buffer_pct / 100.0
                                    if ky >= tly - buf and ky <= tly + buf
                                        tc += 1

                            if tc >= min_tc
                                tl_now = y1v + sl * (bar_index - x1v)
                                dist = math.abs(close - tl_now) / close * 100

                                sc = -1e18
                                if method == "A" or method == "C"
                                    sc := float(tc)
                                else if method == "B" or method == "D"
                                    sc := -dist
                                else if method == "G"
                                    sc := -dist + math.min(float(spacing) / 100.0, 2.0)
                                else if method == "H"
                                    if tl_now > close
                                        sc := -dist
                                else if method == "I"
                                    sc := -dist + math.min(float(spacing) / 100.0, 3.0) + float(tc) * 0.5

                                if sc > _sc
                                    _sc := sc
                                    _x1 := x1v
                                    _y1 := y1v
                                    _sl := sl
                                    _tc := tc
                                    found := true

    if found
        bx1 := float(_x1)
        by1 := _y1
        bsl := _sl
        btc := _tc

// ══════════════════════════════════════════════════════════════
// TL VALUE + BREAKOUT
// ══════════════════════════════════════════════════════════════
float tl_v = not na(bx1) ? by1 + bsl * (bar_index - bx1) : na
brk_sig = not na(tl_v) and ta.crossover(hlc3, tl_v)
plotshape(brk_sig, "Breakout", style=shape.circle,
     location=location.belowbar, color=brk_col, size=size.small)

// ══════════════════════════════════════════════════════════════
// DRAW TL (barstate.islast)
// ══════════════════════════════════════════════════════════════
var line[] tls = array.new_line(0)

if barstate.islast
    while array.size(tls) > 0
        line.delete(array.pop(tls))

    if not na(bx1)
        lx = int(bx1)
        ex = bar_index + 50
        ey = by1 + bsl * (ex - bx1)
        array.push(tls, line.new(lx, by1, ex, ey,
             xloc=xloc.bar_index, color=tl_col, width=2))

    // TABLE
    var table t = table.new(position.bottom_right, 2, 6,
         bgcolor=color.new(#1A1A1A, 10), border_width=1)
    table.cell(t, 0, 0, "TL Diag V3", text_color=color.white, bgcolor=color.new(color.navy, 20))
    table.cell(t, 1, 0, method, text_color=color.lime, bgcolor=color.new(color.navy, 20))
    table.cell(t, 0, 1, "Touches", text_color=color.gray)
    table.cell(t, 1, 1, str.tostring(btc), text_color=color.yellow)
    table.cell(t, 0, 2, "Slope", text_color=color.gray)
    table.cell(t, 1, 2, not na(bsl) ? str.tostring(bsl, "#.######") : "—", text_color=color.white)
    table.cell(t, 0, 3, "Pivots", text_color=color.gray)
    table.cell(t, 1, 3, str.tostring(array.size(ppp)), text_color=color.white)
    table.cell(t, 0, 4, "TL now", text_color=color.gray)
    table.cell(t, 1, 4, not na(tl_v) ? str.tostring(tl_v, format.mintick) : "—", text_color=color.white)
