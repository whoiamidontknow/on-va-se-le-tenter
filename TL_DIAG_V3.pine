//@version=6
// ════════════════════════════════════════════════════════════
// TL DIAGNOSTIC V3 — No Lookback Limit on TL Search
// ════════════════════════════════════════════════════════════
indicator("TL Diag V3", overlay=true,
     max_lines_count=100, max_labels_count=200)

// ══════════════════════════════════════════════════════════════
// INPUTS
// ══════════════════════════════════════════════════════════════
grp = "=== CONFIG ==="
piv_len      = input.int(10,    "Pivot Bars",                          group=grp, minval=2, maxval=50)
buffer_pct   = input.float(0.1, "Touch Buffer %",                     group=grp, minval=0.0, maxval=5.0, step=0.05)
new_piv_bars = input.int(100,   "Look for New Pivot High after X Bars", group=grp, minval=10, maxval=500)
min_tc       = input.int(2,     "Min Touches",                        group=grp, minval=2, maxval=10)
tl_col       = input.color(#C8C8A9, "TL Color",                       group=grp)
tl_w         = input.int(2,     "Width",                               group=grp, minval=1, maxval=5)

grp_m = "=== METHODE ==="
method = input.string("E", "Méthode", options=["A","B","C","D","E","F","G","H","I"], group=grp_m)
// A = Max touches (all history, no resistance check)
// B = Closest to price (all history)
// C = Max touches + min spacing between anchors = new_piv_bars
// D = Closest + min spacing
// E = Max touches + no price above TL between anchors (resistance)
// F = Closest + no price above between anchors
// NEW adaptive:
// G = Closest with spacing BONUS (not filter) — should work universally
// H = Closest, TL must be above price
// I = Score: proximité + bonus_spacing + bonus_touches

grp_v = "=== VISUALS ==="
show_piv   = input.bool(true, "Pivots",        group=grp_v)
show_touch = input.bool(true, "Touches ✦",     group=grp_v)
show_brk   = input.bool(true, "Breakout",      group=grp_v)
brk_col    = input.color(color.lime, "Brk Col", group=grp_v)

// ══════════════════════════════════════════════════════════════
// PIVOTS — stored over full history (no lookback limit)
// ══════════════════════════════════════════════════════════════
ph = ta.pivothigh(high, piv_len, piv_len)

var float[] ppp = array.new_float(0)
var int[]   ppb = array.new_int(0)

if not na(ph)
    array.unshift(ppp, ph)
    array.unshift(ppb, bar_index - piv_len)
    if array.size(ppp) > 100
        array.pop(ppp)
        array.pop(ppb)

plotshape(show_piv and not na(ph), "PH", style=shape.triangledown,
     location=location.abovebar, color=color.orange, size=size.tiny, offset=-piv_len)

// ══════════════════════════════════════════════════════════════
// FONCTIONS
// ══════════════════════════════════════════════════════════════
f_tl(x1, y1, slope, x) =>
    y1 + slope * (x - x1)

f_tc(x1, y1, slope, buf_pct) =>
    c = 0
    sz = array.size(ppp)
    for i = 0 to math.min(sz - 1, 99)
        px = array.get(ppb, i)
        py = array.get(ppp, i)
        if px >= x1
            tly = f_tl(x1, y1, slope, px)
            buf = tly * buf_pct / 100.0
            if py >= tly - buf and py <= tly + buf
                c += 1
    c

// Check if any high goes above TL between x1 and x2 only
f_resist_between(x1, y1, slope, x2) =>
    valid = true
    span = int(x2 - x1)
    for k = 0 to math.min(span, 499)
        bx = int(x1) + k
        offset = bar_index - bx
        if offset >= 0 and offset < 5000
            h = high[offset]
            tly = f_tl(x1, y1, slope, bx)
            if h > tly * 1.001  // tiny tolerance
                valid := false
                break
    valid

// ══════════════════════════════════════════════════════════════
// BEST TL — no lookback limit on search
// ══════════════════════════════════════════════════════════════
var float bx1 = na
var float by1 = na
var float bsl = na
var int   btc = 0

if array.size(ppp) >= 2
    sz = array.size(ppp)
    _x1 = 0.0
    _y1 = 0.0
    _sl = 0.0
    _tc = 0
    _sc = -999999.0
    found = false

    mi = math.min(sz - 1, 29)
    mj = math.min(sz - 1, 49)

    for i = 0 to mi
        for j = i + 1 to mj
            if j < sz
                x1v = array.get(ppb, j)
                y1v = array.get(ppp, j)
                x2v = array.get(ppb, i)
                y2v = array.get(ppp, i)

                if x2v > x1v
                    sl = (y2v - y1v) / (x2v - x1v)
                    if sl <= 0
                        spacing = x2v - x1v

                        // Methods C/D require minimum spacing
                        bool spacing_ok = true
                        if method == "C" or method == "D"
                            spacing_ok := spacing >= new_piv_bars

                        if spacing_ok
                            tc = f_tc(x1v, y1v, sl, buffer_pct)
                            if tc >= min_tc
                                // Methods E/F require resistance between anchors
                                bool resist_ok = true
                                if method == "E" or method == "F"
                                    resist_ok := f_resist_between(x1v, y1v, sl, x2v)

                                if resist_ok
                                    tl_now = f_tl(x1v, y1v, sl, bar_index)
                                    dist = math.abs(close - tl_now) / close * 100

                                    float score = na
                                    if method == "A" or method == "C" or method == "E"
                                        score := float(tc)
                                    else if method == "B" or method == "D" or method == "F"
                                        score := -dist
                                    else if method == "G"
                                        // Closest + spacing bonus (not filter)
                                        sp_bonus = math.min(float(spacing) / 100.0, 2.0)  // cap at 2.0
                                        score := -dist + sp_bonus
                                    else if method == "H"
                                        // Closest, TL must still be above current price
                                        if tl_now > close
                                            score := -dist
                                    else if method == "I"
                                        // Combined adaptive score
                                        prox = -dist
                                        sp_b = math.min(float(spacing) / 100.0, 3.0)
                                        tc_b = float(tc) * 0.5
                                        score := prox + sp_b + tc_b

                                    if not na(score) and score > _sc
                                        _sc := score
                                        _x1 := float(x1v)
                                        _y1 := y1v
                                        _sl := sl
                                        _tc := tc
                                        found := true

    if found
        bx1 := _x1
        by1 := _y1
        bsl := _sl
        btc := _tc

// ══════════════════════════════════════════════════════════════
// TL + BREAKOUT
// ══════════════════════════════════════════════════════════════
float tl_v = not na(bx1) ? f_tl(bx1, by1, bsl, bar_index) : na
brk_sig = show_brk and not na(tl_v) and ta.crossover(hlc3, tl_v)
plotshape(brk_sig, "Breakout", style=shape.circle,
     location=location.belowbar, color=brk_col, size=size.small)

// ══════════════════════════════════════════════════════════════
// DRAW
// ══════════════════════════════════════════════════════════════
var line[]  tls  = array.new_line(0)
var label[] lbls = array.new_label(0)

if barstate.islast
    while array.size(tls) > 0
        line.delete(array.pop(tls))
    while array.size(lbls) > 0
        label.delete(array.pop(lbls))

    if not na(bx1)
        lx = int(bx1)
        ex = bar_index + 50
        ey = f_tl(bx1, by1, bsl, ex)
        array.push(tls, line.new(lx, by1, ex, ey,
             xloc=xloc.bar_index, color=tl_col, width=tl_w))

        if show_touch
            for k = 0 to math.min(array.size(ppp) - 1, 99)
                kx = array.get(ppb, k)
                ky = array.get(ppp, k)
                if kx >= lx
                    tly = f_tl(bx1, by1, bsl, kx)
                    buf = tly * buffer_pct / 100.0
                    if ky >= tly - buf and ky <= tly + buf
                        array.push(lbls, label.new(kx, ky, "✦",
                             xloc=xloc.bar_index, textcolor=color.yellow,
                             color=color.new(color.yellow, 100),
                             style=label.style_label_down, size=size.small))

// ══════════════════════════════════════════════════════════════
// TABLE
// ══════════════════════════════════════════════════════════════
if barstate.islast
    var table t = table.new(position.bottom_right, 2, 13,
         bgcolor=color.new(#1A1A1A, 10), border_width=1,
         border_color=color.rgb(60, 60, 60))

    table.cell(t, 0, 0, "TL Diag V3", text_color=color.white, text_size=size.small, bgcolor=color.new(color.navy, 20))
    table.cell(t, 1, 0, method, text_color=color.lime, text_size=size.small, bgcolor=color.new(color.navy, 20))

    descs = array.from(
         "A: Max touches (all history)",
         "B: Closest to price (all hist)",
         "C: Max touches + min spacing",
         "D: Closest + min spacing",
         "E: Max tc + resist between pts",
         "F: Closest + resist between pts",
         "G: Closest + spacing bonus",
         "H: Closest, TL above price",
         "I: Combined adaptive score")

    for i = 0 to 8
        d = array.get(descs, i)
        letter = str.substring(d, 0, 1)
        act = letter == method
        table.cell(t, 0, i + 1, d, text_color=act ? color.lime : color.gray, text_size=size.small)
        table.cell(t, 1, i + 1, act ? "◄" : "", text_color=color.lime, text_size=size.small)

    table.cell(t, 0, 10, "Touches", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 10, str.tostring(btc), text_color=color.yellow, text_size=size.small)
    table.cell(t, 0, 11, "Slope", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 11, not na(bsl) ? str.tostring(bsl, "#.######") : "—", text_color=color.white, text_size=size.small)
    table.cell(t, 0, 12, "Pivots stockés", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 12, str.tostring(array.size(ppp)), text_color=color.white, text_size=size.small)
