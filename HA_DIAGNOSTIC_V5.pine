//@version=6
// ════════════════════════════════════════════════════════════
// HA DIAGNOSTIC v10 — MOYENATOR HYPOTHESIS
// ════════════════════════════════════════════════════════════
// RÉVÉLATION : Section HEISHINATOR V4 n'a AUCUN paramètre
// d'indicateur → la logique vient du MOYENATOR V5
//
// MOYENATOR V5 = 2 MAs "Clôture" avec fill cyan/rouge OPAQUE
// → Heishinator suit la même condition que Moyenator (MA1>MA2)
//
// Test systématique des périodes et types de MA cross
// ════════════════════════════════════════════════════════════
indicator("HA Diagnostic v10", overlay=true, max_labels_count=500)

grp = "=== CONFIG ==="

mode = input.string("M1 — EMA9>EMA21", "Mode",
     options=[
         // ── EMA Cross (les plus communs) ──
         "M1 — EMA9>EMA21",
         "M2 — EMA12>EMA26",
         "M3 — EMA13>EMA21",
         "M4 — EMA20>EMA50",
         "M5 — EMA5>EMA20",
         "M6 — EMA8>EMA21",
         "M7 — EMA10>EMA30",
         "M8 — EMA13>EMA34",
         // ── SMA Cross ──
         "M9 — SMA9>SMA21",
         "M10 — SMA5>SMA20",
         "M11 — SMA13>SMA34",
         "M12 — SMA20>SMA50",
         // ── WMA Cross ──
         "M13 — WMA9>WMA21",
         "M14 — WMA13>WMA34",
         // ── HMA Cross ──
         "M15 — HMA9>HMA21",
         "M16 — HMA13>HMA21",
         // ── VWMA Cross ──
         "M17 — VWMA9>VWMA21",
         "M18 — VWMA13>VWMA34",
         // ── Params custom ajustables ──
         "M19 — Custom MA1>MA2",
         "M20 — Custom close>MA"
     ], group=grp)

// Paramètres custom
ma_type  = input.string("EMA", "Type MA (M19/M20)", options=["EMA","SMA","WMA","HMA"], group=grp)
ma1_len  = input.int(9,  "MA1 Période (M19/M20)", minval=1, group=grp)
ma2_len  = input.int(21, "MA2 Période (M19)", minval=1, group=grp)

// ── FONCTIONS ─────────────────────────────────────────────
hma(src, len) =>
    half = math.floor(len / 2)
    sqrtLen = math.round(math.sqrt(len))
    ta.wma(2 * ta.wma(src, half) - ta.wma(src, len), sqrtLen)

ma(src, len, t) =>
    t == "EMA" ? ta.ema(src, len) :
    t == "SMA" ? ta.sma(src, len) :
    t == "WMA" ? ta.wma(src, len) :
    hma(src, len)

// ── MAs pré-calculées ────────────────────────────────────
ema9   = ta.ema(close, 9)
ema12  = ta.ema(close, 12)
ema13  = ta.ema(close, 13)
ema20  = ta.ema(close, 20)
ema21  = ta.ema(close, 21)
ema26  = ta.ema(close, 26)
ema30  = ta.ema(close, 30)
ema34  = ta.ema(close, 34)
ema50  = ta.ema(close, 50)
ema5   = ta.ema(close, 5)
ema8   = ta.ema(close, 8)
ema10  = ta.ema(close, 10)

sma9   = ta.sma(close, 9)
sma13  = ta.sma(close, 13)
sma20  = ta.sma(close, 20)
sma21  = ta.sma(close, 21)
sma34  = ta.sma(close, 34)
sma50  = ta.sma(close, 50)
sma5   = ta.sma(close, 5)

wma9   = ta.wma(close, 9)
wma13  = ta.wma(close, 13)
wma21  = ta.wma(close, 21)
wma34  = ta.wma(close, 34)

hma9   = hma(close, 9)
hma13  = hma(close, 13)
hma21  = hma(close, 21)

vwma9  = ta.vwma(close, 9)
vwma13 = ta.vwma(close, 13)
vwma21 = ta.vwma(close, 21)
vwma34 = ta.vwma(close, 34)

ma1_custom = ma(close, ma1_len, ma_type)
ma2_custom = ma(close, ma2_len, ma_type)

// ── SÉLECTION ────────────────────────────────────────────────
col_bull =
     mode == "M1 — EMA9>EMA21"    ? (ema9   > ema21) :
     mode == "M2 — EMA12>EMA26"   ? (ema12  > ema26) :
     mode == "M3 — EMA13>EMA21"   ? (ema13  > ema21) :
     mode == "M4 — EMA20>EMA50"   ? (ema20  > ema50) :
     mode == "M5 — EMA5>EMA20"    ? (ema5   > ema20) :
     mode == "M6 — EMA8>EMA21"    ? (ema8   > ema21) :
     mode == "M7 — EMA10>EMA30"   ? (ema10  > ema30) :
     mode == "M8 — EMA13>EMA34"   ? (ema13  > ema34) :
     mode == "M9 — SMA9>SMA21"    ? (sma9   > sma21) :
     mode == "M10 — SMA5>SMA20"   ? (sma5   > sma20) :
     mode == "M11 — SMA13>SMA34"  ? (sma13  > sma34) :
     mode == "M12 — SMA20>SMA50"  ? (sma20  > sma50) :
     mode == "M13 — WMA9>WMA21"   ? (wma9   > wma21) :
     mode == "M14 — WMA13>WMA34"  ? (wma13  > wma34) :
     mode == "M15 — HMA9>HMA21"   ? (hma9   > hma21) :
     mode == "M16 — HMA13>HMA21"  ? (hma13  > hma21) :
     mode == "M17 — VWMA9>VWMA21" ? (vwma9  > vwma21) :
     mode == "M18 — VWMA13>VWMA34"? (vwma13 > vwma34) :
     mode == "M19 — Custom MA1>MA2"? (ma1_custom > ma2_custom) :
     mode == "M20 — Custom close>MA"? (close > ma1_custom) :
     false

// ── BGCOLOR ──────────────────────────────────────────────────
bgcolor(col_bull ? color.new(#2196F3, 78) : color.new(#F44336, 78))

// ── PLOTS des MAs actives ─────────────────────────────────────
ma_a = mode == "M1 — EMA9>EMA21" or mode == "M6 — EMA8>EMA21" or mode == "M3 — EMA13>EMA21" ?
     (mode == "M1 — EMA9>EMA21" ? ema9 : mode == "M6 — EMA8>EMA21" ? ema8 : ema13) :
     mode == "M2 — EMA12>EMA26" ? ema12 :
     mode == "M4 — EMA20>EMA50" ? ema20 :
     mode == "M5 — EMA5>EMA20"  ? ema5  :
     mode == "M7 — EMA10>EMA30" ? ema10 :
     mode == "M8 — EMA13>EMA34" ? ema13 :
     mode == "M9 — SMA9>SMA21"  ? sma9  :
     mode == "M10 — SMA5>SMA20" ? sma5  :
     mode == "M11 — SMA13>SMA34"? sma13 :
     mode == "M12 — SMA20>SMA50"? sma20 :
     mode == "M13 — WMA9>WMA21" ? wma9  :
     mode == "M14 — WMA13>WMA34"? wma13 :
     mode == "M15 — HMA9>HMA21" ? hma9  :
     mode == "M16 — HMA13>HMA21"? hma13 :
     mode == "M17 — VWMA9>VWMA21" ? vwma9  :
     mode == "M18 — VWMA13>VWMA34"? vwma13 :
     ma1_custom

ma_b = mode == "M1 — EMA9>EMA21" or mode == "M6 — EMA8>EMA21" or mode == "M3 — EMA13>EMA21" ? ema21 :
     mode == "M2 — EMA12>EMA26" ? ema26 :
     mode == "M4 — EMA20>EMA50" ? ema50 :
     mode == "M5 — EMA5>EMA20"  ? ema20 :
     mode == "M7 — EMA10>EMA30" ? ema30 :
     mode == "M8 — EMA13>EMA34" ? ema34 :
     mode == "M9 — SMA9>SMA21"  ? sma21 :
     mode == "M10 — SMA5>SMA20" ? sma20 :
     mode == "M11 — SMA13>SMA34"? sma34 :
     mode == "M12 — SMA20>SMA50"? sma50 :
     mode == "M13 — WMA9>WMA21" ? wma21 :
     mode == "M14 — WMA13>WMA34"? wma34 :
     mode == "M15 — HMA9>HMA21" ? hma21 :
     mode == "M16 — HMA13>HMA21"? hma21 :
     mode == "M17 — VWMA9>VWMA21" ? vwma21 :
     mode == "M18 — VWMA13>VWMA34"? vwma34 :
     ma2_custom

plot(ma_a, "MA1", color=color.new(color.lime, 0), linewidth=2)
plot(ma_b, "MA2", color=color.new(color.orange, 0), linewidth=1)

// ── TRANSITIONS ──────────────────────────────────────────────
bull_flip = bar_index > 0 and col_bull     and not col_bull[1]
bear_flip = bar_index > 0 and not col_bull and     col_bull[1]
plotshape(bull_flip, style=shape.triangleup,   location=location.belowbar, color=color.lime, size=size.small)
plotshape(bear_flip, style=shape.triangledown, location=location.abovebar, color=color.red,  size=size.small)

// ── TABLE ─────────────────────────────────────────────────────
var table t = table.new(position.top_right, 2, 8,
     bgcolor=color.new(color.black, 60), border_width=1)

if barstate.islast
    table.cell(t, 0, 0, "Mode",      text_color=color.white, text_size=size.small, bgcolor=color.new(color.navy, 20))
    table.cell(t, 1, 0, str.substring(mode, 0, 2), text_color=color.yellow, text_size=size.normal, bgcolor=color.new(color.navy, 20))
    table.cell(t, 0, 1, "MA1",       text_color=color.white, text_size=size.small)
    table.cell(t, 1, 1, str.tostring(ma_a, format.mintick), text_color=color.lime, text_size=size.small)
    table.cell(t, 0, 2, "MA2",       text_color=color.white, text_size=size.small)
    table.cell(t, 1, 2, str.tostring(ma_b, format.mintick), text_color=color.orange, text_size=size.small)
    table.cell(t, 0, 3, "MA1>MA2",   text_color=color.white, text_size=size.small)
    table.cell(t, 1, 3, (ma_a > ma_b) ? "OUI ▲" : "NON ▼",
         text_color=(ma_a > ma_b) ? color.lime : color.red, text_size=size.small)
    table.cell(t, 0, 4, "close>MA1", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 4, (close > ma_a) ? "OUI ▲" : "NON ▼",
         text_color=(close > ma_a) ? color.lime : color.red, text_size=size.small)
    table.cell(t, 0, 5, "SIGNAL",    text_color=color.white, text_size=size.small)
    table.cell(t, 1, 5, col_bull ? "▲ BULL" : "▼ BEAR",
         text_color=col_bull ? color.lime : color.red, text_size=size.normal,
         bgcolor=col_bull ? color.new(color.blue, 80) : color.new(color.red, 80))
    table.cell(t, 0, 6, "EMA9",      text_color=color.white, text_size=size.small)
    table.cell(t, 1, 6, (ema9>ema21) ? "9>21▲" : "9<21▼", text_color=(ema9>ema21)?color.lime:color.red, text_size=size.small)
    table.cell(t, 0, 7, "EMA13",     text_color=color.white, text_size=size.small)
    table.cell(t, 1, 7, (ema13>ema21) ? "13>21▲" : "13<21▼", text_color=(ema13>ema21)?color.lime:color.red, text_size=size.small)
