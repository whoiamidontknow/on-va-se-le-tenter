//@version=6
// ════════════════════════════════════════════════════════════
// HA DIAGNOSTIC v9 — TRIPLE ST + SCORE >= 1
// ════════════════════════════════════════════════════════════
// Nouvelle hypothèse : 3 SuperTrends dans le paramètre string
//   0,5 / 33  → ST1
//   0,35 / 14 → ST2
//   0,5 / 20  → ST3  ← NOUVEAU
// "Bull Score: 1/3" + candles BLEUES → coloring = score >= 1
//
// MODES supplémentaires : paramètres standards (3,10)
// ════════════════════════════════════════════════════════════
indicator("HA Diagnostic v9", overlay=true, max_labels_count=500)

grp = "=== CONFIG ==="

mode = input.string("V1 — 3ST score≥1", "Mode",
     options=[
         // Hypothèse principale : 3 SuperTrends, score >= 1
         "V1 — 3ST score≥1",
         "V2 — 3ST score≥2",
         "V3 — 3ST score≥3",
         // ST3 seul
         "V4 — ST3(0.5,20) seul",
         // Combos avec ST3
         "V5 — ST1 OR ST3",
         "V6 — ST2 OR ST3",
         "V7 — ST1 AND ST3",
         "V8 — ST2 AND ST3",
         // Standard params ST(3,10)
         "V9 — ST_STD(3,10) seul",
         "V10 — ST_STD score≥1 [STD,EMA20,VWAP]",
         "V11 — ST_STD score≥2 [STD,EMA20,VWAP]",
         "V12 — ST_STD AND EMA20",
         "V13 — ST_STD AND VWAP",
         // Autres params standards
         "V14 — ST(2,10) seul",
         "V15 — ST(1,10) seul",
         "V16 — ST(2,7) seul",
         "V17 — ST(1.5,14) seul",
         // Score >= 1 avec params custom
         "V18 — score≥1 [ST1,ST2,EMA20]",
         "V19 — score≥1 [ST1,ST2,VWAP]",
         "V20 — score≥1 [ST1,ST2,body]"
     ], group=grp)

// Paramètres ST1, ST2, ST3
st1_factor = input.float(0.5,  "ST1 Factor", step=0.05, minval=0.1, group=grp)
st1_atr    = input.int(33,     "ST1 ATR",    minval=1, group=grp)
st2_factor = input.float(0.35, "ST2 Factor", step=0.05, minval=0.1, group=grp)
st2_atr    = input.int(14,     "ST2 ATR",    minval=1, group=grp)
st3_factor = input.float(0.5,  "ST3 Factor", step=0.05, minval=0.1, group=grp)
st3_atr    = input.int(20,     "ST3 ATR",    minval=1, group=grp)
std_factor = input.float(3.0,  "STD Factor", step=0.1, minval=0.1, group=grp)
std_atr    = input.int(10,     "STD ATR",    minval=1, group=grp)
ema_len    = input.int(20,     "EMA Période", minval=1, group=grp)

// ── CALCULS ──────────────────────────────────────────────────
[st1_line, st1_dir]   = ta.supertrend(st1_factor, st1_atr)
[st2_line, st2_dir]   = ta.supertrend(st2_factor, st2_atr)
[st3_line, st3_dir]   = ta.supertrend(st3_factor, st3_atr)
[std_line, std_dir]   = ta.supertrend(std_factor, std_atr)
[_l14, dir_v14]  = ta.supertrend(2.0, 10)
[_l15, dir_v15]  = ta.supertrend(1.0, 10)
[_l16, dir_v16]  = ta.supertrend(2.0, 7)
[_l17, dir_v17]  = ta.supertrend(1.5, 14)

s_st1  = st1_dir < 0
s_st2  = st2_dir < 0
s_st3  = st3_dir < 0
s_std  = std_dir < 0
s_e20  = close > ta.ema(close, ema_len)
s_vwap = close > ta.vwap
s_body = close > open

// Scores
score_3st  = (s_st1?1:0) + (s_st2?1:0) + (s_st3?1:0)
score_stdev = (s_std?1:0) + (s_e20?1:0) + (s_vwap?1:0)
score_12e  = (s_st1?1:0) + (s_st2?1:0) + (s_e20?1:0)
score_12v  = (s_st1?1:0) + (s_st2?1:0) + (s_vwap?1:0)
score_12b  = (s_st1?1:0) + (s_st2?1:0) + (s_body?1:0)

// ── SÉLECTION ────────────────────────────────────────────────
col_bull =
     mode == "V1 — 3ST score≥1"                   ? (score_3st >= 1) :
     mode == "V2 — 3ST score≥2"                   ? (score_3st >= 2) :
     mode == "V3 — 3ST score≥3"                   ? (score_3st >= 3) :
     mode == "V4 — ST3(0.5,20) seul"               ? s_st3 :
     mode == "V5 — ST1 OR ST3"                     ? (s_st1 or s_st3) :
     mode == "V6 — ST2 OR ST3"                     ? (s_st2 or s_st3) :
     mode == "V7 — ST1 AND ST3"                    ? (s_st1 and s_st3) :
     mode == "V8 — ST2 AND ST3"                    ? (s_st2 and s_st3) :
     mode == "V9 — ST_STD(3,10) seul"              ? s_std :
     mode == "V10 — ST_STD score≥1 [STD,EMA20,VWAP]" ? (score_stdev >= 1) :
     mode == "V11 — ST_STD score≥2 [STD,EMA20,VWAP]" ? (score_stdev >= 2) :
     mode == "V12 — ST_STD AND EMA20"              ? (s_std and s_e20) :
     mode == "V13 — ST_STD AND VWAP"               ? (s_std and s_vwap) :
     mode == "V14 — ST(2,10) seul"                 ? (dir_v14 < 0) :
     mode == "V15 — ST(1,10) seul"                 ? (dir_v15 < 0) :
     mode == "V16 — ST(2,7) seul"                  ? (dir_v16 < 0) :
     mode == "V17 — ST(1.5,14) seul"               ? (dir_v17 < 0) :
     mode == "V18 — score≥1 [ST1,ST2,EMA20]"       ? (score_12e >= 1) :
     mode == "V19 — score≥1 [ST1,ST2,VWAP]"        ? (score_12v >= 1) :
     mode == "V20 — score≥1 [ST1,ST2,body]"        ? (score_12b >= 1) :
     false

// ── BGCOLOR ──────────────────────────────────────────────────
bgcolor(col_bull ? color.new(#2196F3, 78) : color.new(#F44336, 78))

// ── PLOTS ─────────────────────────────────────────────────────
plot(st1_line, "ST1(0.5,33)",
     color=s_st1 ? color.new(color.lime, 0) : color.new(color.red, 0), linewidth=2)
plot(st2_line, "ST2(0.35,14)",
     color=s_st2 ? color.new(color.aqua, 30) : color.new(color.orange, 30), linewidth=1)
plot(st3_line, "ST3(0.5,20)",
     color=s_st3 ? color.new(color.yellow, 20) : color.new(color.fuchsia, 20), linewidth=1)

// ── TRANSITIONS ──────────────────────────────────────────────
bull_flip = bar_index > 0 and col_bull     and not col_bull[1]
bear_flip = bar_index > 0 and not col_bull and     col_bull[1]
plotshape(bull_flip, style=shape.triangleup,   location=location.belowbar, color=color.lime, size=size.small)
plotshape(bear_flip, style=shape.triangledown, location=location.abovebar, color=color.red,  size=size.small)

// ── TABLE ─────────────────────────────────────────────────────
var table t = table.new(position.top_right, 2, 12,
     bgcolor=color.new(color.black, 60), border_width=1)

if barstate.islast
    table.cell(t, 0, 0, "Signal",         text_color=color.white, text_size=size.small, bgcolor=color.new(color.navy, 20))
    table.cell(t, 1, 0, "État",           text_color=color.white, text_size=size.small, bgcolor=color.new(color.navy, 20))
    table.cell(t, 0, 1, "ST1(0.5/33)",    text_color=color.white, text_size=size.small)
    table.cell(t, 1, 1, s_st1  ? "▲ BULL" : "▼ BEAR", text_color=s_st1  ? #2196F3 : #F44336, text_size=size.small)
    table.cell(t, 0, 2, "ST2(0.35/14)",   text_color=color.white, text_size=size.small)
    table.cell(t, 1, 2, s_st2  ? "▲ BULL" : "▼ BEAR", text_color=s_st2  ? #2196F3 : #F44336, text_size=size.small)
    table.cell(t, 0, 3, "ST3(0.5/20)",    text_color=color.white, text_size=size.small)
    table.cell(t, 1, 3, s_st3  ? "▲ BULL" : "▼ BEAR", text_color=s_st3  ? #2196F3 : #F44336, text_size=size.small)
    table.cell(t, 0, 4, "ST_STD(3/10)",   text_color=color.white, text_size=size.small)
    table.cell(t, 1, 4, s_std  ? "▲ BULL" : "▼ BEAR", text_color=s_std  ? #2196F3 : #F44336, text_size=size.small)
    table.cell(t, 0, 5, "EMA(20)",         text_color=color.white, text_size=size.small)
    table.cell(t, 1, 5, s_e20  ? "▲ BULL" : "▼ BEAR", text_color=s_e20  ? #2196F3 : #F44336, text_size=size.small)
    table.cell(t, 0, 6, "VWAP",           text_color=color.white, text_size=size.small)
    table.cell(t, 1, 6, s_vwap ? "▲ BULL" : "▼ BEAR", text_color=s_vwap ? #2196F3 : #F44336, text_size=size.small)
    table.cell(t, 0, 7, "Corps HA",       text_color=color.white, text_size=size.small)
    table.cell(t, 1, 7, s_body ? "▲ BULL" : "▼ BEAR", text_color=s_body ? #2196F3 : #F44336, text_size=size.small)
    table.cell(t, 0, 8, "Score 3ST",      text_color=color.white, text_size=size.small)
    table.cell(t, 1, 8, str.tostring(score_3st) + "/3",
         text_color=score_3st >= 1 ? #2196F3 : #F44336, text_size=size.normal)
    table.cell(t, 0, 9, "Score STD",      text_color=color.white, text_size=size.small)
    table.cell(t, 1, 9, str.tostring(score_stdev) + "/3",
         text_color=score_stdev >= 1 ? #2196F3 : #F44336, text_size=size.normal)
    table.cell(t, 0, 10, "Mode",          text_color=color.white, text_size=size.small)
    table.cell(t, 1, 10, str.substring(mode, 0, 2), text_color=color.yellow, text_size=size.normal)
    table.cell(t, 0, 11, "ACTIF",         text_color=color.white, text_size=size.small)
    table.cell(t, 1, 11, col_bull ? "▲ BULL" : "▼ BEAR",
         text_color=col_bull ? color.lime : color.red, text_size=size.normal,
         bgcolor=col_bull ? color.new(color.blue, 80) : color.new(color.red, 80))
