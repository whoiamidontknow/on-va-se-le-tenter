//@version=6
// ════════════════════════════════════════════════════════════
// HA DIAGNOSTIC v16 — F43 + source HA vs raw OHLC
// ════════════════════════════════════════════════════════════
// v15 F42 OK sur 2m/15m, F44 OK sur 1h, les deux OK sur 4h.
// → v16 teste F43 (voisin jamais testé) + switche la source
//   entre HA (chart natif) et raw OHLC (via ticker.standard).
// Objectif : trouver le mode cohérent sur TOUS les TFs.
// ════════════════════════════════════════════════════════════
indicator("HA Diagnostic v16", overlay=true, max_labels_count=500)

grp = "=== CONFIG ==="

mode = input.string("F43 — α0.43 HA", "Mode",
     options=[
         // ── HA source (open/high/low/close natifs du chart HA) ──
         "F42 — α0.42 HA",
         "F425 — α0.425 HA",
         "F43 — α0.43 HA",
         "F435 — α0.435 HA",
         "F44 — α0.44 HA",
         // ── Raw source (OHLC réels via ticker.standard) ──
         "R42 — α0.42 raw",
         "R425 — α0.425 raw",
         "R43 — α0.43 raw",
         "R435 — α0.435 raw",
         "R44 — α0.44 raw",
         // ── Hybride: SHA sur HA, EMA33 sur raw ──
         "M42 — SHA42 HA vs EMA33 raw",
         "M43 — SHA43 HA vs EMA33 raw",
         "M44 — SHA44 HA vs EMA33 raw",
         // ── Réf sans SHA ──
         "Z — raw close>EMA33 raw"
     ], group=grp)

// ── Source HA (chart natif) ─────────────────────────────────
sha_src_ha = (open + high + low + close) / 4

var float sha_ha42 = na
sha_ha42 := na(sha_ha42[1]) ? sha_src_ha : 0.420 * sha_src_ha + 0.580 * sha_ha42[1]
var float sha_ha425 = na
sha_ha425 := na(sha_ha425[1]) ? sha_src_ha : 0.425 * sha_src_ha + 0.575 * sha_ha425[1]
var float sha_ha43 = na
sha_ha43 := na(sha_ha43[1]) ? sha_src_ha : 0.430 * sha_src_ha + 0.570 * sha_ha43[1]
var float sha_ha435 = na
sha_ha435 := na(sha_ha435[1]) ? sha_src_ha : 0.435 * sha_src_ha + 0.565 * sha_ha435[1]
var float sha_ha44 = na
sha_ha44 := na(sha_ha44[1]) ? sha_src_ha : 0.440 * sha_src_ha + 0.560 * sha_ha44[1]

ema33_ha = ta.ema(close, 33)

// ── Source raw OHLC (via ticker.standard) ───────────────────
raw_tkr = ticker.standard(syminfo.tickerid)
[raw_o, raw_h, raw_l, raw_c] = request.security(raw_tkr, timeframe.period, [open, high, low, close], lookahead=barmerge.lookahead_off)

sha_src_rw = (raw_o + raw_h + raw_l + raw_c) / 4

var float sha_rw42 = na
sha_rw42 := na(sha_rw42[1]) ? sha_src_rw : 0.420 * sha_src_rw + 0.580 * sha_rw42[1]
var float sha_rw425 = na
sha_rw425 := na(sha_rw425[1]) ? sha_src_rw : 0.425 * sha_src_rw + 0.575 * sha_rw425[1]
var float sha_rw43 = na
sha_rw43 := na(sha_rw43[1]) ? sha_src_rw : 0.430 * sha_src_rw + 0.570 * sha_rw43[1]
var float sha_rw435 = na
sha_rw435 := na(sha_rw435[1]) ? sha_src_rw : 0.435 * sha_src_rw + 0.565 * sha_rw435[1]
var float sha_rw44 = na
sha_rw44 := na(sha_rw44[1]) ? sha_src_rw : 0.440 * sha_src_rw + 0.560 * sha_rw44[1]

ema33_rw = ta.ema(raw_c, 33)

// ── Sélection source + MA ───────────────────────────────────
src_val =
     mode == "F42 — α0.42 HA"   ? sha_ha42 :
     mode == "F425 — α0.425 HA" ? sha_ha425 :
     mode == "F43 — α0.43 HA"   ? sha_ha43 :
     mode == "F435 — α0.435 HA" ? sha_ha435 :
     mode == "F44 — α0.44 HA"   ? sha_ha44 :
     mode == "R42 — α0.42 raw"  ? sha_rw42 :
     mode == "R425 — α0.425 raw" ? sha_rw425 :
     mode == "R43 — α0.43 raw"  ? sha_rw43 :
     mode == "R435 — α0.435 raw" ? sha_rw435 :
     mode == "R44 — α0.44 raw"  ? sha_rw44 :
     mode == "M42 — SHA42 HA vs EMA33 raw" ? sha_ha42 :
     mode == "M43 — SHA43 HA vs EMA33 raw" ? sha_ha43 :
     mode == "M44 — SHA44 HA vs EMA33 raw" ? sha_ha44 :
     mode == "Z — raw close>EMA33 raw" ? raw_c :
     na

use_raw_ma = mode == "R42 — α0.42 raw" or mode == "R425 — α0.425 raw"
     or mode == "R43 — α0.43 raw" or mode == "R435 — α0.435 raw"
     or mode == "R44 — α0.44 raw"
     or mode == "M42 — SHA42 HA vs EMA33 raw"
     or mode == "M43 — SHA43 HA vs EMA33 raw"
     or mode == "M44 — SHA44 HA vs EMA33 raw"
     or mode == "Z — raw close>EMA33 raw"

ma1_val = use_raw_ma ? ema33_rw : ema33_ha

col_bull = src_val > ma1_val

// ── BGCOLOR ─────────────────────────────────────────────────
bgcolor(col_bull ? color.new(#2196F3, 78) : color.new(#F44336, 78))

// ── PLOTS ───────────────────────────────────────────────────
plot(ma1_val, "EMA33",    color=color.new(color.black,  0), linewidth=2)
plot(src_val, "Src smoothed", color=color.new(color.orange, 0), linewidth=1)

// ── TRANSITIONS ─────────────────────────────────────────────
bull_flip = bar_index > 0 and col_bull     and not col_bull[1]
bear_flip = bar_index > 0 and not col_bull and     col_bull[1]
plotshape(bull_flip, style=shape.triangleup,   location=location.belowbar, color=color.lime, size=size.small)
plotshape(bear_flip, style=shape.triangledown, location=location.abovebar, color=color.red,  size=size.small)

// ── TABLE ───────────────────────────────────────────────────
var table t = table.new(position.top_right, 2, 5,
     bgcolor=color.new(color.black, 60), border_width=1)

if barstate.islast
    table.cell(t, 0, 0, "Mode", text_color=color.white, text_size=size.small, bgcolor=color.new(color.navy, 20))
    table.cell(t, 1, 0, str.substring(mode, 0, 5), text_color=color.yellow, text_size=size.normal, bgcolor=color.new(color.navy, 20))
    table.cell(t, 0, 1, "Src",  text_color=color.white, text_size=size.small)
    table.cell(t, 1, 1, str.tostring(src_val, format.mintick), text_color=color.yellow, text_size=size.small)
    table.cell(t, 0, 2, "EMA33", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 2, str.tostring(ma1_val, format.mintick), text_color=color.yellow, text_size=size.small)
    table.cell(t, 0, 3, "Δ",    text_color=color.white, text_size=size.small)
    table.cell(t, 1, 3, str.tostring(src_val - ma1_val, format.mintick), text_color=(src_val>ma1_val)?color.lime:color.red, text_size=size.small)
    table.cell(t, 0, 4, "SIG",  text_color=color.white, text_size=size.small)
    table.cell(t, 1, 4, col_bull ? "▲" : "▼",
         text_color=col_bull ? color.lime : color.red, text_size=size.normal,
         bgcolor=col_bull ? color.new(color.blue, 80) : color.new(color.red, 80))
