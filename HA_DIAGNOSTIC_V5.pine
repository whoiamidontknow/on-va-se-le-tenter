//@version=6
// ════════════════════════════════════════════════════════════
// HA DIAGNOSTIC v7 — Nouvelles hypothèses TF courante
// Observation : modes 1-20 (v6) échouent tous.
// Piste : paramètre "75" visible dans config Heishinator
//         → EMA(75) non testé, combinaisons avec ST/VWAP
// Aussi : double lissage (DEMA), TEMA, HMA(75)
// ════════════════════════════════════════════════════════════
indicator("HA Diagnostic v7", overlay=true, max_labels_count=500)

grp = "=== CONFIG ==="

mode = input.string("1 — EMA(75)", "Mode",
     options=[
         "1 — EMA(75)",
         "2 — EMA(75) × corps HA",
         "3 — ST × EMA(75)",
         "4 — ST × EMA(75) × corps HA",
         "5 — VWAP × EMA(75)",
         "6 — score≥2 [ST, EMA(75), corps HA]",
         "7 — score≥2 [ST, EMA(75), VWAP]",
         "8 — DEMA(33)",
         "9 — DEMA(75)",
         "10 — DEMA(33) × corps HA",
         "11 — HMA(75)",
         "12 — HMA(33)",
         "13 — EMA(55)",
         "14 — EMA(89)",
         "15 — EMA(144)"
     ], group=grp)

st_factor = input.float(3.0, "[ST] Factor",     step=0.1, group=grp)
st_atr    = input.int(10,   "[ST] ATR Période", minval=1, group=grp)

// ── CALCULS ──────────────────────────────────────────────────
[st_line, st_dir] = ta.supertrend(st_factor, st_atr)
s_st   = st_dir < 0
s_body = close > open
s_vwap = close > ta.vwap

ema75  = ta.ema(close, 75)
ema55  = ta.ema(close, 55)
ema89  = ta.ema(close, 89)
ema144 = ta.ema(close, 144)
ema33  = ta.ema(close, 33)

// DEMA = 2*EMA - EMA(EMA)
dema33 = 2 * ema33 - ta.ema(ema33, 33)
dema75 = 2 * ema75 - ta.ema(ema75, 75)

// HMA = WMA(2*WMA(src,n/2) - WMA(src,n), sqrt(n))
hma(src, len) =>
    half = math.floor(len / 2)
    sq   = math.round(math.sqrt(len))
    ta.wma(2 * ta.wma(src, half) - ta.wma(src, len), sq)

hma75 = hma(close, 75)
hma33 = hma(close, 33)

s_e75   = close > ema75
s_e55   = close > ema55
s_e89   = close > ema89
s_e144  = close > ema144
s_d33   = close > dema33
s_d75   = close > dema75
s_h75   = close > hma75
s_h33   = close > hma33

score75 = (s_st ? 1 : 0) + (s_e75 ? 1 : 0) + (s_body ? 1 : 0)
scoreVW = (s_st ? 1 : 0) + (s_e75 ? 1 : 0) + (s_vwap ? 1 : 0)

// ── SÉLECTION ────────────────────────────────────────────────
col_bull =
     mode == "1 — EMA(75)"                         ? s_e75 :
     mode == "2 — EMA(75) × corps HA"              ? (s_e75 and s_body) :
     mode == "3 — ST × EMA(75)"                    ? (s_st and s_e75) :
     mode == "4 — ST × EMA(75) × corps HA"         ? (s_st and s_e75 and s_body) :
     mode == "5 — VWAP × EMA(75)"                  ? (s_vwap and s_e75) :
     mode == "6 — score≥2 [ST, EMA(75), corps HA]" ? (score75 >= 2) :
     mode == "7 — score≥2 [ST, EMA(75), VWAP]"     ? (scoreVW >= 2) :
     mode == "8 — DEMA(33)"                         ? s_d33 :
     mode == "9 — DEMA(75)"                         ? s_d75 :
     mode == "10 — DEMA(33) × corps HA"             ? (s_d33 and s_body) :
     mode == "11 — HMA(75)"                         ? s_h75 :
     mode == "12 — HMA(33)"                         ? s_h33 :
     mode == "13 — EMA(55)"                         ? s_e55 :
     mode == "14 — EMA(89)"                         ? s_e89 :
     mode == "15 — EMA(144)"                        ? s_e144 :
     false

// ── BGCOLOR ──────────────────────────────────────────────────
bgcolor(col_bull ? color.new(#2196F3, 78) : color.new(#F44336, 78))

// ── PLOTS ─────────────────────────────────────────────────────
plot(st_line, "SuperTrend",
     color=s_st ? color.lime : color.red, linewidth=2)
plot(ema75,  "EMA(75)",  color=color.new(color.orange, 0),  linewidth=1)
plot(dema33, "DEMA(33)", color=color.new(color.aqua, 40),   linewidth=1)
plot(hma75,  "HMA(75)",  color=color.new(color.yellow, 40), linewidth=1)

// ── TRANSITIONS ──────────────────────────────────────────────
bull_flip = bar_index > 0 and col_bull     and not col_bull[1]
bear_flip = bar_index > 0 and not col_bull and     col_bull[1]
plotshape(bull_flip, style=shape.triangleup,   location=location.belowbar, color=color.lime, size=size.small)
plotshape(bear_flip, style=shape.triangledown, location=location.abovebar, color=color.red,  size=size.small)

// ── TABLE ─────────────────────────────────────────────────────
var table t = table.new(position.top_right, 2, 9,
     bgcolor=color.new(color.black, 60), border_width=1)

if barstate.islast
    table.cell(t, 0, 0, "Signal",     text_color=color.white, text_size=size.small, bgcolor=color.new(color.navy, 20))
    table.cell(t, 1, 0, "État",       text_color=color.white, text_size=size.small, bgcolor=color.new(color.navy, 20))
    table.cell(t, 0, 1, "ST",         text_color=color.white, text_size=size.small)
    table.cell(t, 1, 1, s_st    ? "▲" : "▼", text_color=s_st    ? #2196F3 : #F44336, text_size=size.small)
    table.cell(t, 0, 2, "EMA(75)",    text_color=color.white, text_size=size.small)
    table.cell(t, 1, 2, s_e75   ? "▲" : "▼", text_color=s_e75   ? #2196F3 : #F44336, text_size=size.small)
    table.cell(t, 0, 3, "DEMA(33)",   text_color=color.white, text_size=size.small)
    table.cell(t, 1, 3, s_d33   ? "▲" : "▼", text_color=s_d33   ? #2196F3 : #F44336, text_size=size.small)
    table.cell(t, 0, 4, "DEMA(75)",   text_color=color.white, text_size=size.small)
    table.cell(t, 1, 4, s_d75   ? "▲" : "▼", text_color=s_d75   ? #2196F3 : #F44336, text_size=size.small)
    table.cell(t, 0, 5, "HMA(75)",    text_color=color.white, text_size=size.small)
    table.cell(t, 1, 5, s_h75   ? "▲" : "▼", text_color=s_h75   ? #2196F3 : #F44336, text_size=size.small)
    table.cell(t, 0, 6, "corps HA",   text_color=color.white, text_size=size.small)
    table.cell(t, 1, 6, s_body  ? "▲" : "▼", text_color=s_body  ? #2196F3 : #F44336, text_size=size.small)
    table.cell(t, 0, 7, "VWAP",       text_color=color.white, text_size=size.small)
    table.cell(t, 1, 7, s_vwap  ? "▲" : "▼", text_color=s_vwap  ? #2196F3 : #F44336, text_size=size.small)
    table.cell(t, 0, 8, "Mode",       text_color=color.white, text_size=size.small)
    table.cell(t, 1, 8, str.substring(mode, 0, 2), text_color=color.yellow, text_size=size.normal)
